  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0f0f13; color: #f0ede8; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
    .nav { display: flex; justify-content: space-between; align-items: center; padding: 20px 40px; border-bottom: 1px solid #22223a; }
    .nav-btn { background: #e8c87a; color: #1a1500; border: none; border-radius: 8px; padding: 10px 20px; font-size: 14px; font-weight: 600; cursor: pointer; text-decoration: none; }
    .nav-link { color: #9a90b4; font-size: 14px; text-decoration: none; }
    .nav-link:hover { color: #e0d8cc; }
    .hero { text-align: center; padding: 80px 20px 60px; }
    .hero-label { font-size: 12px; letter-spacing: 4px; color: #6a6070; text-transform: uppercase; margin-bottom: 16px; }
    .hero-title { font-size: 48px; font-weight: 400; line-height: 1.2; margin-bottom: 20px; }
    .hero-title span { color: #e8c87a; }
    .hero-sub { font-size: 18px; color: #6a6070; max-width: 540px; margin: 0 auto 40px; line-height: 1.6; }
    .hero-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
    .btn-primary { background: #e8c87a; color: #1a1500; border: none; border-radius: 10px; padding: 16px 32px; font-size: 16px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-secondary { background: transparent; color: #e0d8cc; border: 1px solid #2a2a3a; border-radius: 10px; padding: 16px 32px; font-size: 16px; cursor: pointer; text-decoration: none; display: inline-block; }
    .hero-note { margin-top: 20px; font-size: 13px; color: #4a4055; }
    .video-section { padding: 0 20px 80px; max-width: 800px; margin: 0 auto; }
    .video-wrap { position: relative; padding-bottom: 56.25%; border-radius: 16px; overflow: hidden; background: #16161e; border: 1px solid #22223a; }
    .video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
    .social-proof { background: #0c0c10; padding: 32px 20px; text-align: center; border-top: 1px solid #22223a; border-bottom: 1px solid #22223a; }
    .social-proof-inner { max-width: 700px; margin: 0 auto; display: flex; gap: 40px; justify-content: center; flex-wrap: wrap; }
    .stat { text-align: center; }
    .stat-num { font-size: 28px; font-weight: 600; color: #e8c87a; }
    .stat-label { font-size: 12px; color: #6a6070; margin-top: 4px; }
    .features { padding: 80px 20px; max-width: 960px; margin: 0 auto; }
    .features-title { text-align: center; font-size: 32px; font-weight: 400; margin-bottom: 12px; }
    .features-sub { text-align: center; color: #6a6070; margin-bottom: 48px; font-size: 16px; }
    .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; }
    .feature { background: #16161e; border: 1px solid #22223a; border-radius: 14px; padding: 24px; }
    .feature-icon { font-size: 32px; margin-bottom: 12px; }
    .feature-title { font-size: 16px; font-weight: 600; margin-bottom: 8px; color: #e0d8cc; }
    .feature-desc { font-size: 14px; color: #6a6070; line-height: 1.6; }
    .como { padding: 80px 20px; background: #0c0c10; }
    .como-inner { max-width: 700px; margin: 0 auto; }
    .como-title { text-align: center; font-size: 32px; font-weight: 400; margin-bottom: 48px; }
    .paso { display: flex; gap: 20px; margin-bottom: 32px; align-items: flex-start; }
    .paso-num { width: 36px; height: 36px; border-radius: 50%; background: #e8c87a; color: #1a1500; font-weight: 700; font-size: 16px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .paso-titulo { font-size: 16px; font-weight: 600; color: #e0d8cc; margin-bottom: 6px; }
    .paso-desc { font-size: 14px; color: #6a6070; line-height: 1.6; }
    .planes { padding: 80px 20px; }
    .planes-inner { max-width: 960px; margin: 0 auto; }
    .planes-title { text-align: center; font-size: 32px; font-weight: 400; margin-bottom: 12px; }
    .planes-sub { text-align: center; color: #6a6070; margin-bottom: 48px; font-size: 16px; }
    .planes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
    .plan { background: #16161e; border: 1px solid #22223a; border-radius: 14px; padding: 28px; }
    .plan.destacado { border-color: #e8c87a; }
    .plan-badge { font-size: 11px; letter-spacing: 2px; color: #e8c87a; text-transform: uppercase; margin-bottom: 12px; }
    .plan-nombre { font-size: 22px; font-weight: 500; margin-bottom: 4px; }
    .plan-precio { font-size: 40px; color: #e8c87a; font-weight: 400; margin-bottom: 4px; }
    .plan-precio span { font-size: 16px; color: #6a6070; }
    .plan-desc { font-size: 13px; color: #6a6070; margin-bottom: 20px; }
    .plan-items { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; }
    .plan-items li { font-size: 14px; color: #9a90b4; }
    .plan-items li::before { content: "✓ "; color: #7ec47e; }
    .plan-btn { width: 100%; background: #e8c87a; color: #1a1500; border: none; border-radius: 10px; padding: 14px; font-size: 15px; font-weight: 600; cursor: pointer; text-decoration: none; display: block; text-align: center; }
    .plan:not(.destacado) .plan-btn { background: #1e1e28; color: #e0d8cc; border: 1px solid #2a2a3a; }
    .extra { text-align: center; margin-top: 20px; font-size: 13px; color: #6a6070; }
    .extra span { color: #e8c87a; }
    .cta-final { background: #16161e; border: 1px solid #22223a; border-radius: 16px; padding: 48px 40px; text-align: center; max-width: 600px; margin: 60px auto; }
    .cta-final h2 { font-size: 28px; font-weight: 400; margin-bottom: 12px; }
    .cta-final p { color: #6a6070; font-size: 15px; margin-bottom: 28px; line-height: 1.6; }
    .footer { text-align: center; padding: 40px 20px; border-top: 1px solid #22223a; color: #4a4055; font-size: 13px; }
    @media (max-width: 768px) {
      .nav { padding: 14px 20px; }
      .hero { padding: 50px 20px 40px; }
      .hero-title { font-size: 30px; line-height: 1.25; }
      .hero-sub { font-size: 15px; }
      .btn-primary, .btn-secondary { padding: 14px 24px; font-size: 15px; width: 100%; text-align: center; }
      .hero-btns { flex-direction: column; align-items: center; gap: 10px; }
      .social-proof-inner { gap: 24px; }
      .features { padding: 50px 16px; }
      .features-title { font-size: 24px; }
      .features-grid { grid-template-columns: 1fr; }
      .como { padding: 50px 16px; }
      .planes { padding: 50px 16px; }
      .planes-title { font-size: 24px; }
      .planes-grid { grid-template-columns: 1fr; }
      .plan { padding: 22px; }
      .plan-precio { font-size: 34px; }
      .cta-final { padding: 32px 20px; margin: 40px 16px; }
    }
  </style>
</head>
