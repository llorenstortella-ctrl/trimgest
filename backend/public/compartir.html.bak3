<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TrimGest — Facturas compartidas</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, sans-serif; background: #0f0f13; color: #e0d8cc; min-height: 100vh; }
  .header { background: #13131a; border-bottom: 1px solid #22223a; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; }
  .logo { font-size: 20px; font-weight: 700; color: #e8c87a; }
  .empresa-nombre { font-size: 13px; color: #6a6070; }
  .content { max-width: 1100px; margin: 0 auto; padding: 20px; }
  .titulo { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
  .subtitulo { font-size: 13px; color: #6a6070; margin-bottom: 20px; }
  .stats { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
  .stat { background: #16161e; border: 1px solid #22223a; border-radius: 10px; padding: 12px 16px; flex: 1; min-width: 120px; }
  .stat-label { font-size: 11px; color: #6a6070; text-transform: uppercase; letter-spacing: 1px; }
  .stat-value { font-size: 18px; font-weight: 700; color: #e8c87a; margin-top: 2px; }
  .tabs { display: flex; gap: 8px; margin-bottom: 16px; border-bottom: 1px solid #22223a; padding-bottom: 0; }
  .tab { background: none; border: none; color: #6a6070; font-size: 14px; font-weight: 500; padding: 10px 16px; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
  .tab.active { color: #e8c87a; border-bottom: 2px solid #e8c87a; }
  .tab-content { display: none; }
  .tab-content.active { display: block; }
  .acciones-bar { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }
  .btn { border-radius: 8px; padding: 8px 14px; font-size: 13px; cursor: pointer; border: 1px solid #2a2a3a; background: #1e1e28; color: #9a90b4; }
  .btn-excel { background: #1a2a1a; border-color: #2a4a2a; color: #4caf7d; }
  .btn-pdf { background: #1e1e28; border-color: #2a2a3a; color: #9a90b4; }
  .tabla-wrap { overflow-x: auto; }
  .tabla { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 700px; }
  .tabla th { text-align: left; padding: 10px 12px; color: #888; border-bottom: 1px solid #2a2a35; font-weight: 500; }
  .tabla td { padding: 10px 12px; border-bottom: 1px solid #1a1a20; vertical-align: middle; }
  .tabla tr:hover td { background: #16161e; }
  .badge-pago { border-radius: 6px; padding: 2px 8px; font-size: 11px; font-weight: 500; white-space: nowrap; }
  .badge-cont { background: #0d2b1a; border: 1px solid #1a4a2a; color: #4caf7d; border-radius: 6px; padding: 2px 8px; font-size: 11px; }
  .btn-cont { border-radius: 6px; padding: 4px 8px; font-size: 11px; cursor: pointer; border: 1px solid #2a2a3a; background: #1e1e28; color: #6a6070; white-space: nowrap; }
  .btn-cont.contabilizado { background: #0d2b1a; border-color: #1a4a2a; color: #4caf7d; }
  .btn-ver-pdf { background: #1e1e28; border: 1px solid #2a2a3a; color: #9a90b4; border-radius: 6px; padding: 3px 10px; font-size: 11px; cursor: pointer; text-decoration: none; white-space: nowrap; }
  .empty { color: #6a6070; font-size: 13px; padding: 20px 12px; }
  .password-box { background: #16161e; border: 1px solid #22223a; border-radius: 12px; padding: 30px; text-align: center; max-width: 400px; margin: 60px auto; }
  .password-box h2 { margin-bottom: 16px; }
  .password-input { width: 100%; background: #1e1e28; border: 1px solid #2a2a3a; color: #e0d8cc; padding: 12px; border-radius: 8px; font-size: 14px; margin-bottom: 12px; }
  .btn-entrar { width: 100%; background: #e8c87a; color: #1a1500; border: none; border-radius: 10px; padding: 12px; font-size: 15px; font-weight: 600; cursor: pointer; }
  .banner { background: #13131a; border: 1px solid #22223a; border-radius: 12px; padding: 20px; text-align: center; margin-top: 40px; }
  .banner p { font-size: 13px; color: #6a6070; margin-bottom: 8px; }
  .banner a { color: #e8c87a; text-decoration: none; font-weight: 600; }
  @media (max-width: 600px) {
    .tabla { min-width: 500px; font-size: 12px; }
    .stats { gap: 8px; }
    .stat { min-width: 100px; padding: 10px 12px; }
  }
</style>
</head>
<body>
<div id="root"></div>
<script>
var token = location.pathname.split('/compartir/')[1];
var passwordUsada = '';
var datosGlobales = null;
var contabilizadosLocal = [];
var tabActual = 'proveedores';
var selProv = {};
var selCli = {};
var selNom = {};

async function cargar(pass) {
  var url = '/api/compartir/' + token + (pass ? '?password=' + encodeURIComponent(pass) : '');
  var r = await fetch(url);
  var d = await r.json();
  if (r.status === 401) { mostrarPassword(); return; }
  if (r.status === 404) { document.getElementById('root').innerHTML = '<div style="text-align:center;padding:60px;"><h2>Enlace no encontrado</h2></div>'; return; }
  datosGlobales = d;
  passwordUsada = pass || '';
  contabilizadosLocal = d.contabilizados || [];
  renderApp(d);
}

function mostrarPassword() {
  var root = document.getElementById('root');
  root.innerHTML = '<div class="password-box"><h2>Enlace protegido</h2><p style="color:#6a6070;font-size:13px;margin-bottom:16px;">Introduce la contrasena para ver las facturas</p><input class="password-input" id="passInput" type="password" placeholder="Contrasena"><button class="btn-entrar" id="btn-entrar-pass">Entrar</button><p id="passError" style="color:#e87a7a;font-size:12px;margin-top:8px;"></p></div>';
  document.getElementById('btn-entrar-pass').onclick = function() { entrarConPassword(); };
}

async function entrarConPassword() {
  var pass = document.getElementById('passInput').value;
  if (!pass) return;
  var url = '/api/compartir/' + token + '?password=' + encodeURIComponent(pass);
  var r = await fetch(url);
  if (r.status === 401) { document.getElementById('passError').textContent = 'Contrasena incorrecta'; return; }
  var d = await r.json();
  datosGlobales = d; passwordUsada = pass;
  contabilizadosLocal = d.contabilizados || [];
  renderApp(d);
}

function formatEur(n) {
  return Number(n).toLocaleString('es-ES', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' EUR';
}

var badgeColorsPago = { transferencia: { bg: '#0d1a2b', color: '#4c8faf' }, tarjeta: { bg: '#1a0d2b', color: '#9b7fd4' }, domiciliacion: { bg: '#2b1a0d', color: '#d4944c' }, bizum: { bg: '#0d2b1a', color: '#4caf7d' }, efectivo: { bg: '#2a2a35', color: '#888' }, mixto: { bg: '#2b1a2b', color: '#c47fd4' }, sinpagar: { bg: '#2b0d0d', color: '#e05555' }, parcial: { bg: '#2b2010', color: '#d4944c' } };

function badgePago(estado) {
  if (!estado || !badgeColorsPago[estado]) return '<span style="color:#555;font-size:11px;">-</span>';
  var bc = badgeColorsPago[estado];
  var label = estado.charAt(0).toUpperCase() + estado.slice(1);
  return '<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;background:' + bc.bg + ';color:' + bc.color + ';">' + label + '</span>';
}

function switchTab(tab) {
  tabActual = tab;
  document.querySelectorAll('.tab').forEach(function(b) { b.classList.remove('active'); });
  document.querySelectorAll('.tab-content').forEach(function(c) { c.classList.remove('active'); });
  var btnTab = document.getElementById('tab-' + tab);
  var contenido = document.getElementById('content-' + tab);
  if (btnTab) btnTab.classList.add('active');
  if (contenido) contenido.classList.add('active');
}

function toggleSel(tipo, id) {
  if (tipo === 'prov') { selProv[id] = !selProv[id]; }
  else if (tipo === 'cli') { selCli[id] = !selCli[id]; }
  else { selNom[id] = !selNom[id]; }
  var cb = document.getElementById('cb-' + tipo + '-' + id);
  if (cb) cb.checked = tipo === 'prov' ? !!selProv[id] : (tipo === 'cli' ? !!selCli[id] : !!selNom[id]);
}

function toggleTodos(tipo, checked) {
  var d = datosGlobales;
  if (!d) return;
  if (tipo === 'prov') {
    d.facturas.filter(function(f) { return f.tipo === 'proveedor'; }).forEach(function(f) { selProv[f.id] = checked; });
  } else if (tipo === 'cli') {
    d.facturas.filter(function(f) { return f.tipo === 'cliente'; }).forEach(function(f) { selCli[f.id] = checked; });
  } else {
    d.nominas.forEach(function(n) { selNom[n.id] = checked; });
  }
  renderTablas(d);
}

function renderApp(d) {
  var totalProv = 0; var totalCli = 0; var totalNom = 0;
  d.facturas.forEach(function(f) {
    if (f.tipo === 'proveedor') totalProv += Number(f.total);
    else totalCli += Number(f.total);
  });
  if (d.nominas) d.nominas.forEach(function(n) { totalNom += Number(n.coste_empresa); });
  var tituloLabel = d.trimestre === 'TODOS' ? 'Anno ' + d.anno : d.trimestre + ' ' + d.anno;

  var html = '';
  html += '<div class="header"><div class="logo">TrimGest</div><div class="empresa-nombre">' + d.empresa + '</div></div>';
  html += '<div class="content">';
  html += '<div class="titulo">' + tituloLabel + '</div>';
  html += '<div class="subtitulo">Facturas compartidas por ' + d.empresa + '</div>';
  html += '<div class="stats">';
  html += '<div class="stat"><div class="stat-label">Proveedores</div><div class="stat-value">' + formatEur(totalProv) + '</div></div>';
  html += '<div class="stat"><div class="stat-label">Clientes</div><div class="stat-value" style="color:#7ac87a;">' + formatEur(totalCli) + '</div></div>';
  if (totalNom > 0) html += '<div class="stat"><div class="stat-label">Nominas (coste)</div><div class="stat-value" style="color:#c87a7a;">' + formatEur(totalNom) + '</div></div>';
  html += '</div>';

  html += '<div class="tabs">';
  html += '<button class="tab active" id="tab-proveedores">Proveedores</button>';
  html += '<button class="tab" id="tab-clientes">Clientes</button>';
  html += '<button class="tab" id="tab-nominas">Nominas</button>';
  html += '</div>';

  html += '<div class="tab-content active" id="content-proveedores">';
  html += '<div class="acciones-bar" id="acciones-prov">';
  html += '<button class="btn btn-excel" id="btn-excel-prov-todas">Excel todas</button>';
  html += '<button class="btn btn-excel" id="btn-excel-prov-sel">Excel seleccionadas</button>';
  html += '<button class="btn btn-pdf" id="btn-pdf-prov-todas">PDF todas</button>';
  html += '<button class="btn btn-pdf" id="btn-pdf-prov-sel">PDF seleccionadas</button>';
  html += '</div>';
  html += '<div class="tabla-wrap"><table class="tabla"><thead><tr>';
  html += '<th><input type="checkbox" id="check-all-prov"></th>';
  html += '<th>Numero</th><th>Fecha</th><th>Proveedor</th><th>Concepto</th><th>Base</th><th>IVA</th><th>Total</th><th>Pago</th><th>Acciones</th>';
  html += '</tr></thead><tbody id="tbody-prov"></tbody></table></div>';
  html += '</div>';

  html += '<div class="tab-content" id="content-clientes">';
  html += '<div class="acciones-bar">';
  html += '<button class="btn btn-excel" id="btn-excel-cli-todas">Excel todas</button>';
  html += '<button class="btn btn-excel" id="btn-excel-cli-sel">Excel seleccionadas</button>';
  html += '<button class="btn btn-pdf" id="btn-pdf-cli-todas">PDF todas</button>';
  html += '<button class="btn btn-pdf" id="btn-pdf-cli-sel">PDF seleccionadas</button>';
  html += '</div>';
  html += '<div class="tabla-wrap"><table class="tabla"><thead><tr>';
  html += '<th><input type="checkbox" id="check-all-cli"></th>';
  html += '<th>Numero</th><th>Fecha</th><th>Cliente</th><th>Concepto</th><th>Base</th><th>IVA</th><th>Total</th><th>Acciones</th>';
  html += '</tr></thead><tbody id="tbody-cli"></tbody></table></div>';
  html += '</div>';

  html += '<div class="tab-content" id="content-nominas">';
  html += '<div class="acciones-bar">';
  html += '<button class="btn btn-excel" id="btn-excel-nom-todas">Excel todas</button>';
  html += '<button class="btn btn-excel" id="btn-excel-nom-sel">Excel seleccionadas</button>';
  html += '<button class="btn btn-pdf" id="btn-pdf-nom-todas">PDF todas</button>';
  html += '<button class="btn btn-pdf" id="btn-pdf-nom-sel">PDF seleccionadas</button>';
  html += '</div>';
  html += '<div class="tabla-wrap"><table class="tabla"><thead><tr>';
  html += '<th><input type="checkbox" id="check-all-nom"></th>';
  html += '<th>Trabajador</th><th>Mes</th><th>Anno</th><th>Bruto</th><th>Neto</th><th>IRPF</th><th>SS Trab</th><th>Coste empresa</th>';
  html += '</tr></thead><tbody id="tbody-nom"></tbody></table></div>';
  html += '</div>';

  html += '<div class="banner"><p>Quieres que todos tus clientes te envien las facturas asi de organizadas?</p><a href="https://trimgest.es/panel-gestoria#registro" target="_blank">Descubre TrimGest para gestorias - gratis</a></div>';
  html += '</div>';

  document.getElementById('root').innerHTML = html;

  document.getElementById('tab-proveedores').onclick = function() { switchTab('proveedores'); };
  document.getElementById('tab-clientes').onclick = function() { switchTab('clientes'); };
  document.getElementById('tab-nominas').onclick = function() { switchTab('nominas'); };

  var checkAllProv = document.getElementById('check-all-prov');
  if (checkAllProv) checkAllProv.onclick = function() { toggleTodos('prov', this.checked); };
  var checkAllCli = document.getElementById('check-all-cli');
  if (checkAllCli) checkAllCli.onclick = function() { toggleTodos('cli', this.checked); };
  var checkAllNom = document.getElementById('check-all-nom');
  if (checkAllNom) checkAllNom.onclick = function() { toggleTodos('nom', this.checked); };

  document.getElementById('btn-excel-prov-todas').onclick = function() { exportarExcel('prov', false); };
  document.getElementById('btn-excel-prov-sel').onclick = function() { exportarExcel('prov', true); };
  document.getElementById('btn-excel-cli-todas').onclick = function() { exportarExcel('cli', false); };
  document.getElementById('btn-excel-cli-sel').onclick = function() { exportarExcel('cli', true); };
  document.getElementById('btn-excel-nom-todas').onclick = function() { exportarExcel('nom', false); };
  document.getElementById('btn-excel-nom-sel').onclick = function() { exportarExcel('nom', true); };

  document.getElementById('btn-pdf-prov-todas').onclick = function() { abrirPdf('proveedor', false); };
  document.getElementById('btn-pdf-prov-sel').onclick = function() { abrirPdf('proveedor', true); };
  document.getElementById('btn-pdf-cli-todas').onclick = function() { abrirPdf('cliente', false); };
  document.getElementById('btn-pdf-cli-sel').onclick = function() { abrirPdf('cliente', true); };
  document.getElementById('btn-pdf-nom-todas').onclick = function() { abrirPdfNominas(false); };
  document.getElementById('btn-pdf-nom-sel').onclick = function() { abrirPdfNominas(true); };

  renderTablas(d);
}

function renderTablas(d) {
  var proveedores = d.facturas.filter(function(f) { return f.tipo === 'proveedor'; });
  var clientes = d.facturas.filter(function(f) { return f.tipo === 'cliente'; });

  var tbodyProv = document.getElementById('tbody-prov');
  if (tbodyProv) {
    if (!proveedores.length) {
      tbodyProv.innerHTML = '<tr><td colspan="10" class="empty">Sin facturas de proveedores</td></tr>';
    } else {
      var filas = '';
      proveedores.forEach(function(f) {
        var esCont = contabilizadosLocal.indexOf(String(f.id)) !== -1 || f.contabilizado;
        var checked = selProv[f.id] ? 'checked' : '';
        filas += '<tr>';
        filas += '<td><input type="checkbox" ' + checked + ' id="cb-prov-' + f.id + '"></td>';
        filas += '<td>' + (f.numero_factura || '-') + '</td>';
        filas += '<td>' + (f.fecha || '-') + '</td>';
        filas += '<td style="font-weight:500;">' + (f.nombre || '-') + '</td>';
        filas += '<td style="color:#6a6070;max-width:120px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">' + (f.concepto || '-') + '</td>';
        filas += '<td>' + formatEur(f.base_imponible) + '</td>';
        filas += '<td>' + (f.iva_porcentaje || 0) + '% / ' + formatEur(f.iva_importe) + '</td>';
        filas += '<td style="font-weight:600;color:#e8c87a;">' + formatEur(f.total) + '</td>';
        filas += '<td>' + badgePago(f.estado_pago) + '</td>';
        filas += '<td style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">';
        if (f.archivo) filas += '<a class="btn-ver-pdf" href="/api/compartir/' + token + '/archivo/' + f.archivo + '?password=' + encodeURIComponent(passwordUsada) + '" target="_blank">PDF</a>';
        filas += '<button class="btn-cont ' + (esCont ? 'contabilizado' : '') + '" id="bcont-' + f.id + '">' + (esCont ? 'Contabilizado' : 'Contabilizar') + '</button>';
        filas += '</td></tr>';
      });
      tbodyProv.innerHTML = filas;
      proveedores.forEach(function(f) {
        var cb = document.getElementById('cb-prov-' + f.id);
        if (cb) cb.onclick = (function(fid) { return function() { selProv[fid] = this.checked; }; })(f.id);
        var bc = document.getElementById('bcont-' + f.id);
        if (bc) bc.onclick = (function(fid) { return function() { toggleContabilizado(fid); }; })(f.id);
      });
    }
  }

  var tbodyCli = document.getElementById('tbody-cli');
  if (tbodyCli) {
    if (!clientes.length) {
      tbodyCli.innerHTML = '<tr><td colspan="9" class="empty">Sin facturas de clientes</td></tr>';
    } else {
      var filascli = '';
      clientes.forEach(function(f) {
        var checked = selCli[f.id] ? 'checked' : '';
        filascli += '<tr>';
        filascli += '<td><input type="checkbox" ' + checked + ' id="cb-cli-' + f.id + '"></td>';
        filascli += '<td>' + (f.numero_factura || '-') + '</td>';
        filascli += '<td>' + (f.fecha || '-') + '</td>';
        filascli += '<td style="font-weight:500;">' + (f.nombre || '-') + '</td>';
        filascli += '<td style="color:#6a6070;">' + (f.concepto || '-') + '</td>';
        filascli += '<td>' + formatEur(f.base_imponible) + '</td>';
        filascli += '<td>' + (f.iva_porcentaje || 0) + '% / ' + formatEur(f.iva_importe) + '</td>';
        filascli += '<td style="font-weight:600;color:#7ac87a;">' + formatEur(f.total) + '</td>';
        filascli += '<td>';
        if (f.archivo) filascli += '<a class="btn-ver-pdf" href="/api/compartir/' + token + '/archivo/' + f.archivo + '?password=' + encodeURIComponent(passwordUsada) + '" target="_blank">PDF</a>';
        filascli += '</td></tr>';
      });
      tbodyCli.innerHTML = filascli;
      clientes.forEach(function(f) {
        var cb = document.getElementById('cb-cli-' + f.id);
        if (cb) cb.onclick = (function(fid) { return function() { selCli[fid] = this.checked; }; })(f.id);
      });
    }
  }

  var tbodyNom = document.getElementById('tbody-nom');
  if (tbodyNom) {
    var nominas = d.nominas || [];
    if (!nominas.length) {
      tbodyNom.innerHTML = '<tr><td colspan="9" class="empty">Sin nominas</td></tr>';
    } else {
      var filasnom = '';
      nominas.forEach(function(n) {
        var checked = selNom[n.id] ? 'checked' : '';
        filasnom += '<tr>';
        filasnom += '<td><input type="checkbox" ' + checked + ' id="cb-nom-' + n.id + '"></td>';
        filasnom += '<td style="font-weight:500;">' + (n.trabajador || '-') + '</td>';
        filasnom += '<td>' + (n.mes || '-') + '</td>';
        filasnom += '<td>' + (n.anno || '-') + '</td>';
        filasnom += '<td>' + formatEur(n.devengado) + '</td>';
        filasnom += '<td style="color:#7ac87a;font-weight:600;">' + formatEur(n.neto) + '</td>';
        filasnom += '<td>' + (n.irpf_porcentaje || 0) + '% / ' + formatEur(n.irpf_importe) + '</td>';
        filasnom += '<td>' + formatEur(n.ss_trabajador) + '</td>';
        filasnom += '<td style="color:#e8c87a;">' + formatEur(n.coste_empresa) + '</td>';
        filasnom += '</tr>';
      });
      tbodyNom.innerHTML = filasnom;
      nominas.forEach(function(n) {
        var cb = document.getElementById('cb-nom-' + n.id);
        if (cb) cb.onclick = (function(nid) { return function() { selNom[nid] = this.checked; }; })(n.id);
      });
    }
  }
}

async function toggleContabilizado(facturaId) {
  var r = await fetch('/api/compartir/' + token + '/contabilizar/' + facturaId, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password: passwordUsada })
  });
  var d = await r.json();
  if (d.ok) { contabilizadosLocal = d.contabilizados; renderTablas(datosGlobales); }
}

function exportarExcel(tipo, soloSel) {
  var d = datosGlobales;
  if (!d) return;
  var rows = [];
  if (tipo === 'prov') {
    rows.push(['Numero', 'Fecha', 'Proveedor', 'Concepto', 'Base', 'IVA%', 'IVA EUR', 'Total', 'Pago', 'Contabilizado']);
    var lista = d.facturas.filter(function(f) { return f.tipo === 'proveedor'; });
    if (soloSel) lista = lista.filter(function(f) { return selProv[f.id]; });
    lista.forEach(function(f) {
      var cont = contabilizadosLocal.indexOf(String(f.id)) !== -1 || f.contabilizado;
      rows.push([f.numero_factura, f.fecha, f.nombre, f.concepto || '', f.base_imponible, f.iva_porcentaje, f.iva_importe, f.total, f.estado_pago || '', cont ? 'Si' : 'No']);
    });
  } else if (tipo === 'cli') {
    rows.push(['Numero', 'Fecha', 'Cliente', 'Concepto', 'Base', 'IVA%', 'IVA EUR', 'Total']);
    var listacli = d.facturas.filter(function(f) { return f.tipo === 'cliente'; });
    if (soloSel) listacli = listacli.filter(function(f) { return selCli[f.id]; });
    listacli.forEach(function(f) {
      rows.push([f.numero_factura, f.fecha, f.nombre, f.concepto || '', f.base_imponible, f.iva_porcentaje, f.iva_importe, f.total]);
    });
  } else {
    rows.push(['Trabajador', 'Mes', 'Anno', 'Bruto', 'Neto', 'IRPF%', 'IRPF EUR', 'SS Trabajador', 'SS Empresa', 'Coste Empresa']);
    var listaNom = d.nominas || [];
    if (soloSel) listaNom = listaNom.filter(function(n) { return selNom[n.id]; });
    listaNom.forEach(function(n) {
      rows.push([n.trabajador, n.mes, n.anno, n.devengado, n.neto, n.irpf_porcentaje, n.irpf_importe, n.ss_trabajador, n.ss_empresa, n.coste_empresa]);
    });
  }
  var sep = String.fromCharCode(10);
  var csv = rows.map(function(r) { return r.map(function(c) { return '"' + String(c || '').replace(/"/g, '""') + '"'; }).join(','); }).join(sep);
  var blob = new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8;' });
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url; a.download = 'trimgest_' + tipo + '_' + (d.trimestre || '') + '_' + d.anno + '.csv';
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

function abrirPdf(tipo, soloSel) {
  var d = datosGlobales;
  if (!d) return;
  var ids = [];
  if (soloSel) {
    var sel = tipo === 'proveedor' ? selProv : selCli;
    var lista = d.facturas.filter(function(f) { return f.tipo === tipo; });
    lista.forEach(function(f) { if (sel[f.id]) ids.push(f.id); });
    if (!ids.length) { alert('Selecciona al menos una factura'); return; }
  }
  var passParam = passwordUsada ? '&password=' + encodeURIComponent(passwordUsada) : '';
  var tr = d.trimestre || 'TODOS';
  var an = d.anno;
  if (soloSel) {
    var url = '/api/compartir/' + token + '/pdf/seleccionadas?tipo=' + tipo + '&ids=' + ids.join(',') + passParam;
  } else {
    var url = '/api/compartir/' + token + '/pdf/' + tipo + '/' + tr + '/' + an + '?' + passParam.replace(/^&/,'');
  }
  window.open(url, '_blank');
}

function abrirPdfNominas(soloSel) {
  var d = datosGlobales;
  if (!d) return;
  var passParam = passwordUsada ? '&password=' + encodeURIComponent(passwordUsada) : '';
  if (soloSel) {
    var ids = [];
    (d.nominas || []).forEach(function(n) { if (selNom[n.id]) ids.push(n.id); });
    if (!ids.length) { alert('Selecciona al menos una nomina'); return; }
    window.open('/api/compartir/' + token + '/pdf/nominas-seleccionadas?ids=' + ids.join(',') + passParam, '_blank');
  } else {
    window.open('/api/compartir/' + token + '/pdf/nominas/' + d.anno + '?' + passParam.replace(/^&/,''), '_blank');
  }
}

cargar('');
</script>
</body>
</html>