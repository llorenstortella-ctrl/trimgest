      div.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:#0f0f13;z-index:100;display:flex;flex-direction:column;align-items:center;padding:24px 20px 40px;overflow-y:auto;';
      div.innerHTML =
        '<div style="width:100%;max-width:360px;">'+
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;">'+
        '<div style="font-size:20px;color:#f0ede8;font-weight:600;">Ajustes</div>'+
