  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TrimGest</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { background: #0f0f13; color: #f0ede8; font-family: -apple-system, BlinkMacSystemFont, sans-serif; max-width: 480px; margin: 0 auto; min-height: 100vh; }
    .auth-screen { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 40px 20px; }
    .auth-logo { display: flex; justify-content: center; align-items: center; margin-bottom: 16px; width: 300px; margin-left: auto; margin-right: auto; }
    .auth-title { font-size: 28px; font-weight: 400; color: #e8c87a; margin-bottom: 40px; }
    .auth-form { width: 100%; max-width: 300px; display: flex; flex-direction: column; gap: 12px; }
    .auth-input { background: #16161e; border: 1px solid #2a2a3a; color: #e0d8cc; padding: 14px; border-radius: 10px; font-size: 16px; width: 100%; }
    .auth-input::placeholder { color: #4a4055; }
    .auth-btn { background: #e8c87a; color: #1a1500; border: none; border-radius: 10px; padding: 14px; font-size: 16px; font-weight: 600; cursor: pointer; width: 100%; margin-top: 4px; -webkit-tap-highlight-color: transparent; }
    .auth-switch { font-size: 13px; color: #6a6070; text-align: center; margin-top: 16px; cursor: pointer; }
    .auth-switch span { color: #e8c87a; text-decoration: underline; }
    .auth-error { color: #c06060; font-size: 13px; text-align: center; }
    .auth-success { color: #7ec47e; font-size: 13px; text-align: center; }
    .main-app { display: none; }
    .header { background: #16161e; padding: 24px 20px 20px; border-bottom: 1px solid #22223a; }
    .header-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; }
    .label { font-size: 11px; letter-spacing: 3px; color: #6a6070; text-transform: uppercase; margin-bottom: 4px; }
    h1 { font-size: 24px; font-weight: 500; }
    .selectores { display: flex; gap: 8px; margin-top: 10px; margin-bottom: 16px; }
    .selectores select { background: #1e1e28; border: 1px solid #2a2a3a; color: #e0d8cc; padding: 6px 10px; border-radius: 8px; font-size: 13px; cursor: pointer; }
    .btn-subir { background: #e8c87a; color: #1a1500; border: none; border-radius: 10px; padding: 10px 16px; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn-email-import { background: #1e1e28; color: #e8c87a; border: 1px solid #e8c87a; border-radius: 10px; padding: 10px 16px; font-size: 14px; font-weight: 600; cursor: pointer; white-space: nowrap; }
    .btn-ajustes { background: none; border: none; color: #6a6070; font-size: 22px; cursor: pointer; padding: 8px; }
    .stats { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .stat { background: #1e1e28; border-radius: 10px; padding: 14px; }
    .stat-label { font-size: 10px; letter-spacing: 2px; color: #6a6070; text-transform: uppercase; margin-bottom: 6px; }
    .stat-value { font-size: 20px; color: #c06060; margin-bottom: 4px; }
    .stat-value.verde { color: #7ec47e; }
    .stat-count { font-size: 11px; color: #4a4055; }
    .content { padding: 20px; padding-bottom: 80px; }
    .upload-area { display: none; margin-bottom: 20px; }
    .upload-box { background: #16161e; border: 2px dashed #2a2a3a; border-radius: 14px; padding: 24px 20px; }
    .upload-title { font-size: 16px; color: #e0d8cc; margin-bottom: 6px; text-align: center; }
    .upload-sub { font-size: 12px; color: #5a5565; margin-bottom: 16px; text-align: center; }
    .tipo-selector { display: flex; gap: 10px; margin-bottom: 16px; }
    .tipo-btn { flex: 1; padding: 12px; border-radius: 10px; border: 2px solid #2a2a3a; background: #1e1e28; color: #6a6070; font-size: 14px; font-weight: 600; cursor: pointer; text-align: center; transition: all 0.15s; }
    .tipo-btn.selected-prov { border-color: #c06060; color: #c06060; background: #2a1a1a; }
    .tipo-btn.selected-cli { border-color: #7ec47e; color: #7ec47e; background: #1a2a1a; }
    .upload-btns { display: flex; gap: 10px; }
    .btn-file { background: #e8c87a; color: #1a1500; border: none; border-radius: 10px; padding: 12px; font-size: 14px; font-weight: 600; cursor: pointer; flex: 1; }
    .btn-file:disabled { opacity: 0.4; cursor: not-allowed; }
    .btn-camara { background: #1e1e28; color: #e0d8cc; border: 1px solid #2a2a3a; border-radius: 10px; padding: 12px; font-size: 14px; font-weight: 600; cursor: pointer; flex: 1; }
    .btn-camara:disabled { opacity: 0.4; cursor: not-allowed; }
    .uploading { color: #9a90b4; font-size: 13px; margin-top: 12px; text-align: center; }
    .success { color: #7ec47e; font-size: 13px; margin-top: 12px; text-align: center; }
    .error { color: #c06060; font-size: 13px; margin-top: 12px; text-align: center; }
    .duplicado { color: #c08040; font-size: 13px; margin-top: 12px; background: #2a1e10; border-radius: 8px; padding: 10px; text-align: center; }
    .section-title { font-size: 11px; letter-spacing: 2px; color: #6a6070; text-transform: uppercase; margin-bottom: 14px; }
    .empty { text-align: center; color: #4a4055; padding: 40px 20px; font-size: 14px; }
    .facturas-list { display: flex; flex-direction: column; gap: 10px; }
    .factura-card { background: #16161e; border: 1px solid #22223a; border-radius: 12px; padding: 14px; margin-bottom: 10px; }
    .factura-card.enviada { opacity: 0.5; }
    .factura-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .factura-nombre { font-size: 15px; font-weight: 500; color: #e0d8cc; }
    .factura-badges { display: flex; gap: 6px; align-items: center; }
    .factura-badge { font-size: 10px; letter-spacing: 1px; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; }
    .badge-proveedor { background: #2a1a1a; color: #c06060; }
    .badge-cliente { background: #1a2a1a; color: #7ec47e; }
    .badge-enviada { background: #1a1a2a; color: #6a80c0; }
    .badge-sinpagar { background: #2a1500; color: #e08030; border: 1px solid #6a3a10; }
    .badge-transferencia { background: #0d1a2a; color: #5090d0; border: 1px solid #1a3a5a; }
    .badge-efectivo { background: #1a2a0d; color: #70b040; border: 1px solid #3a5a1a; }
    .badge-mixto { background: #2b1a2b; color: #c47fd4; border: 1px solid #5a3a5a; }
    .badge-sinpagar { background: #2b0d0d; color: #e05555; border: 1px solid #5a1a1a; }
    .badge-parcial { background: #2b2010; color: #d4944c; border: 1px solid #5a4020; }
    .badge-tarjeta { background: #1a0d2a; color: #a070d0; border: 1px solid #4a1a6a; }
    .badge-domiciliacion { background: #0d2a2a; color: #50c0c0; border: 1px solid #1a5a5a; }
    .badge-bizum { background: #2a1a0d; color: #d09050; border: 1px solid #6a4a1a; }
    .factura-datos { display: flex; gap: 12px; font-size: 12px; color: #6a6070; margin-bottom: 6px; flex-wrap: wrap; }
    .factura-total { color: #e8c87a; font-weight: 600; }
    .factura-desglose { font-size: 11px; color: #4a4055; margin-bottom: 8px; }
    .factura-acciones { display: flex; gap: 6px; margin-top: 10px; }
    .btn-accion { font-size: 11px; padding: 5px 10px; border-radius: 6px; border: 1px solid #2a2a3a; background: #1e1e28; color: #9a90b4; cursor: pointer; }
    .btn-borrar { font-size: 11px; padding: 5px 10px; border-radius: 6px; border: 1px solid #3a1a1a; background: #2a1a1a; color: #c06060; cursor: pointer; }
    .edit-form { margin-top: 12px; display: none; flex-direction: column; gap: 8px; }
    .edit-row { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
    .edit-input { background: #1e1e28; border: 1px solid #2a2a3a; color: #e0d8cc; padding: 5px 8px; border-radius: 6px; font-size: 12px; width: 100%; }
    .edit-row select { background: #1e1e28; border: 1px solid #2a2a3a; color: #e0d8cc; padding: 5px 8px; border-radius: 6px; font-size: 12px; }
    .btn-guardar { font-size: 12px; padding: 8px 16px; border-radius: 6px; border: none; background: #e8c87a; color: #1a1500; cursor: pointer; font-weight: 600; width: 100%; margin-top: 4px; }
    .tabs { display: flex; gap: 0; margin-bottom: 16px; border-bottom: 1px solid #22223a; }
    .tab { padding: 8px 16px; font-size: 13px; color: #6a6070; cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; }
    .tab.active { color: #e8c87a; border-bottom-color: #e8c87a; }
    .btn-generar { width: 100%; background: #e8c87a; color: #1a1500; border: none; border-radius: 12px; padding: 16px; font-size: 16px; font-weight: 600; cursor: pointer; margin-top: 20px; }
    .btn-marcar { width: 100%; background: #2a3a2a; color: #7ec47e; border: 1px solid #3a5a3a; border-radius: 12px; padding: 14px; font-size: 14px; font-weight: 600; cursor: pointer; margin-top: 10px; }
    .manual-input { background: #1e1e28; border: 1px solid #2a2a3a; color: #e0d8cc; padding: 8px; border-radius: 8px; font-size: 14px; width: 100%; }
    .nav-bar { position: fixed; bottom: 0; left: 0; right: 0; max-width: 480px; margin: 0 auto; background: #16161e; border-top: 1px solid #22223a; display: flex; z-index: 50; }
    body.pwa-mode .nav-bar { bottom: 52px; }
    body.pwa-mode { padding-bottom: 104px; }
    body.pwa-mode .nav-bar { bottom: 52px; }
    body.pwa-mode { padding-bottom: 104px; }
    .nav-btn { flex: 1; padding: 12px; background: none; border: none; font-size: 11px; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px; -webkit-tap-highlight-color: transparent; }
    .nav-btn.active { color: #e8c87a; }
    .nav-btn.inactive { color: #6a6070; }
    .nav-icon { font-size: 20px; }
  </style>
</head>
<body>
<div id="pwa-bar" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#16161e;border-top:1px solid #22223a;padding:8px 16px;display:none;justify-content:space-between;align-items:center;"><button onclick="window.history.back()" style="background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 16px;font-size:13px;cursor:pointer;">← Atrás</button><button onclick="window.location.reload()" style="background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 16px;font-size:13px;cursor:pointer;">⟳ Recargar</button></div><script>if(window.navigator.standalone || window.matchMedia("(display-mode: standalone)").matches){  var b=document.getElementById("pwa-bar");  if(b){b.style.display="flex";}  document.body.classList.add("pwa-mode");}</script>

  <div class="auth-screen" id="loginScreen">
    <div class="auth-logo"><svg width="120" height="32" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="1" width="14" height="14" rx="2.5" fill="#e8c87a"/><rect x="16" y="1" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="0" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="16" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><line x1="14.5" y1="1" x2="14.5" y2="31" stroke="#0f0f13" stroke-width="2"/><line x1="0" y1="16" x2="30" y2="16" stroke="#0f0f13" stroke-width="2"/><text x="38" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="300" fill="#f0ede8" letter-spacing="-0.5">Trim</text><text x="72" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="600" fill="#e8c87a" letter-spacing="-0.5">Gest</text></svg></div>
    <div class="auth-title">Bienvenido</div>
    <div class="auth-form">
      <input class="auth-input" id="loginEmail" type="email" placeholder="Email">
      <input class="auth-input" id="loginPassword" type="password" placeholder="Contraseña">
      <button class="auth-btn" onclick="login()">Entrar</button>
      <div id="loginError" class="auth-error"></div>
      <div style="text-align:center;margin-top:12px;"><a href="/recuperar" style="font-size:12px;color:#6a6070;text-decoration:none;">Olvidaste tu contrasena?</a></div>
      <div class="auth-switch">No tienes cuenta? <span onclick="mostrarRegistro()">Regístrate</span></div>
    </div>
  </div>

  <div class="auth-screen" id="registroScreen" style="display:none;">
    <div class="auth-logo"><svg width="120" height="32" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="1" width="14" height="14" rx="2.5" fill="#e8c87a"/><rect x="16" y="1" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="0" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="16" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><line x1="14.5" y1="1" x2="14.5" y2="31" stroke="#0f0f13" stroke-width="2"/><line x1="0" y1="16" x2="30" y2="16" stroke="#0f0f13" stroke-width="2"/><text x="38" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="300" fill="#f0ede8" letter-spacing="-0.5">Trim</text><text x="72" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="600" fill="#e8c87a" letter-spacing="-0.5">Gest</text></svg></div>
    <div class="auth-title">Crear cuenta</div>
    <div class="auth-form">
      <input class="auth-input" id="regEmpresa" type="text" placeholder="Nombre de tu empresa">
      <input class="auth-input" id="regEmail" type="email" placeholder="Email">
      <input class="auth-input" id="regPassword" type="password" placeholder="Contraseña">
      <input class="auth-input" id="regPassword2" type="password" placeholder="Confirmar contraseña">
      <button class="auth-btn" onclick="registro()">Crear cuenta</button>
      <div id="regError" class="auth-error"></div>
      <div class="auth-switch">Ya tienes cuenta? <span onclick="mostrarLogin()">Inicia sesión</span></div>
    </div>
  </div>

  <div class="main-app" id="mainApp">
    <div id="app"></div>
    <nav class="nav-bar">
      <button class="nav-btn active" id="nav-facturas" onclick="cambiarSeccion('facturas')">
        <span class="nav-icon">&#128196;</span>Documentos
      </button>
      <button class="nav-btn inactive" id="nav-resumen" onclick="cambiarSeccion('resumen')">
        <span class="nav-icon">&#128200;</span>Resumen
      </button>
      <button class="nav-btn inactive" id="nav-banco" onclick="cambiarSeccion('banco')">
        <span class="nav-icon">&#127981;</span>Banco
      </button>
    </nav>
  </div>

  <script>
    const API = 'https://trimgest.es';
    window.trimestreSel = null;
    window.annoSel = null;
    window.tabSel = 'pendientes';
    window.tipoSel = null;
    window.uploadOpen = false;
    window.chatHistorial = [];
    window.seccionActual = 'facturas';
    window.contadorLineas = 0;
    window.token = localStorage.getItem('trimgest_token');
    window.nombreEmpresa = localStorage.getItem('trimgest_empresa');

    // Gestionar retorno de Stripe
    (function() {
      const params = new URLSearchParams(window.location.search);
      const pago = params.get('pago');
      const plan = params.get('plan');
      if (pago === 'ok' && plan) {
        window.history.replaceState({}, '', '/app');
        setTimeout(function() {
          alert('¡Pago completado! Tu plan ' + (plan === 'estandar' ? 'Estándar' : 'Básico') + ' ya está activo.');
        }, 1000);
      } else if (pago === 'cancelado') {
        window.history.replaceState({}, '', '/app');
      }
    })();

    function getHeaders() {
      return {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + window.token
      };
    }

    function getTrimestre() {
      const m = new Date().getMonth();
      if (m <= 2) return 'T1';
      if (m <= 5) return 'T2';
      if (m <= 8) return 'T3';
      return 'T4';
    }

    function formatEur(n) {
      return Number(n).toLocaleString('es-ES', { style: 'currency', currency: 'EUR' });
    }

    function mostrarRegistro() {
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('registroScreen').style.display = 'flex';
    }

    function mostrarLogin() {
      document.getElementById('registroScreen').style.display = 'none';
      document.getElementById('loginScreen').style.display = 'flex';
    }

    async function login() {
      var email = document.getElementById('loginEmail').value;
      var password = document.getElementById('loginPassword').value;
      var err = document.getElementById('loginError');
      if (!email || !password) { err.textContent = 'Rellena todos los campos'; return; }
      err.textContent = '';
      try {
        var res = await fetch(API + '/usuarios/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        var data = await res.json();
        if (data.ok) {
          if (data.verificacion_pendiente) {
            gtag('event', 'conversion', {'send_to': 'AW-18198602025/pIh8CI_thbYcEKnC4uVD'});
            gtag('event', 'registro_completado', {'send_to': 'G-LRLKFDTN1E'});
            alert('✅ Cuenta creada. Revisa tu email y verifica tu cuenta antes de entrar.');
            document.getElementById('registroScreen').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'flex';
            return;
          }
          window.token = data.token;
          window.nombreEmpresa = data.nombre_empresa;
          localStorage.setItem('trimgest_token', data.token);
          localStorage.setItem('trimgest_empresa', data.nombre_empresa);
          mostrarApp();
        } else {
          err.textContent = data.error || 'Error al iniciar sesión';
        }
      } catch(e) {
        err.textContent = 'Error de conexion';
      }
    }

    async function registro() {
      var empresa = document.getElementById('regEmpresa').value;
      var email = document.getElementById('regEmail').value;
      var password = document.getElementById('regPassword').value;
      var password2 = document.getElementById('regPassword2').value;
      var err = document.getElementById('regError');
      if (!empresa || !email || !password) { err.textContent = 'Rellena todos los campos'; return; }
      if (password !== password2) { err.textContent = 'Las contraseñas no coinciden'; return; }
      if (password.length < 6) { err.textContent = 'La contraseña debe tener al menos 6 caracteres'; return; }
      err.textContent = '';
      try {
        var res = await fetch(API + '/usuarios/registro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, nombre_empresa: empresa, ref_referido_por: new URLSearchParams(window.location.search).get('ref') || null })
        });
        var data = await res.json();
        if (data.ok) {
          if (data.verificacion_pendiente) {
            gtag('event', 'conversion', {'send_to': 'AW-18198602025/pIh8CI_thbYcEKnC4uVD'});
            gtag('event', 'registro_completado', {'send_to': 'G-LRLKFDTN1E'});
            alert('✅ Cuenta creada. Revisa tu email y verifica tu cuenta antes de entrar.');
            document.getElementById('registroScreen').style.display = 'none';
            document.getElementById('loginScreen').style.display = 'flex';
            return;
          }
          window.token = data.token;
          window.nombreEmpresa = data.nombre_empresa;
          localStorage.setItem('trimgest_token', data.token);
          localStorage.setItem('trimgest_empresa', data.nombre_empresa);
          gtag('event', 'conversion', {'send_to': 'AW-18198602025/pIh8CI_thbYcEKnC4uVD'});
          gtag('event', 'registro_completado', {'send_to': 'G-LRLKFDTN1E'});
          mostrarApp();
        } else {
          err.textContent = data.error || 'Error al registrarse';
        }
      } catch(e) {
        err.textContent = 'Error de conexion';
      }
    }

    function mostrarApp() {
      document.getElementById('loginScreen').style.display = 'none';
      document.getElementById('registroScreen').style.display = 'none';
      document.getElementById('mainApp').style.display = 'block';
      window.trimestreSel = getTrimestre();
      window.annoSel = String(new Date().getFullYear());
      try {
        var _token = localStorage.getItem('trimgest_token');
        if (_token) {
          var _payload = JSON.parse(atob(_token.split('.')[1]));
          if (_payload.empresaId === 'emp_demo_construcciones') {
            window.annoSel = '2025';
            window.trimestreSel = 'T1';
          }
        }
      } catch(e) {}
      renderApp();
    }

    function cerrarSesion() {
      localStorage.removeItem('trimgest_token');
      localStorage.removeItem('trimgest_empresa');
      window.token = null;
      window.nombreEmpresa = null;
      var ajustes = document.getElementById('ajustesPanel');
      if (ajustes) ajustes.remove();
      document.getElementById('mainApp').style.display = 'none';
      document.getElementById('loginScreen').style.display = 'flex';
    }

    // Verificar token al cargar
    async function init() {
      if (window.token) {
        try {
          var res = await fetch(API + '/usuarios/verificar-token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ token: window.token })
          });
          var data = await res.json();
          if (data.ok) {
            window.nombreEmpresa = data.nombre_empresa;
            mostrarApp();
          } else {
            cerrarSesion();
          }
        } catch(e) {
          cerrarSesion();
        }
      }
    }

    init();

    // Detectar #registro en la URL
    var _refCodigo = new URLSearchParams(window.location.search).get('ref');
if (_refCodigo) sessionStorage.setItem('ref_codigo', _refCodigo);
if (window.location.hash === '#registro') {
      history.replaceState(null, '', '/app');
      mostrarRegistro();
    }

    function cambiarSeccion(seccion) {
      window.seccionActual = seccion;
      document.getElementById('nav-facturas').className = 'nav-btn ' + (seccion === 'facturas' ? 'active' : 'inactive');
      document.getElementById('nav-resumen').className = 'nav-btn ' + (seccion === 'resumen' ? 'active' : 'inactive');
      document.getElementById('nav-banco').className = 'nav-btn ' + (seccion === 'banco' ? 'active' : 'inactive');
      if (seccion === 'facturas') renderApp();
      if (seccion === 'resumen') renderResumen();
      if (seccion === 'banco') renderBanco();
    }

    async function renderNominas() {
      var res = await fetch(API + '/nominas/listar', { headers: getHeaders() });
      var data = await res.json();
      var nominas = data.nominas || [];
      var annoActual = window.annoSel || String(new Date().getFullYear());
      var nominasFiltradas = nominas.filter(function(n) { return String(n.anno) === annoActual; });
      var totalNeto = nominasFiltradas.reduce(function(s, n) { return s + Number(n.neto || 0); }, 0);
      var totalCoste = nominasFiltradas.reduce(function(s, n) { return s + Number(n.coste_empresa || 0); }, 0);

      var listaHTML = '';
      if (nominasFiltradas.length === 0) {
        listaHTML = '<div class="empty">No hay nominas en ' + annoActual + '</div>';
      } else {
        var porMes = {};
        nominasFiltradas.forEach(function(n) {
          var key = n.mes + ' ' + n.anno;
          if (!porMes[key]) porMes[key] = [];
          porMes[key].push(n);
        });
        Object.keys(porMes).forEach(function(mes) {
          listaHTML += '<div style="font-size:11px;letter-spacing:2px;color:#6a6070;text-transform:uppercase;margin:16px 0 8px;">' + mes + '</div>';
          porMes[mes].forEach(function(n) {
            listaHTML += '<div class="factura-card">';
            listaHTML += '<div class="factura-header"><span class="factura-nombre">' + n.trabajador + '</span>';
            listaHTML += '<span class="factura-total">' + formatEur(n.coste_empresa) + '</span></div>';
            listaHTML += '<div class="factura-datos"><span>Neto: ' + formatEur(n.neto) + '</span><span>IRPF: ' + formatEur(n.irpf_importe) + '</span><span>SS emp: ' + formatEur(n.ss_empresa) + '</span></div>';
            listaHTML += (n.duplicado_detectado ? '<div style="background:#2a1f00;border:1px solid #e8c87a;border-radius:8px;padding:10px 12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;"><span style="font-size:12px;color:#e8c87a;">⚠️ Posible duplicado detectado (' + (n.num_paginas || 2) + ' páginas)</span><div style="display:flex;gap:6px;"><button onclick="eliminarPaginaNomina(' + n.id + ',' + (n.pagina_duplicada || 2) + ')" style="background:#e8c87a;color:#1a1500;border:none;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;">Eliminar duplicado</button><button onclick="conservarNomina(' + n.id + ')" style="background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;">Conservar</button></div></div>' : '');
            listaHTML += '<div class="factura-acciones">' +
              (n.archivo ? '<button class="btn-accion" onclick="verArchivo(\'/nominas/archivo/' + n.archivo + '?token=' + window.token + '\')" >Ver PDF</button>' : '') +
              (n.archivo && n.num_paginas > 1 ? '<button class="btn-accion" onclick="eliminarPaginaNomina(' + n.id + ',' + (n.pagina_duplicada || 2) + ')" title="Dividir PDF">✂️</button>' : '') +
              '<button class="btn-accion" onclick="editarNomina(' + n.id + ')">Editar</button>' +
              '<button class="btn-borrar" onclick="borrarNomina(' + n.id + ')">Borrar</button>' +
              '</div>' +
              '<div class="edit-form" id="edit-nomina-' + n.id + '">' +
              '<div class="edit-row"><input class="edit-input" id="en-trabajador-' + n.id + '" value="' + (n.trabajador || '') + '" placeholder="Trabajador"></div>' +
              '<div class="edit-row">' +
              '<input class="edit-input" id="en-neto-' + n.id + '" value="' + (n.neto || '') + '" placeholder="Neto" style="width:48%">' +
              '<input class="edit-input" id="en-coste-' + n.id + '" value="' + (n.coste_empresa || '') + '" placeholder="Coste empresa" style="width:48%">' +
              '</div>' +
              '<div class="edit-row">' +
              '<input class="edit-input" id="en-irpf-' + n.id + '" value="' + (n.irpf_importe || '') + '" placeholder="IRPF importe" style="width:48%">' +
              '<input class="edit-input" id="en-ss-' + n.id + '" value="' + (n.ss_empresa || '') + '" placeholder="SS empresa" style="width:48%">' +
              '</div>' +
              '<button class="btn-guardar" onclick="guardarNomina(' + n.id + ')">Guardar cambios</button>' +
              '</div></div>';
          });
        });
      }

      var anos = [];
      for (var y = new Date().getFullYear() - 2; y <= new Date().getFullYear() + 1; y++) anos.push(String(y));
      var optsAno = anos.map(function(a) { return '<option value="' + a + '"' + (annoActual === a ? ' selected' : '') + '>' + a + '</option>'; }).join('');

      if (window.todasFacturas) checkPopupEstadoPago(window.todasFacturas);
      document.getElementById('app').innerHTML =
        '<div class="header">' +
        '<div class="header-top"><div><div class="label">TrimGest</div><h1>Nominas ' + annoActual + '</h1></div>' +
        '<div style="display:flex;gap:4px;align-items:center;">' +
        '<button class="btn-ajustes" onclick="mostrarAsesor()">&#129302;</button>' +
        '<button class="btn-ajustes" onclick="abrirAjustesGestoria()" title="' + (window.estadoGestoria==='conectada'?window.nombreGestoria:(window.estadoGestoria==='pendiente'?'Solicitud pendiente':'')) + '" style="position:relative;">' +
        (window.estadoGestoria==='conectada' ? '<span style="position:absolute;top:2px;right:2px;width:8px;height:8px;border-radius:50%;background:#4caf7d;border:1px solid #0f0f13;"></span>' : '') +
        (window.estadoGestoria==='pendiente' ? '<span style="position:absolute;top:2px;right:2px;width:8px;height:8px;border-radius:50%;background:#e8c87a;border:1px solid #0f0f13;"></span>' : '') +
        '&#9881;</button>' +
        '<button class="btn-ajustes" onclick="cerrarSesion()" title="Cerrar sesión" style="font-size:18px;">&#x23FB;</button>' +
        '<button class="btn-subir" onclick="toggleUpload()">+ Subir</button>' +
        '</div></div>' +
        '<div class="selectores"><select onchange="window.annoSel=this.value;renderNominas()">' + optsAno + '</select></div>' +
        '<div class="stats">' +
        '<div class="stat"><div class="stat-label">Coste empresa</div><div class="stat-value">' + formatEur(totalCoste) + '</div><div class="stat-count">' + nominasFiltradas.length + ' nominas</div></div>' +
        '<div class="stat"><div class="stat-label">Neto pagado</div><div class="stat-value verde">' + formatEur(totalNeto) + '</div></div>' +
        '</div></div>' +
        '<div class="content"><div id="nominaUploadStatus"></div>' + listaHTML + '</div>';
    }


    async function renderResumen() {
      var resF = await fetch(API + '/facturas/listar', { headers: getHeaders() });
      var dataF = await resF.json();
      var todasFacturas = dataF.facturas || [];
      var resN = await fetch(API + '/nominas/listar', { headers: getHeaders() });
      var dataN = await resN.json();
      var todasNominas = dataN.nominas || [];
      var annoActual = window.annoSel || String(new Date().getFullYear());
      var anos = [];
      for (var y = new Date().getFullYear() - 2; y <= new Date().getFullYear() + 1; y++) anos.push(String(y));
      var optsAno = anos.map(function(a) { return '<option value="' + a + '"' + (annoActual === a ? ' selected' : '') + '>' + a + '</option>'; }).join('');
      var mesesTrim = { T1: ['01','02','03'], T2: ['04','05','06'], T3: ['07','08','09'], T4: ['10','11','12'] };
      function calcTrim(t) {
        var provs = todasFacturas.filter(function(f) { return f.tipo !== 'cliente' && f.trimestre === t && String(f.anno) === annoActual; });
        var clis = todasFacturas.filter(function(f) { return f.tipo === 'cliente' && f.trimestre === t && String(f.anno) === annoActual; });
        var _mesesNombresRes = { enero:'01', febrero:'02', marzo:'03', abril:'04', mayo:'05', junio:'06', julio:'07', agosto:'08', septiembre:'09', octubre:'10', noviembre:'11', diciembre:'12' };
        var nomsT = todasNominas.filter(function(n) { var mesNum = _mesesNombresRes[String(n.mes).toLowerCase()] || String(n.mes).padStart(2,'0'); return String(n.anno) === annoActual && mesesTrim[t] && mesesTrim[t].indexOf(mesNum) !== -1; });
        return {
          baseProvs: provs.reduce(function(s,f) { return s+Number(f.base_imponible||0); }, 0),
          ivaProv: provs.reduce(function(s,f) { return s+Number(f.iva_importe||0); }, 0),
          totalProv: provs.reduce(function(s,f) { return s+Number(f.total||0); }, 0),
          numProvs: provs.length,
          baseClis: clis.reduce(function(s,f) { return s+Number(f.base_imponible||0); }, 0),
          ivaCli: clis.reduce(function(s,f) { return s+Number(f.iva_importe||0); }, 0),
          totalCli: clis.reduce(function(s,f) { return s+Number(f.total||0); }, 0),
          numClis: clis.length,
          costeNom: nomsT.reduce(function(s,n) { return s+Number(n.coste_empresa||0); }, 0),
          numNoms: nomsT.length
        };
      }
      var trims = ['T1','T2','T3','T4'];
      var datos = {};
      trims.forEach(function(t) { datos[t] = calcTrim(t); });
      var totalBaseProvAnual = trims.reduce(function(s,t) { return s+datos[t].baseProvs; }, 0);
      var totalIvaProvAnual = trims.reduce(function(s,t) { return s+datos[t].ivaProv; }, 0);
      var totalBaseCliAnual = trims.reduce(function(s,t) { return s+datos[t].baseClis; }, 0);
      var totalIvaCliAnual = trims.reduce(function(s,t) { return s+datos[t].ivaCli; }, 0);
      var totalNomAnual = trims.reduce(function(s,t) { return s+datos[t].costeNom; }, 0);
      var ivaLiquidar = totalIvaCliAnual - totalIvaProvAnual;
      function tarjeta(t) {
        var d = datos[t];
        var ivaRes = d.ivaCli - d.ivaProv;
        var ivaColor = ivaRes >= 0 ? '#4caf7d' : '#e05555';
        var html = '<div style="background:#16161e;border:1px solid #22223a;border-radius:14px;padding:18px;cursor:pointer;" onclick="window.trimestreSel=' + "'" + t + "'" + ';cambiarSeccion(' + "'facturas'" + ')">';
        html += '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px;">';
        html += '<div style="font-size:18px;font-weight:600;color:#e8c87a;">' + t + '</div>';
        html += '<div style="font-size:11px;color:#6a6070;">' + annoActual + '</div></div>';
        html += '<div style="display:flex;flex-direction:column;gap:8px;">';
        html += '<div style="display:flex;justify-content:space-between;font-size:12px;"><span style="color:#6a6070;">Proveedores (' + d.numProvs + ')</span><span style="color:#e05555;">-' + formatEur(d.totalProv) + '</span></div>';
        html += '<div style="display:flex;justify-content:space-between;font-size:12px;"><span style="color:#6a6070;">Clientes (' + d.numClis + ')</span><span style="color:#4caf7d;">+' + formatEur(d.totalCli) + '</span></div>';
        html += '<div style="display:flex;justify-content:space-between;font-size:12px;"><span style="color:#6a6070;">Nominas (' + d.numNoms + ')</span><span style="color:#e05555;">-' + formatEur(d.costeNom) + '</span></div>';
        html += '<div style="border-top:1px solid #22223a;margin-top:6px;padding-top:8px;display:flex;justify-content:space-between;font-size:12px;">';
        html += '<span style="color:#6a6070;">IVA a liquidar</span><span style="color:' + ivaColor + ';font-weight:600;">' + formatEur(ivaRes) + '</span></div>';
        html += '</div></div>';
        return html;
      }
      var ivaColor = ivaLiquidar >= 0 ? '#4caf7d' : '#e05555';
      var html = '<div class="header">';
      html += '<div class="header-top"><div><div class="label">TrimGest</div><h1>Resumen ' + annoActual + '</h1></div>';
      html += '<div style="display:flex;gap:4px;align-items:center;">';
      html += '<button class="btn-ajustes" onclick="mostrarAsesor()">&#129302;</button>';
      html += '<button class="btn-ajustes" onclick="mostrarAjustes()">&#9881;</button>';
      html += '</div></div>';
      html += '<div class="selectores"><select onchange="window.annoSel=this.value;renderResumen()">' + optsAno + '</select></div>';
      html += '<div class="stats">';
      html += '<div class="stat"><div class="stat-label">Ingresos</div><div class="stat-value verde">' + formatEur(totalBaseCliAnual) + '</div></div>';
      html += '<div class="stat"><div class="stat-label">Gastos</div><div class="stat-value">' + formatEur(totalBaseProvAnual) + '</div></div>';
      html += '<div class="stat"><div class="stat-label">IVA neto</div><div class="stat-value" style="color:' + ivaColor + ';">' + formatEur(ivaLiquidar) + '</div></div>';
      html += '</div></div>';
      html += '<div class="content">';
      html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;">';
      html += tarjeta('T1') + tarjeta('T2') + tarjeta('T3') + tarjeta('T4');
      html += '</div>';
      html += '<div style="background:#16161e;border:1px solid #22223a;border-radius:14px;padding:18px;">';
      html += '<div style="font-size:13px;font-weight:600;color:#f0ede8;margin-bottom:14px;">Resumen anual</div>';
      html += '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #22223a;font-size:13px;"><span style="color:#6a6070;">Base imponible proveedores</span><span style="color:#e05555;">-' + formatEur(totalBaseProvAnual) + '</span></div>';
      html += '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #22223a;font-size:13px;"><span style="color:#6a6070;">IVA soportado</span><span style="color:#e05555;">-' + formatEur(totalIvaProvAnual) + '</span></div>';
      html += '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #22223a;font-size:13px;"><span style="color:#6a6070;">Base imponible clientes</span><span style="color:#4caf7d;">+' + formatEur(totalBaseCliAnual) + '</span></div>';
      html += '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #22223a;font-size:13px;"><span style="color:#6a6070;">IVA repercutido</span><span style="color:#4caf7d;">+' + formatEur(totalIvaCliAnual) + '</span></div>';
      html += '<div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #22223a;font-size:13px;"><span style="color:#6a6070;">Coste nominas</span><span style="color:#e05555;">-' + formatEur(totalNomAnual) + '</span></div>';
      html += '<div style="display:flex;justify-content:space-between;padding:10px 0;font-size:14px;font-weight:600;"><span style="color:#f0ede8;">IVA neto a liquidar</span><span style="color:' + ivaColor + ';">' + formatEur(ivaLiquidar) + '</span></div>';
      html += '</div></div>';
      document.getElementById('app').innerHTML = html;
    }

    function subirNomina() {
      var input = document.createElement('input');
      input.type = 'file';
      input.accept = 'application/pdf';
      input.onchange = function() { procesarNomina(input.files[0]); };
      input.click();
    }

    async function procesarNomina(file) {
      if (!file) return;
      var status = document.getElementById('nominaUploadStatus');
      if (status) status.innerHTML = '<div class="uploading">Procesando nomina con IA...</div>';
      var formData = new FormData();
      formData.append('nomina', file);
      try {
        var res = await fetch(API + '/nominas/subir', {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + window.token },
          body: formData
        });
        var data = await res.json();
        if (data.nomina) {
          if (data.nomina.duplicado_detectado) {
            if (status) status.innerHTML = '<div class="success">Nomina guardada correctamente</div>';
            var eliminar = confirm('He detectado que esta nomina tiene 2 paginas casi identicas (copia empresa y copia empleado). ¿Elimino la pagina duplicada y conservo solo una?');
            if (eliminar) {
              var pagina = data.nomina.pagina_duplicada || 2;
              await fetch(API + '/nominas/eliminar-pagina/' + data.nomina.id, {
                method: 'POST',
                headers: Object.assign({}, getHeaders(), {'Content-Type': 'application/json'}),
                body: JSON.stringify({ pagina: pagina })
              });
            } else {
              await fetch(API + '/nominas/conservar/' + data.nomina.id, { method: 'POST', headers: getHeaders() });
            }
            setTimeout(function() { renderApp(); }, 500);
          } else {
            if (status) status.innerHTML = '<div class="success">Nomina guardada correctamente</div>';
            setTimeout(function() { renderApp(); }, 1000);
          }
        } else {
          if (status) status.innerHTML = '<div class="error">Error al procesar la nomina</div>';
        }
      } catch(e) {
        if (status) status.innerHTML = '<div class="error">Error de conexion</div>';
      }
    }

    function editarNomina(id) {
      var form = document.getElementById('edit-nomina-' + id);
      if (!form) return;
      form.style.display = form.style.display === 'flex' ? 'none' : 'flex';
    }

    async function guardarNomina(id) {
      var datos = {
        trabajador: document.getElementById('en-trabajador-' + id).value,
        neto: document.getElementById('en-neto-' + id).value,
        coste_empresa: document.getElementById('en-coste-' + id).value,
        irpf_importe: document.getElementById('en-irpf-' + id).value,
        ss_empresa: document.getElementById('en-ss-' + id).value
      };
      try {
        var r = await fetch(API + '/nominas/editar/' + id, {
          method: 'PUT',
          headers: getHeaders(),
          body: JSON.stringify(datos)
        });
        var d = await r.json();
        if (d.ok) { renderApp(); }
        else alert(d.error || 'Error al guardar');
      } catch(e) { alert('Error de conexion'); }
    }

    async function borrarNomina(id) {
      if (!confirm('Seguro que quieres borrar esta nomina?')) return;
      await fetch(API + '/nominas/borrar/' + id, { method: 'DELETE', headers: getHeaders() });
      renderApp();
    }

    async function eliminarPaginaNomina(id, pagina) {
      if (!confirm('Se eliminara la pagina ' + pagina + ' del PDF. Continuar?')) return;
      var r = await fetch(API + '/nominas/eliminar-pagina/' + id, { method: 'POST', headers: Object.assign({}, getHeaders(), {'Content-Type': 'application/json'}), body: JSON.stringify({ pagina: pagina }) });
      var d = await r.json();
      if (d.ok) { renderApp(); } else { alert('Error eliminando pagina'); }
    }

    async function conservarNomina(id) {
      await fetch(API + '/nominas/conservar/' + id, { method: 'POST', headers: getHeaders() });
      renderApp();
    }

    function toggleManual() {
      var form = document.getElementById('manualForm');
      if (!form) return;
      var abierto = form.style.display === 'flex';
      form.style.display = abierto ? 'none' : 'flex';
      if (!abierto) {
        window.contadorLineas = 0;
        var contenedor = document.getElementById('lineasIva');
        if (contenedor) contenedor.innerHTML = '';
        añadirLineaIva();
      }
    }

    function añadirLineaIva() {
      var idx = window.contadorLineas++;
      var contenedor = document.getElementById('lineasIva');
      if (!contenedor) return;
      var linea = document.createElement('div');
      linea.id = 'linea-' + idx;
      linea.style.cssText = 'display:flex;gap:6px;align-items:center;';
      linea.innerHTML =
        '<input id="base-' + idx + '" type="number" placeholder="Base" class="manual-input" style="flex:1;" oninput="calcularTotal()">' +
        '<select id="iva-' + idx + '" class="manual-input" style="flex:0.8;" onchange="calcularTotal()">' +
        '<option value="21">21%</option><option value="10">10%</option><option value="4">4%</option><option value="0">0%</option>' +
        '</select>' +
        (idx > 0 ? '<button onclick="eliminarLinea(' + idx + ')" style="background:#2a1a1a;border:1px solid #3a1a1a;color:#c06060;border-radius:6px;padding:6px 10px;font-size:14px;cursor:pointer;">x</button>' : '<div style="width:34px;"></div>');
      contenedor.appendChild(linea);
    }

    function eliminarLinea(idx) {
      var linea = document.getElementById('linea-' + idx);
      if (linea) linea.remove();
      calcularTotal();
    }

    function calcularTotal() {
      var total = 0;
      var contenedor = document.getElementById('lineasIva');
      if (!contenedor) return;
      contenedor.querySelectorAll('div[id^="linea-"]').forEach(function(linea) {
        var idx = linea.id.replace('linea-', '');
        var base = parseFloat(document.getElementById('base-' + idx).value) || 0;
        var iva = parseFloat(document.getElementById('iva-' + idx).value) || 0;
        total += base + (base * iva / 100);
      });
      var totalInput = document.getElementById('manualTotal');
      if (totalInput) totalInput.value = total.toFixed(2);
    }

    async function enviarManual() {
      var tipo = document.getElementById('manualTipo').value;
      var nombre = document.getElementById('manualNombre').value;
      var numero = document.getElementById('manualNumero').value;
      var fecha = document.getElementById('manualFecha').value;
      var total = parseFloat(document.getElementById('manualTotal').value);
      var contenedor = document.getElementById('lineasIva');
      var baseTotal = 0; var ivaImporteTotal = 0; var ivasPorcentaje = [];
      contenedor.querySelectorAll('div[id^="linea-"]').forEach(function(linea) {
        var idx = linea.id.replace('linea-', '');
        var base = parseFloat(document.getElementById('base-' + idx).value) || 0;
        var iva = parseFloat(document.getElementById('iva-' + idx).value) || 0;
        baseTotal += base; ivaImporteTotal += base * iva / 100;
        if (iva > 0) ivasPorcentaje.push(iva);
      });
      if (!nombre || !numero || !fecha || baseTotal === 0 || !total) {
        document.getElementById('uploadStatus').innerHTML = '<div class="error">Rellena todos los campos obligatorios</div>';
        return;
      }
      var ivaPorcentajeResumen = ivasPorcentaje.length > 1 ? ivasPorcentaje.join('+') : (ivasPorcentaje[0] || 0);
      document.getElementById('uploadStatus').innerHTML = '<div class="uploading">Guardando...</div>';
      try {
        var res = await fetch(API + '/facturas/manual', {
          method: 'POST', headers: getHeaders(),
          body: JSON.stringify({ tipo, nombre, cif: (document.getElementById('manualCif') ? document.getElementById('manualCif').value || null : null), numero_factura: numero, fecha, base_imponible: baseTotal.toFixed(2), iva_porcentaje: ivaPorcentajeResumen, iva_importe: ivaImporteTotal.toFixed(2), total, trimestre: window.trimestreSel, anno: window.annoSel })
        });
        var data = await res.json();
        if (data.factura) { window.uploadOpen = false; setTimeout(function() { renderApp(); }, 1000); }
        else { document.getElementById('uploadStatus').innerHTML = '<div class="error">Error al guardar</div>'; }
      } catch(e) { document.getElementById('uploadStatus').innerHTML = '<div class="error">Error de conexion</div>'; }
    }

    function mostrarAsesor() {
      window.chatHistorial = [];
      var div = document.createElement('div');
      div.id = 'asesorPanel';
      div.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:#0f0f13;z-index:100;display:flex;flex-direction:column;max-width:480px;margin:0 auto;';
      div.innerHTML =
        '<div style="background:#16161e;padding:20px;border-bottom:1px solid #22223a;display:flex;justify-content:space-between;align-items:center;">' +
        '<div><div style="font-size:11px;letter-spacing:3px;color:#6a6070;text-transform:uppercase;">TrimGest</div>' +
        '<div style="font-size:18px;color:#e8c87a;">Asesor financiero</div></div>' +
        '<button onclick="cerrarAsesor()" style="background:none;border:none;color:#6a6070;font-size:24px;cursor:pointer;">X</button></div>' +
        '<div id="chatMessages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;">' +
        '<div style="background:#16161e;border-radius:12px;padding:14px;font-size:14px;color:#9a90b4;">Hola, soy tu asesor financiero. Puedo ayudarte a entender como va tu negocio este trimestre.</div>' +'<div style="background:#1e1a10;border:1px solid #3a3010;border-radius:10px;padding:10px 14px;font-size:12px;color:#8a7a50;">⚠️ El asesor no guarda el historial entre sesiones. Sus respuestas son orientativas y no constituyen asesoramiento profesional.</div>' +
        '</div>' +
        '<div style="padding:16px;background:#16161e;border-top:1px solid #22223a;display:flex;gap:8px;">' +
        '<input id="chatInput" type="text" placeholder="Preguntame lo que quieras..." style="background:#1e1e28;border:1px solid #2a2a3a;color:#e0d8cc;padding:12px;border-radius:10px;font-size:14px;flex:1;" onkeydown="if(event.key===\'Enter\')enviarMensaje();">' +
        '<button onclick="enviarMensaje()" style="background:#e8c87a;color:#1a1500;border:none;border-radius:10px;padding:12px 16px;font-size:16px;cursor:pointer;">-></button></div>';
      document.body.appendChild(div);
    }

    function cerrarAsesor() { var p = document.getElementById('asesorPanel'); if (p) p.remove(); }

    async function enviarMensaje() {
      var input = document.getElementById('chatInput');
      var mensaje = input.value.trim();
      if (!mensaje) return;
      input.value = '';
      var messages = document.getElementById('chatMessages');
      var userMsg = document.createElement('div');
      userMsg.style.cssText = 'background:#1e1e28;border-radius:12px;padding:14px;font-size:14px;color:#e0d8cc;align-self:flex-end;max-width:85%;';
      userMsg.textContent = mensaje;
      messages.appendChild(userMsg);
      var loadingMsg = document.createElement('div');
      loadingMsg.style.cssText = 'background:#16161e;border-radius:12px;padding:14px;font-size:14px;color:#6a6070;';
      loadingMsg.textContent = 'Pensando...';
      messages.appendChild(loadingMsg);
      messages.scrollTop = messages.scrollHeight;
      window.chatHistorial.push({ role: 'user', content: mensaje });
      try {
        var res = await fetch(API + '/asesor/chat', {
          method: 'POST', headers: getHeaders(),
          body: JSON.stringify({ mensaje, trimestre: window.trimestreSel, anno: window.annoSel, historial: window.chatHistorial.slice(-6) })
        });
        var data = await res.json();
        loadingMsg.style.color = '#9a90b4';
        loadingMsg.textContent = data.respuesta;
        window.chatHistorial.push({ role: 'assistant', content: data.respuesta });
      } catch(e) { loadingMsg.style.color = '#c06060'; loadingMsg.textContent = 'Error de conexion'; }
      messages.scrollTop = messages.scrollHeight;
    }

    async function mostrarPlanes() {
      var div = document.createElement('div');
      div.id = 'planesPanel';
      div.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:#0f0f13;z-index:100;display:flex;flex-direction:column;align-items:center;padding:40px 20px;overflow-y:auto;';
      div.innerHTML =
        '<div style="font-size:11px;letter-spacing:3px;color:#6a6070;text-transform:uppercase;margin-bottom:8px;">TrimGest</div>' +
        '<div style="font-size:22px;color:#f0ede8;margin-bottom:8px;">Planes</div>' +
        '<div style="font-size:13px;color:#6a6070;margin-bottom:32px;">Sin permanencia. Cancela cuando quieras.</div>' +
        '<div style="width:100%;max-width:340px;display:flex;flex-direction:column;gap:12px;">' +
        '<div style="background:#16161e;border:1px solid #22223a;border-radius:14px;padding:20px;">' +
        '<div style="font-size:18px;font-weight:500;margin-bottom:4px;">Basico</div>' +
        '<div style="font-size:32px;color:#e8c87a;margin-bottom:4px;">10<span style="font-size:14px;color:#6a6070;">€/mes</span></div>' +
        '<div style="font-size:13px;color:#6a6070;margin-bottom:16px;">100 subidas por trimestre</div>' +
        '<button onclick="checkout(\'basico\')" style="width:100%;background:#1e1e28;border:1px solid #2a2a3a;color:#e0d8cc;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;">Elegir Basico</button>' +
        '</div>' +
        '<div style="background:#16161e;border:2px solid #e8c87a;border-radius:14px;padding:20px;">' +
        '<div style="font-size:11px;letter-spacing:2px;color:#e8c87a;text-transform:uppercase;margin-bottom:8px;">Mas popular</div>' +
        '<div style="font-size:18px;font-weight:500;margin-bottom:4px;">Estandar</div>' +
        '<div style="font-size:32px;color:#e8c87a;margin-bottom:4px;">20<span style="font-size:14px;color:#6a6070;">€/mes</span></div>' +
        '<div style="font-size:13px;color:#6a6070;margin-bottom:16px;">200 subidas por trimestre</div>' +
        '<button onclick="checkout(\'estandar\')" style="width:100%;background:#e8c87a;color:#1a1500;border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;">Elegir Estandar</button>' +
        '</div>' +
        '<div style="background:#16161e;border:1px solid #7ec47e;border-radius:14px;padding:20px;">' +
        '<div style="font-size:11px;letter-spacing:2px;color:#7ec47e;text-transform:uppercase;margin-bottom:8px;">Para gestores</div>' +
        '<div style="font-size:18px;font-weight:500;margin-bottom:4px;">Gestoria</div>' +
        '<div style="font-size:32px;color:#7ec47e;margin-bottom:4px;">Gratis</div>' +
        '<div style="font-size:13px;color:#6a6070;margin-bottom:16px;">Panel con todos tus clientes</div>' +
        '<a href="/panel-gestoria" style="display:block;width:100%;background:#7ec47e;color:#0f0f13;border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;">Registrarse gratis</a>' +
        '</div>' +
        '</div>' +
        '<button onclick="document.getElementById(\'planesPanel\').remove()" style="margin-top:24px;background:none;border:none;color:#6a6070;font-size:13px;cursor:pointer;text-decoration:underline;">Volver</button>';
      document.body.appendChild(div);
    }

    async function checkout(plan) {
      try {
        var res = await fetch(API + '/stripe/checkout', {
          method: 'POST', headers: getHeaders(),
          body: JSON.stringify({ plan: plan })
        });
        var data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          alert('Error al iniciar el pago');
        }
      } catch(e) {
        alert('Error de conexion');
      }
    }

    function abrirAjustesGestoria() {
      if (window.estadoGestoria !== 'sin_gestoria') { mostrarAjustes('gestoria'); } else { mostrarAjustes(); }
    }
    function ajustesTab(tab) {
      ['tab-empresa','tab-gestoria','tab-plan'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.style.background = id === 'tab-'+tab ? '#e8c87a' : '#1e1e28';
        if (el) el.style.color = id === 'tab-'+tab ? '#0f0f13' : '#9a90b4';
      });
      ['panel-empresa','panel-gestoria','panel-plan'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.style.display = id === 'panel-'+tab ? 'flex' : 'none';
      });
      window.ajustesTabActual = tab;
    }

