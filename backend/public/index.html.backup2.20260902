        '</div>'+
        '<div style="display:flex;gap:6px;margin-bottom:20px;">'+
        '<button id="tab-empresa" onclick="ajustesTab(' + "'empresa'" + ')" style="flex:1;padding:9px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid #2a2a3a;background:#e8c87a;color:#0f0f13;">Empresa</button>'+
        '<button id="tab-gestoria" onclick="ajustesTab(' + "'gestoria'" + ')" style="flex:1;padding:9px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid #2a2a3a;background:#1e1e28;color:#9a90b4;">Gestoría</button>'+
        '<button id="tab-plan" onclick="ajustesTab(' + "'plan'" + ')" style="flex:1;padding:9px;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid #2a2a3a;background:#1e1e28;color:#9a90b4;">Plan</button>'+
        '</div>'+
        '<div id="panel-empresa" style="display:flex;flex-direction:column;gap:12px;">'+
        '<div style="font-size:12px;color:#6a6070;">Nombre empresa</div>'+
        '<input id="ajNombre" class="manual-input" value="' + (perfil.nombre_empresa || '') + '" placeholder="Nombre empresa">'+
        '<div style="font-size:12px;color:#6a6070;">NIF / CIF</div>'+
        '<input id="ajNif" class="manual-input" value="' + (perfil.nif || '') + '" placeholder="B12345678">'+
        '<div style="font-size:12px;color:#6a6070;">Dirección</div>'+
        '<input id="ajDireccion" class="manual-input" value="' + (perfil.direccion || '') + '" placeholder="Calle y número">'+
        '<div style="display:flex;gap:6px;">'+
        '<input id="ajCp" class="manual-input" value="' + (perfil.cp || '') + '" placeholder="CP" style="flex:0.5;">'+
        '<input id="ajCiudad" class="manual-input" value="' + (perfil.ciudad || '') + '" placeholder="Ciudad" style="flex:1;">'+
        '</div>'+
        '<input id="ajProvincia" class="manual-input" value="' + (perfil.provincia || '') + '" placeholder="Provincia">'+
        '<div style="font-size:12px;color:#6a6070;">Teléfono WhatsApp</div>'+
        '<input id="ajTelefono" class="manual-input" value="' + (perfil.telefono || '') + '" placeholder="Ej: 612345678 (sin +34)">'+
        '<div style="font-size:11px;color:#6a6070;margin-top:-8px;">Tu gestoría podrá contactarte por WhatsApp</div>'+
        '<div style="font-size:12px;color:#6a6070;">Trimestre fiscal</div>'+
        '<select id="ajTrimestre" class="manual-input">'+
        '<option value="T1"' + (perfil.trimestre_fiscal === 'T1' ? ' selected' : '') + '>T1 — Enero, Febrero, Marzo</option>'+
        '<option value="T2"' + (perfil.trimestre_fiscal === 'T2' ? ' selected' : '') + '>T2 — Abril, Mayo, Junio</option>'+
        '<option value="T3"' + (perfil.trimestre_fiscal === 'T3' ? ' selected' : '') + '>T3 — Julio, Agosto, Septiembre</option>'+
        '<option value="T4"' + (perfil.trimestre_fiscal === 'T4' ? ' selected' : '') + '>T4 — Octubre, Noviembre, Diciembre</option>'+
        '</select>'+
        '<button onclick="guardarPerfil()" style="background:#e8c87a;color:#1a1500;border:none;border-radius:10px;padding:14px;font-size:15px;font-weight:600;cursor:pointer;width:100%;margin-top:4px;">Guardar datos</button>'+
        '<div id="ajMsg" style="font-size:13px;text-align:center;"></div>'+
        '</div>'+
        '<div id="panel-gestoria" style="display:none;flex-direction:column;gap:12px;">'+
        '<div style="font-size:15px;color:#f0ede8;font-weight:600;margin-bottom:4px;">Mi gestoría</div>'+
        '<div style="font-size:12px;color:#6a6070;margin-bottom:4px;">Gestoría con acceso a tus datos</div>'+
        '<div id="ajGestoriasLista" style="margin-bottom:6px;"></div>'+
        '<div style="display:flex;gap:8px;margin-bottom:4px;">'+
        '<input id="ajEmailGestoria" class="manual-input" placeholder="Email de tu gestoría" style="flex:1;font-size:13px;">'+
        '<button onclick="invitarGestoria()" style="background:#e8c87a;color:#1a1500;border:none;border-radius:10px;padding:10px 16px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;">Invitar</button>'+
        '</div>'+
        '<div id="ajGestoriaMsg" style="font-size:12px;margin-bottom:4px;"></div>'+
        '<div style="font-size:12px;color:#6a6070;margin-top:8px;">Solicitudes pendientes</div>'+
        '<div id="ajSolicitudesLista" style="margin-bottom:8px;"></div>'+
        '<div style="margin-top:16px;padding-top:16px;border-top:1px solid #22223a;">'+
        '<div style="font-size:15px;color:#f0ede8;font-weight:600;margin-bottom:8px;">📧 Importar por email</div>'+
        '<div style="font-size:12px;color:#6a6070;margin-bottom:10px;">Reenvía facturas o nóminas a estas direcciones y la IA las procesará:</div>'+
        '<div style="background:#16161e;border:1px solid #22223a;border-radius:10px;padding:12px;margin-bottom:8px;">'+
        '<div style="font-size:11px;color:#6a6070;margin-bottom:4px;">Facturas de proveedor</div>'+
        '<div style="display:flex;align-items:center;gap:8px;">'+
        '<div id="emailFacturasInbound" style="font-size:12px;color:#e8c87a;font-family:monospace;flex:1;word-break:break-all;">facturas+' + perfil.empresaId + '@trimgest.es</div>'+
        '<button onclick="copiarEmail(' + "'facturas'" + ')" style="background:#22223a;border:none;color:#f0ede8;border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;">Copiar</button>'+
        '</div></div>'+
        '<div style="background:#16161e;border:1px solid #22223a;border-radius:10px;padding:12px;margin-bottom:8px;">'+
        '<div style="font-size:11px;color:#6a6070;margin-bottom:4px;">Facturas de cliente</div>'+
        '<div style="display:flex;align-items:center;gap:8px;">'+
        '<div style="font-size:12px;color:#e8c87a;font-family:monospace;flex:1;word-break:break-all;">clientes+' + perfil.empresaId + '@trimgest.es</div>'+
        '<button onclick="navigator.clipboard.writeText(' + "'clientes+' + perfil.empresaId + '@trimgest.es')" + '" style="background:#22223a;border:none;color:#f0ede8;border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;">Copiar</button>'+
        '</div></div>'+
        '<div style="background:#16161e;border:1px solid #22223a;border-radius:10px;padding:12px;margin-bottom:8px;">'+
        '<div style="font-size:11px;color:#6a6070;margin-bottom:4px;">Nóminas</div>'+
        '<div style="display:flex;align-items:center;gap:8px;">'+
        '<div id="emailNominasInbound" style="font-size:12px;color:#e8c87a;font-family:monospace;flex:1;word-break:break-all;">nominas+' + perfil.empresaId + '@trimgest.es</div>'+
        '<button onclick="copiarEmail(' + "'nominas'" + ')" style="background:#22223a;border:none;color:#f0ede8;border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;">Copiar</button>'+
        '</div></div>'+
        '<div style="font-size:11px;color:#6a6070;">Recibirás un email cuando se procesen.</div>'+
        '</div>'+
        '</div>'+
        '<div id="panel-plan" style="display:none;flex-direction:column;gap:12px;">'+
        '<div style="background:#16161e;border-radius:12px;padding:16px;margin-bottom:4px;">'+
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">'+
        '<div style="font-size:14px;color:#e8c87a;font-weight:600;">' + (perfil.plan_gratuito ? 'Plan gratuito' : perfil.plan === 'estandar' ? 'Plan Estándar' : perfil.plan === 'basico' ? 'Plan Básico' : 'Plan Free') + '</div>'+
        '<div style="font-size:12px;color:#6a6070;">' + (perfil.plan_gratuito ? 'Sin límites' : perfil.plan === 'estandar' ? '200 subidas/trimestre' : perfil.plan === 'basico' ? '100 subidas/trimestre' : '10 subidas/trimestre') + '</div>'+
        '</div>'+
        '<div style="font-size:12px;color:#6a6070;margin-bottom:6px;">Documentos subidos: ' + (perfil.facturas_mes || 0) + (perfil.plan_gratuito ? '' : ' / ' + (perfil.plan === 'estandar' ? '200' : perfil.plan === 'basico' ? '100' : '10')) + '</div>'+
        (perfil.plan_gratuito ? '' : '<div style="background:#22223a;border-radius:6px;height:6px;overflow:hidden;"><div style="background:#e8c87a;height:100%;width:' + Math.min(100, Math.round((perfil.facturas_mes || 0) / (perfil.plan === 'estandar' ? 200 : perfil.plan === 'basico' ? 100 : 10) * 100)) + '%;border-radius:6px;"></div></div>') +
        '<div style="font-size:12px;color:#6a6070;margin-top:10px;">Subidas extra disponibles: ' + (perfil.subidas_extra || 0) + '</div>'+
        '</div>'+
        '<div style="background:#16161e;border-radius:12px;padding:16px;margin-bottom:4px;"><div style="font-size:14px;color:#e8c87a;font-weight:600;margin-bottom:12px;">Invita y gana</div><div style="font-size:13px;color:#9a90b4;margin-bottom:12px;">Invita a un amigo o empresa. Cuando se suscriba, ganas <strong style="color:#e8c87a;">5€</strong>.</div><div style="font-size:11px;color:#6a6070;margin-bottom:6px;">Tu enlace de invitación:</div><div style="display:flex;gap:8px;margin-bottom:16px;"><div id="ref-enlace" style="flex:1;background:#22223a;border-radius:8px;padding:10px;font-size:11px;color:#9a90b4;word-break:break-all;"></div><button id="ref-copiar-btn" style="background:#22223a;border:none;color:#f0ede8;border-radius:6px;padding:8px 12px;font-size:11px;cursor:pointer;white-space:nowrap;">Copiar</button></div><div style="font-size:11px;color:#6a6070;margin-bottom:6px;">Enviar invitación por email:</div><div style="display:flex;gap:8px;margin-bottom:16px;"><input id="ref-email-input" type="email" placeholder="email@empresa.com" style="flex:1;background:#22223a;border:1px solid #2a2a3a;border-radius:8px;padding:10px;font-size:13px;color:#f0ede8;"/><button id="ref-enviar-btn" style="background:#e8c87a;border:none;color:#1a1500;border-radius:8px;padding:10px 14px;font-size:13px;font-weight:600;cursor:pointer;">Enviar</button></div><div style="display:flex;justify-content:space-between;align-items:center;"><div style="font-size:13px;color:#9a90b4;">Saldo acumulado: <strong id="ref-saldo" style="color:#e8c87a;">0€</strong></div><button id="ref-cobrar-btn" style="display:none;background:#22223a;border:1px solid #e8c87a;color:#e8c87a;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:600;cursor:pointer;">Solicitar pago</button></div></div>'+
        '<button onclick="cerrarAjustes();mostrarPlanes()" style="background:#1e1e28;border:1px solid #e8c87a;color:#e8c87a;border-radius:10px;padding:14px;font-size:15px;font-weight:600;cursor:pointer;width:100%;">Ver planes y precios</button>'+
        '<div style="margin-top:24px;padding-top:24px;border-top:1px solid #22223a;">'+
        '<button onclick="cerrarSesion()" style="background:#2a1a1a;border:1px solid #3a1a1a;color:#c06060;border-radius:10px;padding:14px;font-size:15px;font-weight:600;cursor:pointer;width:100%;">Cerrar sesión</button>'+
        '<div style="margin-top:16px;text-align:center;"><button onclick="solicitarBaja()" style="background:none;border:none;color:#5a5060;font-size:11px;cursor:pointer;text-decoration:underline;">Solicitar baja</button></div>'+
        '</div>'+
        '</div>'+
        '</div>';
      document.body.appendChild(div);
      ajustesTab(tab);
      cargarGestoriasAjustes();
      cargarReferidosAjustes();
    }

    async function cargarReferidosAjustes() {
      try {
        var res = await fetch(API + '/referidos/info', { headers: getHeaders() });
        var data = await res.json();
        var elEnlace = document.getElementById('ref-enlace');
        var elSaldo = document.getElementById('ref-saldo');
        var elCobrar = document.getElementById('ref-cobrar-btn');
        var elCopiar = document.getElementById('ref-copiar-btn');
        var elEnviar = document.getElementById('ref-enviar-btn');
        if (!elEnlace) return;
        elEnlace.textContent = data.enlace || '';
        elSaldo.textContent = (data.ref_saldo || 0) + '€';
        if ((data.ref_saldo || 0) >= 15) elCobrar.style.display = 'block';
        elCopiar.onclick = function() {
          navigator.clipboard.writeText(data.enlace || '');
          elCopiar.textContent = 'Copiado!';
          setTimeout(function() { elCopiar.textContent = 'Copiar'; }, 2000);
        };
        elEnviar.onclick = async function() {
          var email = document.getElementById('ref-email-input').value.trim();
          if (!email) return;
          elEnviar.disabled = true;
          elEnviar.textContent = '...';
          try {
            var r = await fetch(API + '/referidos/invitar', {
              method: 'POST',
              headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
              body: JSON.stringify({ emailDestino: email })
            });
            var d = await r.json();
            if (d.ok) {
              document.getElementById('ref-email-input').value = '';
              elEnviar.textContent = 'Enviado!';
              setTimeout(function() { elEnviar.textContent = 'Enviar'; elEnviar.disabled = false; }, 2000);
            } else {
              elEnviar.textContent = 'Error';
              setTimeout(function() { elEnviar.textContent = 'Enviar'; elEnviar.disabled = false; }, 2000);
            }
          } catch(e) { elEnviar.textContent = 'Enviar'; elEnviar.disabled = false; }
        };
        elCobrar.onclick = function() { mostrarFormularioPago(data.ref_saldo || 0); };
      } catch(e) { console.error('Error cargando referidos:', e); }
    }

    function mostrarFormularioPago(saldo) {
      var iban = prompt('Introduce tu IBAN para recibir ' + saldo + '€:');
      if (!iban) return;
      var dni = prompt('Introduce tu DNI o NIF:');
      if (!dni) return;
      fetch(API + '/referidos/solicitar-pago', {
        method: 'POST',
        headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
        body: JSON.stringify({ iban: iban, dni: dni })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) alert('Solicitud enviada. Te transferiremos ' + saldo + '€ en los proximos dias.');
        else alert(d.error || 'Error al solicitar pago');
      }).catch(function() { alert('Error de conexion'); });
    }

    async function solicitarBaja() {
      if (!confirm('¿Seguro que quieres solicitar la baja? Perderás todos tus datos. Esta acción no se puede deshacer.')) return;
      try {
        var res = await fetch(API + '/stripe/cancelar', { method: 'POST', headers: getHeaders() });
        var data = await res.json();
        if (data.ok) {
          alert('Solicitud de baja recibida. Nos pondremos en contacto contigo.');
          cerrarSesion();
        } else {
          alert('Error al procesar la solicitud. Contacta con soporte@trimgest.es');
        }
      } catch(e) {
        alert('Error de conexion');
      }
    }

    async function guardarPerfil() {
      var nombre = document.getElementById('ajNombre').value;
      var nif = document.getElementById('ajNif').value;
      var direccion = document.getElementById('ajDireccion').value;
      var msg = document.getElementById('ajMsg');
      try {
        var cp = document.getElementById('ajCp').value;
      var ciudad = document.getElementById('ajCiudad').value;
      var provincia = document.getElementById('ajProvincia').value;
      var telefono = document.getElementById('ajTelefono') ? document.getElementById('ajTelefono').value : '';
      var res = await fetch(API + '/usuarios/perfil', {
          method: 'PUT', headers: getHeaders(),
          body: JSON.stringify({ nombre_empresa: nombre, nif, direccion, cp, ciudad, provincia, telefono })
        });
        var data = await res.json();
        if (data.ok) {
          window.nombreEmpresa = nombre;
          localStorage.setItem('trimgest_empresa', nombre);
          msg.style.color = '#7ec47e';
          msg.textContent = 'Datos guardados correctamente';
          setTimeout(function() { msg.textContent = ''; }, 2000);
        }
      } catch(e) {
        msg.style.color = '#c06060';
        msg.textContent = 'Error al guardar';
      }
    }

    async function cargarGestoriasAjustes() {
      try {
        var r = await fetch(API + '/gestoria/solicitudes', { headers: getHeaders() });
        var d = await r.json();
        var listaEl = document.getElementById('ajGestoriasLista');
        var solEl = document.getElementById('ajSolicitudesLista');
        if (!listaEl) return;
        if (d.aprobadas && d.aprobadas.length) {
          listaEl.innerHTML = d.aprobadas.map(function(g) {
            var waBtn = g.telefono ? '<a href="https://wa.me/34' + g.telefono.replace(/\D/g,'') + '" target="_blank" style="display:flex;align-items:center;gap:8px;background:#25d366;color:#fff;border-radius:10px;padding:10px 16px;text-decoration:none;font-size:13px;font-weight:600;margin-top:12px;">' +
              '<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'18\' height=\'18\' viewBox=\'0 0 24 24\' fill=\'white\'><path d=\'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\'/></svg>' +
              'Contactar con tu gestoría' +
              '</a>' : '<div style="font-size:11px;color:#6a6070;margin-top:8px;">Tu gestoría aún no ha configurado su WhatsApp</div>';
            return '<div style="background:#0d2b1a;border:1px solid #1a4a2a;border-radius:12px;padding:16px;margin-bottom:8px;">' +
              '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
              '<div>' +
              '<div style="font-size:11px;color:#4caf7d;letter-spacing:2px;text-transform:uppercase;margin-bottom:4px;">Gestoría conectada</div>' +
              '<div style="font-size:15px;color:#e0d8cc;font-weight:600;">' + g.gestoriaNombre + '</div>' +
              '<div style="font-size:12px;color:#6a6070;">' + g.gestoriaEmail + '</div>' +
              '</div>' +
              '<button data-gid="' + g.gestoriaId + '" onclick="revocarGestoria(this.dataset.gid)" style="background:none;border:1px solid #3a1a1a;color:#c06060;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;">Revocar</button>' +
              '</div>' +
              waBtn +
              '</div>';
          }).join('');
        } else {
          listaEl.innerHTML = '<div style="font-size:12px;color:#6a6070;padding:8px 0;">Ninguna gestoria tiene acceso aun.</div>';
        }
        if (solEl) {
          var pendientes = (d.solicitudes || []).filter(function(s) { return s.estado === 'pendiente' || s.estado === 'invitacion_pendiente'; });
          if (pendientes.length) {
            solEl.innerHTML = pendientes.map(function(s) {
              return '<div style="background:#1e1e28;border:1px solid #2a2a3a;border-radius:8px;padding:10px 14px;display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">' +
                '<div><div style="font-size:13px;color:#e0d8cc;">' + s.gestoriaNombre + '</div><div style="font-size:11px;color:#6a6070;">' + s.gestoriaEmail + '</div></div>' +
                '<div style="display:flex;gap:6px;">' +
                '<button data-gid="' + s.gestoriaId + '" data-accion="aceptar" onclick="responderSolicitudGestoria(this.dataset.gid, this.dataset.accion)" style="background:#e8c87a;color:#1a1500;border:none;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;">Aceptar</button>' +
                '<button data-gid="' + s.gestoriaId + '" data-accion="rechazar" onclick="responderSolicitudGestoria(this.dataset.gid, this.dataset.accion)" style="background:#2a1a1a;border:1px solid #3a1a1a;color:#c06060;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;">Rechazar</button>' +
                '</div></div>';
            }).join('');
          } else {
            solEl.innerHTML = '<div style="font-size:12px;color:#6a6070;">Sin solicitudes pendientes.</div>';
          }
        }
      } catch(e) { console.error(e); }
    }

    async function invitarGestoria() {
      var email = document.getElementById('ajEmailGestoria').value.trim();
      var msg = document.getElementById('ajGestoriaMsg');
      if (!email) { msg.style.color = '#c06060'; msg.textContent = 'Introduce el email de la gestoria'; return; }
      try {
        var r = await fetch(API + '/gestoria/invitar', { method: 'POST', headers: getHeaders(), body: JSON.stringify({ emailGestoria: email }) });
        var d = await r.json();
        if (!d.ok) { msg.style.color = '#c06060'; msg.textContent = d.error || 'Error'; return; }
        msg.style.color = '#7ec47e'; msg.textContent = d.mensaje || 'Invitacion enviada';
        document.getElementById('ajEmailGestoria').value = '';
        setTimeout(function() { msg.textContent = ''; cargarGestoriasAjustes(); }, 2000);
      } catch(e) { msg.style.color = '#c06060'; msg.textContent = 'Error de conexion'; }
    }

    async function responderSolicitudGestoria(gestoriaId, accion) {
      try {
        var tok = window.token || localStorage.getItem('trimgest_token');
        var r = await fetch(API + '/gestoria/responder', { method: 'POST', headers: {'Content-Type':'application/json','Authorization':'Bearer '+tok}, body: JSON.stringify({ gestoriaId, accion }) });
        var d = await r.json();
        if (!d.ok) { alert(d.error || 'Error'); return; }
        cargarGestoriasAjustes();
      } catch(e) { alert('Error de conexion'); }
    }

    async function revocarGestoria(gestoriaId) {
      if (!confirm('Seguro que quieres revocar el acceso a esta gestoria?')) return;
      try {
        var tok = window.token || localStorage.getItem('trimgest_token');
        var r = await fetch(API + '/gestoria/revocar', { method: 'POST', headers: {'Content-Type':'application/json','Authorization':'Bearer '+tok}, body: JSON.stringify({ gestoriaId }) });
        var d = await r.json();
        cargarGestoriasAjustes();
      } catch(e) { alert('Error de conexion'); }
    }

    function cerrarAjustes() { var p = document.getElementById('ajustesPanel'); if (p) p.remove(); }
    function copiarEmail(tipo) {
      var id = tipo === 'facturas' ? 'emailFacturasInbound' : 'emailNominasInbound';
      var el = document.getElementById(id);
      if (!el) return;
      navigator.clipboard.writeText(el.innerText).then(function() {
        var btn = el.nextElementSibling;
        if (btn) { btn.innerText = '✓ Copiado'; setTimeout(function() { btn.innerText = 'Copiar'; }, 2000); }
      });
    }

    async function cargarFacturas() {
      var res = await fetch(API + '/facturas/listar', { headers: getHeaders() });
      var data = await res.json();
      var facturas = data.facturas || [];
      window.todasFacturas = facturas;
      return facturas;
    }

    var MESES_NOMBRE = { '1':'enero','2':'febrero','3':'marzo','4':'abril','5':'mayo','6':'junio','7':'julio','8':'agosto','9':'septiembre','10':'octubre','11':'noviembre','12':'diciembre','01':'enero','02':'febrero','03':'marzo','04':'abril','05':'mayo','06':'junio','07':'julio','08':'agosto','09':'septiembre','10':'octubre','11':'noviembre','12':'diciembre', 'enero':'enero','febrero':'febrero','marzo':'marzo','abril':'abril','mayo':'mayo','junio':'junio','julio':'julio','agosto':'agosto','septiembre':'septiembre','octubre':'octubre','noviembre':'noviembre','diciembre':'diciembre' };
    function mesNombre(mes) { return MESES_NOMBRE[String(mes).toLowerCase()] || String(mes); }
    function mesNumero(mes) { var n = {'enero':1,'febrero':2,'marzo':3,'abril':4,'mayo':5,'junio':6,'julio':7,'agosto':8,'septiembre':9,'octubre':10,'noviembre':11,'diciembre':12}; return n[String(mes).toLowerCase()] || Number(mes) || 0; }

    function iniciarReplazarPDF(id) {
      var input = document.getElementById('input-reemplazar-' + id);
      if (!input) return;
      input.onchange = async function() {
        var file = input.files[0];
        if (!file) return;
        var btn = document.getElementById('btn-reemplazar-' + id);
        btn.textContent = 'Procesando...';
        btn.disabled = true;
        var formData = new FormData();
        formData.append('factura', file);
        try {
          var r = await fetch(API + '/facturas/reemplazar-pdf/' + id, {
            method: 'POST',
            headers: { 'Authorization': 'Bearer ' + window.token },
            body: formData
          });
          var d = await r.json();
          if (!d.ok) { alert(d.error || 'Error'); btn.textContent = 'Reemplazar PDF'; btn.disabled = false; return; }
          var difs = d.diferencias || {};
          var hayDifs = Object.keys(difs).length > 0;
          if (hayDifs) {
            var msg = 'El nuevo PDF tiene datos diferentes:\n';
            if (difs.nombre) msg += '- Proveedor: "' + difs.nombre.anterior + '" → "' + difs.nombre.nuevo + '"\n';
            if (difs.total) msg += '- Total: ' + difs.total.anterior + '€ → ' + difs.total.nuevo + '€\n';
            if (difs.base_imponible) msg += '- Base: ' + difs.base_imponible.anterior + '€ → ' + difs.base_imponible.nuevo + '€\n';
            msg += '\n¿Quieres actualizar también los datos de la factura?';
            if (confirm(msg)) {
              var datos = d.datos_nuevos;
              await fetch(API + '/facturas/editar/' + id, {
                method: 'PUT',
                headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
                body: JSON.stringify({
                  nombre: datos.nombre || '',
                  cif: datos.cif || '',
                  numero_factura: datos.numero_factura || '',
                  fecha: datos.fecha || '',
                  base_imponible: datos.base_imponible || 0,
                  iva_porcentaje: datos.iva_porcentaje || 0,
                  iva_importe: datos.iva_importe || 0,
                  total: datos.total || 0
                })
              });
            }
          }
          renderApp();
        } catch(e) { alert('Error de conexion'); btn.textContent = 'Reemplazar PDF'; btn.disabled = false; }
      };
      input.click();
    }

    async function renderBanco() {
      window.seccionActual = 'banco';
      if (!window.bancoTrim) window.bancoTrim = getTrimestre();
      if (!window.bancoAnno) window.bancoAnno = new Date().getFullYear();
      try {
        var _bt = localStorage.getItem('trimgest_token');
        if (_bt) {
          var _bp = JSON.parse(atob(_bt.split('.')[1]));
          if (_bp.empresaId === 'emp_demo_construcciones') {
            window.bancoAnno = 2025;
            window.bancoTrim = 'T1';
          }
        }
      } catch(e) {}

      var trims = ['Año completo','T1','T2','T3','T4'];
      var annos = [];
      for (var y = new Date().getFullYear(); y >= 2024; y--) annos.push(y);

      var html = '<div class="header"><div class="header-top"><div><div class="label">TrimGest</div><h1>Banco</h1></div></div>';
      html += '<div class="selectores">';
      html += '<select id="bancoTrimSel" onchange="window.bancoTrim=this.value;renderBanco()">';
      trims.forEach(function(t) { html += '<option value="' + t + '"' + (t === window.bancoTrim ? ' selected' : '') + '>' + t + '</option>'; });
      html += '</select>';
      html += '<select id="bancoAnnoSel" onchange="window.bancoAnno=parseInt(this.value);renderBanco()">';
      annos.forEach(function(y) { html += '<option value="' + y + '"' + (y === window.bancoAnno ? ' selected' : '') + '>' + y + '</option>'; });
      html += '</select></div></div>';
      html += '<div class="content" style="padding:16px;padding-bottom:80px;">';

      try {
        var r = await fetch(API + '/banco/movimientos', { headers: getHeaders() });
        var data = await r.json();
        var todosMovs = data.movimientos || [];
        window.bancoMovs = todosMovs;
        var ultimaFecha = data.ultima_fecha;

        var mesesTrim = { T1: [0,1,2], T2: [3,4,5], T3: [6,7,8], T4: [9,10,11] };
        var meses = mesesTrim[window.bancoTrim] || [];
        var movs = todosMovs.filter(function(m) {
          var d = new Date(m.fecha);
          if (window.bancoTrim === 'Año completo') return d.getFullYear() === window.bancoAnno;
          return meses.includes(d.getMonth()) && d.getFullYear() === window.bancoAnno;
        });

        var conciliados = movs.filter(function(m) { return m.estado === 'conciliado'; }).length;
        var sinFactura = movs.filter(function(m) { return m.estado === 'sin_factura'; }).length;
        var pendientes = movs.filter(function(m) { return !m.estado || m.estado === 'pendiente'; }).length;

        html += '<div style="background:#16161e;border-radius:12px;padding:16px;margin-bottom:16px;">';
        if (ultimaFecha) html += '<div style="font-size:12px;color:#9a90b4;margin-bottom:12px;">Conciliado hasta el <strong style="color:#e8c87a;">' + ultimaFecha + '</strong></div>';
        html += '<div style="display:flex;gap:8px;margin-bottom:16px;">';
        html += '<div style="flex:1;text-align:center;background:#0d2b1a;border-radius:8px;padding:10px;"><div style="font-size:20px;font-weight:700;color:#4caf7d;">' + conciliados + '</div><div style="font-size:10px;color:#6a6070;">Con factura</div></div>';
        html += '<div style="flex:1;text-align:center;background:#1e1e28;border-radius:8px;padding:10px;"><div style="font-size:20px;font-weight:700;color:#9a90b4;">' + sinFactura + '</div><div style="font-size:10px;color:#6a6070;">Sin factura OK</div></div>';
        html += '<div style="flex:1;text-align:center;background:#2a2010;border-radius:8px;padding:10px;"><div style="font-size:20px;font-weight:700;color:#e8c87a;">' + pendientes + '</div><div style="font-size:10px;color:#6a6070;">Pendientes</div></div>';
        html += '</div>';
        html += '<label style="display:block;background:#e8c87a;color:#1a1500;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;text-align:center;width:100%;box-sizing:border-box;">Subir extracto CSV<input type="file" id="inputBanco" accept=".csv" style="display:none"></label>';
        html += '<div id="bancoBusyMsg" style="margin-top:8px;font-size:12px;color:#9a90b4;text-align:center;"></div>';
        if (todosMovs.length > 0) {
          html += '<button onclick="reconciliarBanco()" style="margin-top:8px;background:#1a2a1a;border:1px solid #2a4a2a;color:#7ec47e;border-radius:8px;padding:8px;font-size:12px;font-weight:600;cursor:pointer;width:100%;">Re-conciliar automaticamente</button>';
          html += '<button onclick="resetearBanco()" style="margin-top:6px;background:none;border:none;color:#5a5060;font-size:11px;cursor:pointer;text-decoration:underline;width:100%;">Resetear historial bancario</button>';
        }
        html += '</div>';

        if (movs.length > 0) {


          html += '<input id="bancoBuscador" type="text" placeholder="Buscar movimiento..." oninput="filtrarBanco(this.value)" style="width:100%;box-sizing:border-box;background:#1e1e28;border:1px solid #2a2a3a;border-radius:10px;padding:10px 14px;font-size:14px;color:#e0d8cc;margin-bottom:12px;outline:none;">';
          html += '<div style="display:flex;flex-direction:column;gap:6px;" id="banco-lista">';
          var movsOrdenados = movs.slice().sort(function(a,b) {
          var pa = (!a.estado || a.estado === 'pendiente') ? 0 : 1;
          var pb = (!b.estado || b.estado === 'pendiente') ? 0 : 1;
          if (pa !== pb) return pa - pb;
          return new Date(b.fecha) - new Date(a.fecha);
        });
          movsOrdenados.forEach(function(m) {
            var estado = m.estado || 'pendiente';
            var colorImp = m.importe >= 0 ? '#4caf7d' : '#f0ede8';
            var badge = '';
            if (estado === 'conciliado') badge = '<span style="background:#0d2b1a;border:1px solid #1a4a2a;color:#4caf7d;border-radius:6px;padding:3px 8px;font-size:10px;">Con factura: ' + (m.factura_nombre || '') + '</span>';
            else if (estado === 'sin_factura') badge = '<span style="background:#1e1e28;border:1px solid #3a3a4a;color:#9a90b4;border-radius:6px;padding:3px 8px;font-size:10px;">Sin factura: ' + (m.motivo || '') + '</span>';
            else badge = '<span style="background:#2a2010;border:1px solid #3a3010;color:#e8c87a;border-radius:6px;padding:3px 8px;font-size:10px;">Pendiente</span>';

            html += '<div class="banco-mov" data-id="' + m.id + '" style="background:#16161e;border-radius:10px;padding:12px 14px;border:1px solid #22223a;">';
            html += '<div style="display:flex;align-items:flex-start;gap:10px;">';
            
            html += '<div style="flex:1;">';
            html += '<div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:4px;">';
            html += '<div style="font-size:13px;color:#e0d8cc;font-weight:600;">' + m.concepto + '</div>';
            html += '<div style="font-size:14px;font-weight:700;color:' + colorImp + ';white-space:nowrap;margin-left:8px;">' + (m.importe >= 0 ? '+' : '') + formatEur(m.importe) + '</div>';
            html += '</div>';
            html += '<div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:4px;margin-bottom:6px;">';
            html += '<div style="font-size:11px;color:#6a6070;">' + m.fecha_display + '</div>';
            html += badge;
            html += '</div>';
            if (estado === 'pendiente') {
              html += '<div style="display:flex;gap:6px;">';
              html += '<div style="display:flex;gap:6px;">';
              html += '<button class="btn-asignar" data-id="' + m.id + '" style="flex:2;background:#1a2a1a;border:1px solid #2a4a2a;color:#7ec47e;border-radius:6px;padding:8px;font-size:12px;font-weight:600;cursor:pointer;">+ Asignar</button>';
              html += '<button class="btn-agrupar" data-id="' + m.id + '" style="flex:1;background:#1a1a2a;border:1px solid #3a3a5a;color:#9a90b4;border-radius:6px;padding:8px;font-size:12px;cursor:pointer;">Agrupar</button>';
              html += '</div>';
              html += '</div>';
            } else {
              html += '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">';
              if (m.asignaciones && m.asignaciones.length > 0) {
                var totalAsig = m.asignaciones.reduce(function(s,a){return s+a.importe;},0);
                var dispRest = Math.abs(m.importe) - totalAsig;
                html += '<button class="btn-ver-asignaciones" data-id="' + m.id + '" style="background:#0d1a2b;border:1px solid #1a3a4a;color:#4c8faf;border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;">📋 Ver asignaciones (' + m.asignaciones.length + ')</button>';
                if (dispRest > 0.01) {
                  html += '<button class="btn-asignar" data-id="' + m.id + '" style="background:#1a2a1a;border:1px solid #2a4a2a;color:#7ec47e;border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;">+ Asignar resto (' + formatEur(dispRest) + ')</button>';
                }
              } else {
                html += '<button class="btn-deshacer" data-id="' + m.id + '" style="background:none;border:none;color:#5a5060;font-size:10px;cursor:pointer;text-decoration:underline;">Deshacer</button>';
              }
              html += '</div>';
            }
            html += '</div></div></div>';
          });
          html += '</div>';
        } else if (todosMovs.length > 0) {
          html += '<div style="text-align:center;color:#6a6070;padding:40px 20px;font-size:14px;">Sin movimientos en ' + window.bancoTrim + ' ' + window.bancoAnno + '</div>';
        } else {
          html += '<div style="text-align:center;color:#6a6070;padding:40px 20px;font-size:14px;">Sube el extracto CSV de tu banco para empezar</div>';
        }

      } catch(e) {
        html += '<div style="color:#c06060;padding:20px;">Error cargando movimientos</div>';
      }

      html += '</div>';
      document.getElementById('app').innerHTML = html;

      var inputBanco = document.getElementById('inputBanco');
      if (inputBanco) {
        inputBanco.onchange = async function() {
          var file = inputBanco.files[0];
          if (!file) return;
          var msg = document.getElementById('bancoBusyMsg');
          msg.textContent = 'Procesando extracto...';
          var formData = new FormData();
          formData.append('extracto', file);
          try {
            var r = await fetch(API + '/banco/subir', { method: 'POST', headers: { 'Authorization': 'Bearer ' + window.token }, body: formData });
            var d = await r.json();
            if (d.ok) { msg.textContent = d.nuevos + ' movimientos nuevos — ' + d.conciliados + ' conciliados'; setTimeout(function() { renderBanco(); }, 1500); }
            else msg.textContent = d.error || 'Error';
          } catch(e) { msg.textContent = 'Error de conexion'; }
        };
      }

      window.bancoSeleccion = [];

      document.querySelectorAll('.btn-agrupar').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = parseInt(this.dataset.id);
          var self = this;
          if (window.bancoSeleccion.includes(id)) {
            window.bancoSeleccion = window.bancoSeleccion.filter(function(x) { return x !== id; });
            self.style.background = '#1a1a2a';
            self.style.color = '#9a90b4';
            self.style.borderColor = '#3a3a5a';
            self.textContent = 'Agrupar';
          } else {
            window.bancoSeleccion.push(id);
            self.style.background = '#2a2a1a';
            self.style.color = '#e8c87a';
            self.style.borderColor = '#e8c87a';
            self.textContent = 'Agrup. (' + window.bancoSeleccion.length + ')';
            if (window.bancoSeleccion.length >= 2) {
              var idsAgrupados = window.bancoSeleccion.slice();
              window.bancoSeleccion = [];
              var opciones = [
                { titulo: '📄 Factura de proveedor' },
                { titulo: '🧾 Factura de cliente' },
                { titulo: '👤 Nomina trabajador' },
                { titulo: '⊘  Sin factura (TGSS, banco, personal...)' }
              ];
              mostrarModalBanco('¿Qué es este movimiento?', opciones, function(idx) {
                if (idx === 0) mostrarSelectorFacturaBanco(idsAgrupados);
                else if (idx === 1) mostrarSelectorFacturaClienteBanco(idsAgrupados);
                else if (idx === 2) { if (idsAgrupados.length > 0) asignarNominaBanco(idsAgrupados[0]); }
                else if (idx === 3) { idsAgrupados.forEach(function(aid) { marcarSinFactura(aid); }); }
              });
            }
          }
        });
      });

      document.querySelectorAll('.btn-asignar').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var id = parseInt(this.dataset.id);
          var opciones = [
            { titulo: '📄 Factura de proveedor' },
            { titulo: '🧾 Factura de cliente' },
            { titulo: '👤 Nomina trabajador' },
            { titulo: '⊘  Sin factura (TGSS, banco, personal...)' }
          ];
          mostrarModalBanco('¿Qué es este movimiento?', opciones, function(idx) {
            if (idx === 0) mostrarSelectorFacturaBanco([id]);
            else if (idx === 1) mostrarSelectorFacturaClienteBanco([id]);
            else if (idx === 2) asignarNominaBanco(id);
            else if (idx === 3) marcarSinFactura(id);
          });
        });
      });
      document.querySelectorAll('.btn-deshacer').forEach(function(btn) {
        btn.addEventListener('click', function() { deshacerConciliacion(parseInt(this.dataset.id)); });
      });
      document.querySelectorAll('.btn-ver-asignaciones').forEach(function(btn) {
        btn.addEventListener('click', function() { verAsignaciones(parseInt(this.dataset.id)); });
      });
    }

    function filtrarBanco(texto) {
      var t = texto.toLowerCase().trim();
      document.querySelectorAll('.banco-mov').forEach(function(el) {
        var contenido = el.textContent.toLowerCase();
        el.style.display = (!t || contenido.includes(t)) ? '' : 'none';
      });
    }

    function cancelarSeleccion() {
      window.bancoSeleccion = [];
      document.querySelectorAll('.banco-check').forEach(function(c) { c.checked = false; });
      var bar = document.getElementById('banco-seleccion-bar');
      if (bar) bar.style.display = 'none';
    }

    async function mostrarSelectorFacturaBanco(ids) {
      if (!ids || ids.length === 0) return;
      var movId = ids[0];
      var mov = (window.bancoMovs || []).find(function(m) { return m.id === movId; });
      var importeMov = mov ? Math.abs(mov.importe) : 0;
      var yaAsignadoMov = mov && mov.asignaciones ? mov.asignaciones.reduce(function(s,a){return s+a.importe;},0) : 0;
      var disponibleMov = importeMov - yaAsignadoMov;
      var saldosR = await fetch(API + '/banco/saldos', { headers: getHeaders() });
      var saldosData = await saldosR.json();
      var saldos = saldosData.saldos || {};
      var r = await fetch(API + '/facturas/listar', { headers: getHeaders() });
      var data = await r.json();
      var facturas = (data.facturas || []).filter(function(f) {
        return f.tipo === 'proveedor' && (saldos[f.id] ? saldos[f.id].pendiente > 0.01 : Math.abs(f.total) > 0.01);
      });
      if (facturas.length === 0) { alert('No tienes facturas de proveedor pendientes de pago'); return; }
      mostrarModalAsignarImporte(ids, facturas, saldos, disponibleMov, 'proveedor');
    }


    async function verAsignaciones(movId) {
      var mov = (window.bancoMovs || []).find(function(m) { return m.id === movId; });
      if (!mov) return;
      var asignaciones = mov.asignaciones || [];
      var existing = document.getElementById('banco-modal');
      if (existing) existing.remove();
      var isMobile = window.innerWidth <= 600;
      var overlay = document.createElement('div');
      overlay.id = 'banco-modal';
      overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;' + (isMobile ? 'align-items:flex-end;justify-content:center;' : 'align-items:center;justify-content:center;');
      var modal = document.createElement('div');
      modal.style.cssText = isMobile ? 'background:#1e1e28;border-radius:16px 16px 0 0;width:100%;max-width:600px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;' : 'background:#1e1e28;border-radius:16px;width:440px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.5);';
      var totalAsig = asignaciones.reduce(function(s,a){return s+a.importe;},0);
      var dispRest = Math.abs(mov.importe) - totalAsig;
      var html = '<div style="padding:16px 20px;border-bottom:1px solid #2a2a3a;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">';
      html += '<div><div style="font-size:15px;font-weight:600;color:#f0ede8;">Asignaciones</div>';
      html += '<div style="font-size:12px;color:#9a90b4;margin-top:2px;">' + mov.concepto + ' · ' + (mov.importe >= 0 ? '+' : '') + formatEur(mov.importe) + '</div></div>';
      html += '<button id="banco-modal-close" style="background:none;border:none;color:#9a90b4;font-size:22px;cursor:pointer;">×</button></div>';
      html += '<div style="overflow-y:auto;flex:1;min-height:0;">';
      if (asignaciones.length === 0) {
        html += '<div style="padding:30px;text-align:center;color:#6a6070;">Sin asignaciones</div>';
      } else {
        asignaciones.forEach(function(a, i) {
          html += '<div style="padding:14px 20px;border-bottom:1px solid #22223a;display:flex;justify-content:space-between;align-items:center;">';
          html += '<div><div style="font-size:13px;color:#e0d8cc;font-weight:500;">' + (a.factura_nombre || '-') + '</div>';
          html += '<div style="font-size:11px;color:#6a6070;margin-top:2px;">Total factura: ' + formatEur(a.factura_total) + '</div></div>';
          html += '<div style="display:flex;align-items:center;gap:10px;">';
          html += '<div style="font-size:14px;font-weight:700;color:#e8c87a;">' + formatEur(a.importe) + '</div>';
          html += '<button class="btn-borrar-asig" data-idx="' + i + '" style="background:#2b0d0d;border:1px solid #4a1a1a;color:#e05555;border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer;">Borrar</button>';
          html += '</div></div>';
        });
      }
      if (dispRest > 0.01) {
        html += '<div style="padding:12px 20px;background:#0d1a0d;border-top:1px solid #1a3a1a;">';
        html += '<div style="font-size:12px;color:#4caf7d;">Disponible sin asignar: <strong>' + formatEur(dispRest) + '</strong></div></div>';
      }
      html += '</div>';
      html += '<div style="padding:12px 20px;border-top:1px solid #2a2a3a;flex-shrink:0;">';
      html += '<button id="banco-modal-cancel" style="width:100%;background:#2a2a3a;border:none;color:#9a90b4;border-radius:10px;padding:12px;font-size:14px;cursor:pointer;">Cerrar</button></div>';
      modal.innerHTML = html;
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      document.getElementById('banco-modal-close').onclick = function() { overlay.remove(); document.body.style.overflow = ''; };
      document.getElementById('banco-modal-cancel').onclick = function() { overlay.remove(); document.body.style.overflow = ''; };
      overlay.onclick = function(e) { if (e.target === overlay) { overlay.remove(); document.body.style.overflow = ''; } };
      modal.onclick = function(e) { e.stopPropagation(); };
      modal.querySelectorAll('.btn-borrar-asig').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var idx = parseInt(this.dataset.idx);
          var r = await fetch(API + '/banco/borrar-asignacion', {
            method: 'POST',
            headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
            body: JSON.stringify({ movimiento_id: movId, asignacion_idx: idx })
          });
          var d = await r.json();
          if (!d.ok) { alert(d.error || 'Error'); return; }
          overlay.remove();
          document.body.style.overflow = '';
          renderBanco();
        });
      });
    }

    function mostrarModalAsignarImporte(ids, facturas, saldos, disponibleMov, tipo) {
      var existing = document.getElementById('banco-modal');
      if (existing) existing.remove();
      var isMobile = window.innerWidth <= 600;
      var overlay = document.createElement('div');
      overlay.id = 'banco-modal';
      overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;' + (isMobile ? 'align-items:flex-end;justify-content:center;' : 'align-items:center;justify-content:center;');
      var modal = document.createElement('div');
      modal.style.cssText = isMobile ? 'background:#1e1e28;border-radius:16px 16px 0 0;width:100%;max-width:600px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;' : 'background:#1e1e28;border-radius:16px;width:460px;max-height:85vh;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.5);';
      var titulo = tipo === 'cliente' ? 'Asignar cobro a factura' : 'Asignar pago a factura';
      var html = '<div style="padding:16px 20px;border-bottom:1px solid #2a2a3a;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">';
      html += '<div><div style="font-size:15px;font-weight:600;color:#f0ede8;">' + titulo + '</div>';
      html += '<div style="font-size:12px;color:#9a90b4;margin-top:2px;">Disponible: <strong style="color:#e8c87a;">' + formatEur(disponibleMov) + '</strong></div></div>';
      html += '<button id="banco-modal-close" style="background:none;border:none;color:#9a90b4;font-size:22px;cursor:pointer;">×</button></div>';
      html += '<div id="banco-modal-scroll" style="overflow-y:auto;flex:1;min-height:0;">';
      facturas.forEach(function(f, i) {
        var saldo = saldos[f.id] || { pagado: 0, pendiente: Math.abs(f.total), total: Math.abs(f.total) };
        var pct = saldo.total > 0 ? Math.round((saldo.pagado / saldo.total) * 100) : 0;
        var importeSugerido = Math.min(disponibleMov, saldo.pendiente).toFixed(2);
        html += '<div style="padding:14px 20px;border-bottom:1px solid #22223a;">';
        html += '<div style="font-size:13px;font-weight:600;color:#e0d8cc;">' + (f.nombre || f.cliente || '-') + '</div>';
        html += '<div style="font-size:11px;color:#6a6070;margin:2px 0;">' + (f.fecha || '') + (f.numero_factura ? ' · N ' + f.numero_factura : '') + '</div>';
        html += '<div style="display:flex;gap:12px;font-size:12px;margin:6px 0;">';
        html += '<span style="color:#6a6070;">Total: <strong style="color:#e0d8cc;">' + formatEur(f.total) + '</strong></span>';
        html += '<span style="color:#6a6070;">Pagado: <strong style="color:#4caf7d;">' + formatEur(saldo.pagado) + '</strong></span>';
        html += '<span style="color:#6a6070;">Pendiente: <strong style="color:#e8c87a;">' + formatEur(saldo.pendiente) + '</strong></span></div>';
        html += '<div style="background:#2a2a3a;border-radius:4px;height:4px;margin-bottom:8px;"><div style="background:#4caf7d;height:4px;border-radius:4px;width:' + pct + '%;"></div></div>';
        html += '<div style="display:flex;gap:8px;align-items:center;">';
        html += '<input type="number" id="imp-' + i + '" value="' + importeSugerido + '" min="0.01" max="' + disponibleMov + '" step="0.01" style="background:#16161e;border:1px solid #3a3a5a;color:#e0d8cc;border-radius:8px;padding:8px 10px;font-size:14px;width:120px;">';
        html += '<button data-idx="' + i + '" class="btn-asignar-fact" style="background:#e8c87a;border:none;color:#1a1500;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:600;cursor:pointer;flex:1;">Asignar</button></div>';
        html += '</div>';
      });
      html += '</div>';
      html += '<div style="padding:12px 20px;border-top:1px solid #2a2a3a;flex-shrink:0;">';
      html += '<button id="banco-modal-cancel" style="width:100%;background:#2a2a3a;border:none;color:#9a90b4;border-radius:10px;padding:12px;font-size:14px;cursor:pointer;">Cancelar</button></div>';
      modal.innerHTML = html;
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      document.getElementById('banco-modal-close').onclick = function() { overlay.remove(); document.body.style.overflow = ''; };
      document.getElementById('banco-modal-cancel').onclick = function() { overlay.remove(); document.body.style.overflow = ''; };
      overlay.onclick = function(e) { if (e.target === overlay) { overlay.remove(); document.body.style.overflow = ''; } };
      modal.onclick = function(e) { e.stopPropagation(); };
      modal.querySelectorAll('.btn-asignar-fact').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var idx = parseInt(this.dataset.idx);
          var factura = facturas[idx];
          var impInput = document.getElementById('imp-' + idx);
          var importe = parseFloat(impInput.value);
          if (!importe || importe <= 0) { alert('Introduce un importe válido'); return; }
          if (importe > disponibleMov + 0.01) { alert('El importe supera el disponible del movimiento'); return; }
          var r = await fetch(API + '/banco/asignar', {
            method: 'POST',
            headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
            body: JSON.stringify({ movimiento_id: ids[0], factura_id: factura.id, importe: importe })
          });
          var d = await r.json();
          if (!d.ok) { alert(d.error || 'Error al asignar'); return; }
          overlay.remove();
          document.body.style.overflow = '';
          window.bancoSeleccion = [];
          renderBanco();
        });
      });
    }

    function mostrarModalBanco(titulo, items, onSelect) {
      var existing = document.getElementById('banco-modal');
      if (existing) existing.remove();
      
      var isMobile = window.innerWidth <= 600;
      
      var overlay = document.createElement('div');
      overlay.id = 'banco-modal';
      overlay.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;' + (isMobile ? 'align-items:flex-end;justify-content:center;' : 'align-items:center;justify-content:center;');
      
      var modal = document.createElement('div');
      if (isMobile) {
        modal.style.cssText = 'background:#1e1e28;border-radius:16px 16px 0 0;width:100%;max-width:600px;max-height:80vh;display:flex;flex-direction:column;overflow:hidden;';
      } else {
        modal.style.cssText = 'background:#1e1e28;border-radius:16px;width:400px;height:500px;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.5);';
      }
      
      var html = '<div style="padding:16px 20px;border-bottom:1px solid #2a2a3a;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">';
      html += '<div style="font-size:15px;font-weight:600;color:#f0ede8;">' + titulo + '</div>';
      html += '<button id="banco-modal-close" style="background:none;border:none;color:#9a90b4;font-size:22px;cursor:pointer;line-height:1;padding:0 4px;">×</button>';
      html += '</div>';
      html += '<div id="banco-modal-scroll" tabindex="0" style="overflow-y:scroll;flex:1;-webkit-overflow-scrolling:touch;min-height:0;scrollbar-width:thin;scrollbar-color:#3a3a5a #1e1e28;outline:none;">';
      items.forEach(function(item, i) {
        html += '<div class="banco-modal-item" data-idx="' + i + '" style="padding:16px 20px;border-bottom:1px solid #22223a;cursor:pointer;transition:background 0.1s;">';
        html += '<div style="font-size:14px;color:#e0d8cc;font-weight:500;">' + item.titulo + '</div>';
        if (item.subtitulo) html += '<div style="font-size:11px;color:#6a6070;margin-top:3px;">' + item.subtitulo + '</div>';
        html += '</div>';
      });
      html += '</div>';
      html += '<div style="padding:12px 20px;border-top:1px solid #2a2a3a;flex-shrink:0;">';
      html += '<button id="banco-modal-cancel" style="width:100%;background:#2a2a3a;border:none;color:#9a90b4;border-radius:10px;padding:12px;font-size:14px;cursor:pointer;">Cancelar</button>';
      html += '</div>';
      
      modal.innerHTML = html;
      overlay.appendChild(modal);
      document.body.appendChild(overlay);
      document.body.style.overflow = 'hidden';
      var scrollEl = document.getElementById('banco-modal-scroll');
      if (scrollEl) { scrollEl.focus(); }
      
      document.getElementById('banco-modal-close').onclick = function() { overlay.remove(); document.body.style.overflow = ''; };
      document.getElementById('banco-modal-cancel').onclick = function() { overlay.remove(); document.body.style.overflow = ''; };
      overlay.onclick = function(e) { if (e.target === overlay) { overlay.remove(); document.body.style.overflow = ''; } };
      
      modal.onclick = function(e) { e.stopPropagation(); };
      
      document.querySelectorAll('.banco-modal-item').forEach(function(el) {
        el.addEventListener('click', function() {
          overlay.remove();
          document.body.style.overflow = '';
          onSelect(parseInt(this.dataset.idx));
        });
        el.addEventListener('mouseover', function() { this.style.background = '#2a2a3a'; });
        el.addEventListener('mouseout', function() { this.style.background = ''; });
      });
    }

    async function mostrarSelectorFacturaClienteBanco(ids) {
      if (!ids || ids.length === 0) return;
      var movId = ids[0];
      var mov = (window.bancoMovs || []).find(function(m) { return m.id === movId; });
      var importeMov = mov ? Math.abs(mov.importe) : 0;
      var yaAsignadoMov = mov && mov.asignaciones ? mov.asignaciones.reduce(function(s,a){return s+a.importe;},0) : 0;
      var disponibleMov = importeMov - yaAsignadoMov;
      var saldosR = await fetch(API + '/banco/saldos', { headers: getHeaders() });
      var saldosData = await saldosR.json();
      var saldos = saldosData.saldos || {};
      var r = await fetch(API + '/facturas/listar', { headers: getHeaders() });
      var data = await r.json();
      var facturas = (data.facturas || []).filter(function(f) {
        return f.tipo === 'cliente' && (saldos[f.id] ? saldos[f.id].pendiente > 0.01 : Math.abs(f.total) > 0.01);
      });
      if (facturas.length === 0) { alert('No tienes facturas de cliente pendientes de cobro'); return; }
      mostrarModalAsignarImporte(ids, facturas, saldos, disponibleMov, 'cliente');
    }

    async function asignarNominaBanco(id) {
      var r = await fetch(API + '/nominas/listar', { headers: getHeaders() });
      var data = await r.json();
      var nominas = data.nominas || [];
      nominas = nominas.filter(function(n) {
        var pagado = (window.bancoMovs || []).filter(function(m) { return m.nomina_id === n.id; }).reduce(function(acc, m) { return acc + Math.abs(m.importe || 0); }, 0);
        return pagado < (n.neto || 0);
      });
      if (nominas.length === 0) { alert('No tienes nominas pendientes de asignar'); return; }
      var mesesNombres = {'01':'Enero','02':'Febrero','03':'Marzo','04':'Abril','05':'Mayo','06':'Junio','07':'Julio','08':'Agosto','09':'Septiembre','10':'Octubre','11':'Noviembre','12':'Diciembre'};
      var items = nominas.map(function(n) { var mesStr = mesesNombres[n.mes] || n.mes || ''; return { titulo: n.trabajador + ' — ' + formatEur(n.neto), subtitulo: mesStr + ' ' + (n.anno||'') }; });
      mostrarModalBanco('Selecciona la nomina', items, async function(idx) {
        var nomina = nominas[idx];
        await fetch(API + '/banco/actualizar-movimiento', {
          method: 'POST',
          headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
          body: JSON.stringify({ movimiento_id: id, estado: 'conciliado', factura_id: null, nomina_id: nomina.id, factura_nombre: 'Nomina: ' + nomina.trabajador + ' ' + (mesesNombres[nomina.mes] || nomina.mes || '') + ' ' + (nomina.anno||''), factura_total: nomina.neto })
        });
        renderBanco();
      });
    }

    async function marcarSinFactura(id) {
      var motivos = ['TGSS / Seguridad Social', 'Comision bancaria', 'Gasto personal', 'Transferencia interna', 'Otro'];
      var items = motivos.map(function(m) { return { titulo: m }; });
      mostrarModalBanco('Sin factura — motivo', items, async function(idx) {
        var motivo = motivos[idx];
        if (motivo === 'Otro') {
          var custom = prompt('Escribe el motivo:');
          if (!custom || !custom.trim()) return;
          motivo = custom.trim();
        }
        await fetch(API + '/banco/actualizar-movimiento', {
          method: 'POST',
          headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
          body: JSON.stringify({ movimiento_id: id, estado: 'sin_factura', motivo: motivo })
        });
        renderBanco();
      });
    }

    async function deshacerConciliacion(id) {
      await fetch(API + '/banco/actualizar-movimiento', {
        method: 'POST',
        headers: Object.assign(getHeaders(), { 'Content-Type': 'application/json' }),
        body: JSON.stringify({ movimiento_id: id, estado: 'pendiente', factura_id: null, factura_nombre: null, motivo: null })
      });
      renderBanco();
    }

    async function reconciliarBanco() {
      var msg = document.getElementById('bancoBusyMsg');
      if (msg) msg.textContent = 'Re-conciliando...';
      try {
        var r = await fetch(API + '/banco/reconciliar', { method: 'POST', headers: getHeaders() });
        var d = await r.json();
        if (d.ok) {
          if (msg) msg.textContent = d.actualizados + ' movimientos conciliados nuevos';
          setTimeout(function() { renderBanco(); }, 1000);
        } else {
          if (msg) msg.textContent = d.error || 'Error';
        }
      } catch(e) { if (msg) msg.textContent = 'Error de conexion'; }
    }

    async function resetearBanco() {
      if (!confirm('Seguro que quieres borrar todo el historial bancario?')) return;
      await fetch(API + '/banco/resetear', { method: 'POST', headers: getHeaders() });
      renderBanco();
    }


    async function renderApp() {
      var facturas = await cargarFacturas();
      // Cargar movimientos banco en segundo plano para badges conciliado
      fetch(API + '/banco/movimientos', { headers: getHeaders() }).then(function(r){ return r.json(); }).then(function(d){ window.bancoMovs = d.movimientos || []; }).catch(function(){});
      var nominasRes = await fetch(API + '/nominas/listar', { headers: getHeaders() });
      var nominasData = await nominasRes.json();
      var todasNominas = nominasData.nominas || [];
      var perfilRes = await fetch(API + '/usuarios/perfil', { headers: getHeaders() });
      var perfil = await perfilRes.json();
      try {
        var gRes = await fetch(API + '/gestoria/solicitudes', { headers: getHeaders() });
        var gData = await gRes.json();
        if (gData.aprobadas && gData.aprobadas.length) { window.estadoGestoria = 'conectada'; window.nombreGestoria = gData.aprobadas[0].gestoriaNombre; }
        else if (gData.solicitudes && gData.solicitudes.filter(function(s){return s.estado==='pendiente'||s.estado==='invitacion_pendiente';}).length) { window.estadoGestoria = 'pendiente'; }
        else { window.estadoGestoria = 'sin_gestoria'; }
      } catch(e) { window.estadoGestoria = 'sin_gestoria'; }
      window.empresaId = perfil.empresaId || '';
      window.perfilOnboarding = perfil;
      if (!window.onboardingMostrado) { window.onboardingMostrado = true; mostrarOnboarding(); }
      var bannerHTML = '';
      var refBannerHTML = '<div onclick="mostrarAjustes(\'plan\')" style="background:#1e1a0a;border-bottom:1px solid #3a3010;padding:8px 20px;display:flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;"><span style="font-size:13px;">&#127873;</span><span style="font-size:12px;color:#e8c87a;font-weight:600;">Invita a un amigo y gana 5&euro; por cada suscripci&oacute;n</span><span style="font-size:11px;color:#9a7a30;">Ver c&oacute;mo &rarr;</span></div>';
      if (!perfil.plan_gratuito) {
        var limite = perfil.plan === 'estandar' ? 200 : perfil.plan === 'basico' ? 100 : 10;
        var usadas = perfil.facturas_mes || 0;
        var pct = Math.round(usadas / limite * 100);
        if (perfil.plan === 'free') {
          bannerHTML = '<div style="background:#1a1a2a;border:1px solid #2a2a5a;border-radius:10px;padding:12px 16px;margin:8px 16px;display:flex;justify-content:space-between;align-items:center;">' +
            '<span style="font-size:13px;color:#9a90b4;">Plan gratuito &mdash; <b style=\'color:#e8c87a;\'>' + usadas + ' de 10</b> subidas usadas</span>' +
            '<button onclick="cerrarAjustes&&cerrarAjustes();mostrarPlanes()" style="background:#e8c87a;color:#1a1500;border:none;border-radius:8px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer;">Actualizar plan</button>' +
            '</div>';
        } else if (pct >= 80) {
          bannerHTML = '<div style="background:#1a2a1a;border:1px solid #2a4a2a;border-radius:10px;padding:12px 16px;margin:8px 16px;display:flex;justify-content:space-between;align-items:center;">' +
            '<span style="font-size:13px;color:#9a90b4;">Has usado <b style=\'color:#e8c87a;\'>' + usadas + ' de ' + limite + '</b> subidas este trimestre</span>' +
            '<button onclick="cerrarAjustes&&cerrarAjustes();mostrarPlanes()" style="background:#e8c87a;color:#1a1500;border:none;border-radius:8px;padding:6px 12px;font-size:12px;font-weight:600;cursor:pointer;">Actualizar plan</button>' +
            '</div>';
        }
      }
      var anno = new Date().getFullYear();
      if (!window.trimestreSel) window.trimestreSel = getTrimestre();
      if (!window.annoSel) window.annoSel = String(anno);

      var anosSet = {};
      for (var y = anno - 2; y <= anno + 3; y++) anosSet[String(y)] = true;
      for (var i = 0; i < facturas.length; i++) { if (facturas[i].anno) anosSet[String(facturas[i].anno)] = true; }
      var anos = Object.keys(anosSet).sort();

      var facturasT = facturas.filter(function(f) { return (window.trimestreSel === 'TODOS' || f.trimestre === window.trimestreSel) && String(f.anno) === window.annoSel; });
      var lista = facturasT;
      if (window.filtroTipo && window.filtroTipo !== 'nomina') lista = lista.filter(function(f) { return f.tipo === window.filtroTipo; });
      if (window.filtroTipo === 'nomina') lista = [];
      if (window.filtroBusqueda) {
        var busq = window.filtroBusqueda.toLowerCase();
        lista = lista.filter(function(f) { return (f.nombre||'').toLowerCase().indexOf(busq) !== -1; });
      }
      var provPend = facturasT.filter(function(f) { return f.tipo === 'proveedor'; });
      var cliPend = facturasT.filter(function(f) { return f.tipo === 'cliente'; });
      var totalProv = facturasT.filter(function(f) { return f.tipo === 'proveedor'; }).reduce(function(s, f) { return s + Number(f.total); }, 0);
      var totalCli = facturasT.filter(function(f) { return f.tipo === 'cliente'; }).reduce(function(s, f) { return s + Number(f.total); }, 0);
      var mesesTrimMap = { T1: ['01','02','03'], T2: ['04','05','06'], T3: ['07','08','09'], T4: ['10','11','12'] };
      var mesesNombres = { enero:'01', febrero:'02', marzo:'03', abril:'04', mayo:'05', junio:'06', julio:'07', agosto:'08', septiembre:'09', octubre:'10', noviembre:'11', diciembre:'12' };
      var nominasT = todasNominas.filter(function(n) {
        if (String(n.anno) !== window.annoSel) return false;
        if (window.trimestreSel === 'TODOS') return true;
        var mesNum = mesesNombres[String(n.mes).toLowerCase()] || String(n.mes).padStart(2,'0');
        return mesesTrimMap[window.trimestreSel] && mesesTrimMap[window.trimestreSel].indexOf(mesNum) !== -1;
      });
      var totalNom = nominasT.reduce(function(s, n) { return s + Number(n.coste_empresa || 0); }, 0);

      var listaHTML = '';
      // ordenar: proveedores agrupados por nombre y fecha, clientes solo por fecha
      function ordenarListaEmpresa(arr) {
        var provs = arr.filter(function(f) { return f.tipo !== 'cliente'; });
        var clis = arr.filter(function(f) { return f.tipo === 'cliente'; });
        var grupos = {};
        provs.forEach(function(f) {
          var key = (f.nombre || 'Sin proveedor').trim();
          if (!grupos[key]) grupos[key] = [];
          grupos[key].push(f);
        });
        Object.keys(grupos).forEach(function(k) {
          grupos[k].sort(function(a, b) { return (a.fecha||'').localeCompare(b.fecha||''); });
        });
        var provOrdenados = [];
        Object.keys(grupos).sort().forEach(function(k) { provOrdenados = provOrdenados.concat(grupos[k]); });
        clis.sort(function(a, b) { return (a.fecha||'').localeCompare(b.fecha||''); });
        return provOrdenados.concat(clis);
      }
      lista = ordenarListaEmpresa(lista);

      var nominasLista = (window.filtroTipo === 'nomina' || !window.filtroTipo) ? nominasT : [];
      if (window.filtroTipo && window.filtroTipo !== 'nomina') nominasLista = [];
      if (window.filtroBusqueda) {
        var busqN = window.filtroBusqueda.toLowerCase();
        nominasLista = nominasLista.filter(function(n) { return (n.trabajador||'').toLowerCase().indexOf(busqN) !== -1; });
      }
      // ordenar nominas por trabajador, luego anno y mes
      nominasLista.sort(function(a,b) {
        var ta = (a.trabajador||'').trim().toLowerCase();
        var tb = (b.trabajador||'').trim().toLowerCase();
        if (ta !== tb) return ta.localeCompare(tb);
        if (String(a.anno) !== String(b.anno)) return Number(a.anno) - Number(b.anno);
        return mesNumero(a.mes) - mesNumero(b.mes);
      });

      if (lista.length === 0 && nominasLista.length === 0) {
        listaHTML = '<div class="empty">No hay documentos en este periodo</div>';
      } else {
        listaHTML = '<div class="facturas-list">';
        var provActualEmp = null;
        for (var i = 0; i < lista.length; i++) {
          var f = lista[i];
          var optsAnnoEdit = anos.map(function(a) { return '<option value="' + a + '"' + (String(f.anno)===a?' selected':'') + '>' + a + '</option>'; }).join('');
          if (f.tipo !== 'cliente') {
            var provNombre = (f.nombre || 'Sin proveedor').trim();
            if (provNombre !== provActualEmp) {
              listaHTML += '<div style="padding:8px 4px;font-size:11px;font-weight:600;color:#9a90b4;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #2a2a3a;margin-bottom:4px;">' + provNombre + '</div>';
              provActualEmp = provNombre;
            }
          }
          listaHTML += '<div class="factura-card' + (f.enviado ? ' enviada' : '') + '">';
          listaHTML += '<div class="factura-header"><span class="factura-nombre">' + f.nombre + '</span>';
          listaHTML += '<div class="factura-badges"><span class="factura-badge badge-' + f.tipo + '">' + f.tipo + '</span>';
          if (f.enviado) listaHTML += '<span class="factura-badge badge-enviada">enviada</span>';
          var epLabels = { transferencia: '🔄 Transferencia', efectivo: '💵 Efectivo', tarjeta: '💳 Tarjeta', domiciliacion: '🏦 Domiciliación', bizum: '📱 Bizum', mixto: '🔀 Mixto', sinpagar: '❌ Sin pagar', parcial: '⚠️ Parcial' };
          var epLabel = f.estado_pago ? (epLabels[f.estado_pago] || f.estado_pago) : '⚠️ Sin clasificar';
          var epClass = f.estado_pago || 'sinpagar';
          listaHTML += '<span class="factura-badge badge-' + epClass + '" style="cursor:pointer" onclick="cambiarEstadoPago(' + f.id + ')">'+epLabel+'</span>';
          listaHTML += '</div></div>';
          listaHTML += '<div class="factura-datos"><span>' + f.fecha + '</span><span>N ' + f.numero_factura + '</span><span class="factura-total">' + formatEur(f.total) + '</span></div>';
          if (f.cif) listaHTML += '<div style="font-size:11px;color:#6a6070;margin-top:2px;">CIF: ' + f.cif + '</div>';
          listaHTML += '<div class="factura-desglose">Base ' + formatEur(f.base_imponible) + ' IVA ' + f.iva_porcentaje + '% ' + formatEur(f.iva_importe) + '</div>';
          if (f.nota) listaHTML += '<div style="font-size:12px;color:#9a90b4;margin-top:6px;padding:6px 8px;background:#1a1a24;border-radius:6px;border-left:2px solid #3a3a5a;">📝 ' + f.nota + '</div>';
          var contBadge = f.contabilizado ? '<span style="background:#0d2b1a;border:1px solid #1a4a2a;color:#4caf7d;border-radius:8px;padding:4px 8px;font-size:11px;">✓ Contabilizado</span>' : '';
          var conciliadoBadge = (window.bancoMovs || []).some(function(m) { return m.factura_id === f.id; }) ? '<span style="background:#0d1a2b;border:1px solid #1a3a4a;color:#4c8faf;border-radius:8px;padding:4px 8px;font-size:11px;">🏦 Conciliado</span>' : '';
          var btnPDF = f.archivo ? '<button class="btn-accion" onclick="verArchivo(\'/facturas/archivo/' + f.archivo + '?token=' + window.token + '\')">' + 'Ver PDF</button>' : '';
          var btnReemplazar = '<button class="btn-accion" id="btn-reemplazar-' + f.id + '">Reemplazar PDF</button><input type="file" id="input-reemplazar-' + f.id + '" accept=".pdf" style="display:none">';
          listaHTML += '<div class="factura-acciones">' + contBadge + conciliadoBadge + btnPDF + btnReemplazar + '<button class="btn-accion" onclick="toggleEdit(' + f.id + ')">Editar</button><button class="btn-borrar" onclick="borrarFactura(' + f.id + ',' + (f.contabilizado ? 'true' : 'false') + ')">Borrar</button></div>';
          listaHTML += '<div class="edit-form" id="edit-' + f.id + '">';
          listaHTML += '<div class="edit-row"><select id="tipo-' + f.id + '"><option value="proveedor"' + (f.tipo==='proveedor'?' selected':'') + '>Proveedor</option><option value="cliente"' + (f.tipo==='cliente'?' selected':'') + '>Cliente</option></select>';
          listaHTML += '<select id="trim-' + f.id + '"><option value="T1"' + (f.trimestre==='T1'?' selected':'') + '>T1</option><option value="T2"' + (f.trimestre==='T2'?' selected':'') + '>T2</option><option value="T3"' + (f.trimestre==='T3'?' selected':'') + '>T3</option><option value="T4"' + (f.trimestre==='T4'?' selected':'') + '>T4</option></select>';
          listaHTML += '<select id="anno-' + f.id + '">' + optsAnnoEdit + '</select></div>';
          listaHTML += '<input class="edit-input" id="nombre-' + f.id + '" value="' + f.nombre + '" placeholder="Nombre">';
          listaHTML += '<input class="edit-input" id="cif-' + f.id + '" value="' + (f.cif || '') + '" placeholder="CIF proveedor">';
          listaHTML += '<input class="edit-input" id="nfactura-' + f.id + '" value="' + f.numero_factura + '" placeholder="N factura">';
          listaHTML += '<input class="edit-input" id="fecha-' + f.id + '" value="' + f.fecha + '" placeholder="DD/MM/YYYY">';
          listaHTML += '<div class="edit-row"><input class="edit-input" id="base-edit-' + f.id + '" value="' + f.base_imponible + '" placeholder="Base" type="number" style="flex:1"><input class="edit-input" id="iva-edit-' + f.id + '" value="' + f.iva_porcentaje + '" placeholder="IVA%" type="number" style="flex:0.5"><input class="edit-input" id="total-edit-' + f.id + '" value="' + f.total + '" placeholder="Total" type="number" style="flex:1"></div>';
          listaHTML += '<textarea class="edit-input" id="nota-' + f.id + '" placeholder="Nota (opcional)" style="resize:vertical;min-height:60px;font-family:inherit;">' + (f.nota || '') + '</textarea>';
          listaHTML += '<button class="btn-guardar" onclick="guardarEdicion(' + f.id + ')">Guardar cambios</button></div></div>';
        }
        listaHTML += '</div>';
      }

      if (nominasLista.length > 0) {
        listaHTML += '<div class="facturas-list" style="margin-top:8px;">';
        var trabajadorActual = null;
        nominasLista.forEach(function(n) {
          var nomTrabNorm = (n.trabajador||'Sin nombre').trim().toLowerCase();
          if (nomTrabNorm !== trabajadorActual) {
            trabajadorActual = nomTrabNorm;
            listaHTML += '<div style="padding:8px 4px;font-size:11px;font-weight:600;color:#9a90b4;letter-spacing:1px;text-transform:uppercase;border-bottom:1px solid #2a2a3a;margin-bottom:4px;">' + (n.trabajador||'Sin nombre').trim() + '</div>';
          }
          var btnPDF = n.archivo ? '<button class="btn-accion" onclick="verArchivo(\'/nominas/archivo/' + n.archivo + '?token=' + window.token + '\')">' + 'Ver PDF</button>' : '';
          var contBadge = n.contabilizado ? '<span style="background:#0d2b1a;border:1px solid #1a4a2a;color:#4caf7d;border-radius:8px;padding:4px 8px;font-size:11px;">✓ Contabilizado</span>' : '';
          var dupBadge = n.duplicado_detectado ? '<span style="background:#2a1f00;border:1px solid #e8c87a;color:#e8c87a;border-radius:8px;padding:4px 8px;font-size:11px;cursor:pointer;" onclick="eliminarPaginaNomina(' + n.id + ',' + (n.pagina_duplicada||2) + ')">✂️ Duplicado</span>' : '';
          listaHTML += '<div class="factura-card">';
          listaHTML += '<div class="factura-header"><span class="factura-nombre">' + (n.trabajador || 'Sin nombre') + '</span>';
          listaHTML += '<span class="factura-badge" style="background:#1a1a2a;border:1px solid #9a90b4;color:#9a90b4;">nómina</span></div>';
          listaHTML += '<div class="factura-datos"><span>' + mesNombre(n.mes) + ' ' + (n.anno || '') + '</span><span class="factura-total">' + formatEur(n.neto) + ' neto</span></div>';
          listaHTML += '<div class="factura-desglose">Coste empresa ' + formatEur(n.coste_empresa) + ' · IRPF ' + (n.irpf_porcentaje||0) + '%</div>';
          var tijeras = (n.archivo && n.num_paginas > 1) ? '<button class="btn-accion" onclick="eliminarPaginaNomina(' + n.id + ',' + (n.pagina_duplicada||2) + ')" title="Dividir PDF">✂️</button>' : '';
          listaHTML += '<div class="factura-acciones">' + contBadge + dupBadge + btnPDF + tijeras + '<button class="btn-accion" onclick="editarNomina(' + n.id + ')">Editar</button><button class="btn-borrar" onclick="borrarNomina(' + n.id + ',' + (n.contabilizado?'true':'false') + ')">Borrar</button></div>';
          listaHTML += '<div class="edit-form" id="edit-nomina-' + n.id + '">';
          listaHTML += '<div class="edit-row"><input class="edit-input" id="en-trabajador-' + n.id + '" value="' + (n.trabajador||'') + '" placeholder="Trabajador"></div>';
          listaHTML += '<div class="edit-row"><input class="edit-input" id="en-neto-' + n.id + '" value="' + (n.neto||'') + '" placeholder="Neto" style="width:48%"><input class="edit-input" id="en-coste-' + n.id + '" value="' + (n.coste_empresa||'') + '" placeholder="Coste empresa" style="width:48%"></div>';
          listaHTML += '<div class="edit-row"><input class="edit-input" id="en-irpf-' + n.id + '" value="' + (n.irpf_importe||'') + '" placeholder="IRPF importe" style="width:48%"><input class="edit-input" id="en-ss-' + n.id + '" value="' + (n.ss_empresa||'') + '" placeholder="SS empresa" style="width:48%"></div>';
          listaHTML += '<button class="btn-guardar" onclick="guardarNomina(' + n.id + ')">Guardar cambios</button>';
          listaHTML += '</div>';
          listaHTML += '</div>';
        });
        listaHTML += '</div>';
      }

      var btnCompartirLabel = window.trimestreSel === 'TODOS' ? '🔗 Compartir año ' + window.annoSel + ' con gestoría' : '🔗 Compartir ' + window.trimestreSel + ' ' + window.annoSel + ' con gestoría';
      var botonesEnvio = '<div style="display:flex;gap:6px;margin-top:8px;"><button onclick="exportarExcel(\'proveedor\')" style="flex:1;background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 4px;font-size:11px;cursor:pointer;">Excel Prov.</button><button onclick="exportarExcel(\'cliente\')" style="flex:1;background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 4px;font-size:11px;cursor:pointer;">Excel Cli.</button><button onclick="generarPDFs()" style="flex:1;background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 4px;font-size:11px;cursor:pointer;">PDFs</button></div>';
      botonesEnvio += '<button onclick="compartirTrimestre()" style="width:100%;margin-top:8px;background:#1e1e28;border:1px solid #e8c87a;color:#e8c87a;border-radius:10px;padding:12px;font-size:14px;cursor:pointer;">' + btnCompartirLabel + '</button>';

      var optsAno = anos.map(function(a) { return '<option value="' + a + '"' + (window.annoSel === a ? ' selected' : '') + '>' + a + '</option>'; }).join('');
      var optsTrim = '<option value="TODOS"' + (window.trimestreSel === 'TODOS' ? ' selected' : '') + '>Todos</option>' + ['T1','T2','T3','T4'].map(function(t) { return '<option value="' + t + '"' + (window.trimestreSel === t ? ' selected' : '') + '>' + t + '</option>'; }).join('');
      var provClass = window.tipoSel === 'proveedor' ? ' selected-prov' : '';
      var cliClass = window.tipoSel === 'cliente' ? ' selected-cli' : '';
      var btnDisabled = !window.tipoSel ? ' disabled' : '';
      var uploadDisplay = window.uploadOpen ? 'block' : 'none';

      document.getElementById('app').innerHTML =
        '<div class="header">' +
        '<div class="header-top"><div><div class="label">' + (window.nombreEmpresa || 'TrimGest') + '</div><h1>' + (window.trimestreSel === 'TODOS' ? 'Año ' : window.trimestreSel + ' ') + window.annoSel + '</h1></div>' +
        '<div style="display:flex;gap:4px;align-items:center;">' +
        '<button class="btn-ajustes" onclick="mostrarAsesor()">&#129302;</button>' +
        '<button class="btn-ajustes" onclick="abrirAjustesGestoria()" title="' + (window.estadoGestoria==='conectada'?window.nombreGestoria:(window.estadoGestoria==='pendiente'?'Solicitud pendiente':'')) + '" style="position:relative;">' +
        (window.estadoGestoria==='conectada' ? '<span style="position:absolute;top:2px;right:2px;width:8px;height:8px;border-radius:50%;background:#4caf7d;border:1px solid #0f0f13;"></span>' : '') +
        (window.estadoGestoria==='pendiente' ? '<span style="position:absolute;top:2px;right:2px;width:8px;height:8px;border-radius:50%;background:#e8c87a;border:1px solid #0f0f13;"></span>' : '') +
        '&#9881;</button>' +
        '<button class="btn-ajustes" onclick="cerrarSesion()" title="Cerrar sesión" style="font-size:18px;">&#x23FB;</button>' +
        '<button class="btn-subir" onclick="toggleUpload()">+ Subir</button>' +
        '</div></div>' +
        '<div class="selectores"><select onchange="window.trimestreSel=this.value;renderApp()">' + optsTrim + '</select><select onchange="window.annoSel=this.value;renderApp()">' + optsAno + '</select></div>' +
        '<div style="display:flex;gap:6px;padding:0 16px 8px;">' +
        '<button onclick="window.filtroTipo=null;renderApp()" style="flex:1;padding:7px;border-radius:8px;font-size:12px;cursor:pointer;border:1px solid #2a2a3a;background:' + (!window.filtroTipo?'#e8c87a':'#1e1e28') + ';color:' + (!window.filtroTipo?'#0f0f13':'#9a90b4') + ';font-weight:600;">Todos</button>' +
        '<button onclick="window.filtroTipo=\'proveedor\';renderApp()" style="flex:1;padding:7px;border-radius:8px;font-size:12px;cursor:pointer;border:1px solid #2a2a3a;background:' + (window.filtroTipo==='proveedor'?'#e8c87a':'#1e1e28') + ';color:' + (window.filtroTipo==='proveedor'?'#0f0f13':'#9a90b4') + ';font-weight:600;">Proveedores</button>' +
        '<button onclick="window.filtroTipo=\'cliente\';renderApp()" style="flex:1;padding:7px;border-radius:8px;font-size:12px;cursor:pointer;border:1px solid #2a2a3a;background:' + (window.filtroTipo==='cliente'?'#e8c87a':'#1e1e28') + ';color:' + (window.filtroTipo==='cliente'?'#0f0f13':'#9a90b4') + ';font-weight:600;">Clientes</button>' +
        '<button onclick="window.filtroTipo=\'nomina\';renderApp()" style="flex:1;padding:7px;border-radius:8px;font-size:12px;cursor:pointer;border:1px solid #2a2a3a;background:' + (window.filtroTipo==='nomina'?'#e8c87a':'#1e1e28') + ';color:' + (window.filtroTipo==='nomina'?'#0f0f13':'#9a90b4') + ';font-weight:600;">Nóminas</button>' +
        '</div>' +
        '<div class="stats">' +
        '<div class="stat"><div class="stat-label">Proveedores</div><div class="stat-value">' + formatEur(totalProv) + '</div><div class="stat-count">' + provPend.length + ' facturas</div></div>' +
        '<div class="stat"><div class="stat-label">Clientes</div><div class="stat-value verde">' + formatEur(totalCli) + '</div><div class="stat-count">' + cliPend.length + ' facturas</div></div>' +
        '<div class="stat"><div class="stat-label">Nóminas</div><div class="stat-value" style="color:#9a90b4;">' + formatEur(totalNom) + '</div><div class="stat-count">' + nominasT.length + ' nóminas</div></div>' +
        '</div></div>' +
        refBannerHTML +
        bannerHTML +
        '<div class="content">' +
        '<div class="upload-area" id="uploadArea" style="display:' + uploadDisplay + '"><div class="upload-box">' +
        '<div class="upload-title">&#128203; ¿Qué quieres subir?</div>' +
        '<div style="display:flex;flex-direction:column;gap:10px;margin-top:12px;">' +
        '<button id="btnSubirProv" style="width:100%;background:#2a1a1a;border:1px solid #c06060;color:#c06060;border-radius:10px;padding:10px;font-size:13px;font-weight:600;cursor:pointer;">&#128196; Factura de proveedor</button>' +
        '<button id="btnSubirCli" style="width:100%;background:#1a2a1a;border:1px solid #7ec47e;color:#7ec47e;border-radius:10px;padding:10px;font-size:13px;font-weight:600;cursor:pointer;">&#129534; Factura de cliente</button>' +
        '<button id="btnSubirNom" style="width:100%;background:#1a1a2a;border:1px solid #9a90b4;color:#9a90b4;border-radius:10px;padding:10px;font-size:13px;font-weight:600;cursor:pointer;">&#128100; Nómina</button>' +
        '<button id="btnImportEmail" style="width:100%;background:#1e1e28;border:1px solid #e8c87a;color:#e8c87a;border-radius:10px;padding:10px;font-size:13px;font-weight:600;cursor:pointer;">&#128267; Importar por email</button>' +
        '<button id="btnIntroManual" style="width:100%;background:#1e1e28;border:1px solid #2a2a3a;color:#6a6070;border-radius:10px;padding:8px;font-size:12px;cursor:pointer;">&#9999;&#65039; Introducir manual</button>' +
        '</div>' +
        '<div id="manualForm" style="display:none;flex-direction:column;gap:8px;margin-top:12px;">' +
        '<select id="manualTipo" class="manual-input"><option value="proveedor">Proveedor</option><option value="cliente">Cliente</option></select>' +
        '<input id="manualNombre" class="manual-input" placeholder="Nombre proveedor/cliente">' +
        '<input id="manualCif" class="manual-input" placeholder="CIF proveedor (opcional)">' +
        '<input id="manualNumero" class="manual-input" placeholder="N factura">' +
        '<input id="manualFecha" class="manual-input" placeholder="DD/MM/AAAA">' +
        '<div id="lineasIva" style="display:flex;flex-direction:column;gap:6px;"></div>' +
        '<button onclick="añadirLineaIva()" style="background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px;font-size:13px;cursor:pointer;width:100%;">+ Añadir linea IVA</button>' +
        '<div style="display:flex;gap:6px;align-items:center;"><span style="font-size:12px;color:#6a6070;white-space:nowrap;">Total:</span><input id="manualTotal" class="manual-input" placeholder="0.00" type="number" style="flex:1;"></div>' +
        '<button onclick="enviarManual()" style="background:#e8c87a;color:#1a1500;border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;">Guardar factura</button>' +
        '</div>' +
        '<input type="file" id="fileInput" accept="application/pdf" onchange="procesarArchivo(this.files[0])" style="display:none">' +
        
        '<div id="uploadStatus"></div></div></div>' +
        '<div class="section-title">Documentos del periodo</div>' +
        '<div style="padding:0 16px 8px;"><input id="buscadorDoc" type="text" placeholder="' + (window.filtroTipo==='proveedor'?'Buscar proveedor...':window.filtroTipo==='cliente'?'Buscar cliente...':window.filtroTipo==='nomina'?'Buscar trabajador...':'Buscar proveedor, cliente o trabajador...') + '" oninput="window.filtroBusqueda=this.value;renderApp()" value="' + (window.filtroBusqueda||'') + '" style="width:100%;box-sizing:border-box;background:#1e1e28;border:1px solid #2a2a3a;color:#e0d8cc;padding:10px 12px;border-radius:10px;font-size:13px;"></div>' +
        botonesEnvio + listaHTML + botonesEnvio + '</div>';
      var btnEmail = document.getElementById('btnImportEmail');
      if (btnEmail) btnEmail.onclick = mostrarModalEmail;
      var btnProv = document.getElementById('btnSubirProv');
      if (btnProv) btnProv.onclick = function() { window.tipoSel = 'proveedor'; document.getElementById('fileInput').click(); };
      var btnCli = document.getElementById('btnSubirCli');
      if (btnCli) btnCli.onclick = function() { window.tipoSel = 'cliente'; document.getElementById('fileInput').click(); };
      var btnNom = document.getElementById('btnSubirNom');
      if (btnNom) btnNom.onclick = function() { subirNomina(); };
      var btnManual = document.getElementById('btnIntroManual');
      if (btnManual) btnManual.onclick = function() { toggleManual(); };
      document.querySelectorAll('[id^="btn-reemplazar-"]').forEach(function(btn) {
        var id = btn.id.replace('btn-reemplazar-', '');
        btn.onclick = function() { iniciarReplazarPDF(id); };
      });
    }

    function seleccionarTipo(tipo) {
      window.tipoSel = tipo;
      var btns = document.querySelectorAll('.tipo-btn');
      btns[0].className = 'tipo-btn' + (tipo === 'proveedor' ? ' selected-prov' : '');
      btns[1].className = 'tipo-btn' + (tipo === 'cliente' ? ' selected-cli' : '');
      document.querySelector('.btn-file').disabled = false;

    }

    function toggleUpload() {
      window.uploadOpen = !window.uploadOpen;
      if (!window.uploadOpen) window.tipoSel = null;
      renderApp();
    }

    function toggleEdit(id) {
      var form = document.getElementById('edit-' + id);
      form.style.display = form.style.display === 'flex' ? 'none' : 'flex';
    }

    async function guardarEdicion(id) {
      var cifEl = document.getElementById('cif-' + id); var notaEl = document.getElementById('nota-' + id); var body = { tipo: document.getElementById('tipo-' + id).value, trimestre: document.getElementById('trim-' + id).value, anno: document.getElementById('anno-' + id).value, nombre: document.getElementById('nombre-' + id).value, cif: cifEl ? cifEl.value : null, numero_factura: document.getElementById('nfactura-' + id).value, fecha: document.getElementById('fecha-' + id).value, base_imponible: document.getElementById('base-edit-' + id).value, iva_porcentaje: document.getElementById('iva-edit-' + id).value, total: document.getElementById('total-edit-' + id).value, nota: notaEl ? notaEl.value : '' };
      await fetch(API + '/facturas/editar/' + id, { method: 'PUT', headers: getHeaders(), body: JSON.stringify(body) });
      renderApp();
    }


    function checkPopupEstadoPago(facturas) {
      var sc = facturas.filter(function(f) { return !f.estado_pago; });
      if (sc.length === 0) return;
      if (document.getElementById('popup-ep')) return;
      var d = document.createElement('div');
      d.id = 'popup-ep';
      d.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#1e1e28;border:1px solid #e8c87a;border-radius:16px;padding:20px;z-index:9999;max-width:340px;width:90%;box-shadow:0 8px 32px rgba(0,0,0,0.5);';
      var n = sc.length;
      d.innerHTML = '<div style="font-size:14px;font-weight:600;color:#e8c87a;margin-bottom:8px;">⚠️ ' + n + ' factura' + (n > 1 ? 's' : '') + ' sin clasificar</div><div style="font-size:12px;color:#9a90b4;margin-bottom:14px;">Toca el badge de cada factura para indicar como esta pagada.</div><button onclick="document.getElementById(\'popup-ep\').remove()" style="width:100%;background:#2a2a3a;border:none;color:#fff;border-radius:10px;padding:10px;cursor:pointer;font-size:13px;">Entendido</button>';
      document.body.appendChild(d);
    }

    async function cambiarEstadoPago(id) {
      var facturas = window.todasFacturas || [];
      var f = facturas.find(function(x) { return x.id === id; });
      if (!f) return;
      var estados = [null, 'sinpagar', 'parcial', 'transferencia', 'tarjeta', 'domiciliacion', 'bizum', 'efectivo', 'mixto'];
      var idx = estados.indexOf(f.estado_pago || null);
      var siguiente = estados[(idx + 1) % estados.length];
      try {
        await fetch(API + '/facturas/editar/' + id, {
          method: 'PUT',
          headers: getHeaders(),
          body: JSON.stringify({ estado_pago: siguiente })
        });
        renderApp();
      } catch(e) { alert('Error'); }
    }

    async function borrarFactura(id, contabilizado) {
      if (contabilizado) {
        alert('Esta factura ha sido contabilizada por tu gestoría y no se puede borrar. Contacta con tu gestoría si necesitas eliminarla.');
        return;
      }
      if (!confirm('Seguro que quieres borrar esta factura?')) return;
      await fetch(API + '/facturas/borrar/' + id, { method: 'DELETE', headers: getHeaders() });
      renderApp();
    }

    async function marcarEnviadas() {
      var facturas = await cargarFacturas();
      var ids = facturas.filter(function(f) { return f.trimestre === window.trimestreSel && String(f.anno) === window.annoSel && !f.enviado; }).map(function(f) { return f.id; });
      await fetch(API + '/facturas/marcar-enviado', { method: 'PUT', headers: getHeaders(), body: JSON.stringify({ ids }) });
      renderApp();
    }

    async function procesarArchivo(file) {
      if (!file) return;
      var status = document.getElementById('uploadStatus');
      status.innerHTML = '<div class="uploading">Procesando con IA...</div>';
      var formData = new FormData();
      formData.append('factura', file);
      try {
        var res = await fetch(API + '/facturas/subir?tipo_manual=' + window.tipoSel + '&empresaId=' + encodeURIComponent(localStorage.getItem('trimgest_empresaId') || ''), {
          method: 'POST',
          headers: { 'Authorization': 'Bearer ' + window.token },
          body: formData
        });
        var data = await res.json();
        if (data.error === 'duplicado') { status.innerHTML = '<div class="duplicado">Esta factura ya esta en el sistema</div>'; }
        else if (data.error === 'limite_alcanzado') { mostrarPopupLimite(data.plan || 'free', data.plan_activo || false); status.innerHTML = ''; }
        else if (data.factura) { var f = data.factura; window.trimestreSel = f.trimestre; window.annoSel = String(f.anno); window.tipoSel = null; window.uploadOpen = false; var msg = data.total > 1 ? data.total + ' facturas procesadas correctamente' : 'Factura procesada correctamente'; status.innerHTML = '<div class="success">' + msg + '</div>'; setTimeout(function() { renderApp(); }, 1500); }
        else { status.innerHTML = '<div class="error">Error al procesar la factura</div>'; }
      } catch(e) { status.innerHTML = '<div class="error">Error de conexion</div>'; }
    }

    async function toggleContabilizado(id) {
  try {
    var r = await fetch(API + '/facturas/editar/' + id, { method: 'PUT', headers: getHeaders(), body: JSON.stringify({ _toggleContabilizado: true }) });
    await r.json();
    renderApp();
  } catch(e) { alert('Error'); }
}

async function exportarExcel(tipo) {
      try {
        var res = await fetch(API + '/exportar/' + tipo + '/' + window.trimestreSel + '/' + window.annoSel, { headers: getHeaders() });
        if (!res.ok) throw new Error('Error');
        var blob = await res.blob();
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url; link.download = 'TrimGest-' + tipo + '-' + window.trimestreSel + '-' + window.annoSel + '.xlsx';
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
        setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
      } catch(e) { alert('Error al exportar'); }
    }

    function compartirTrimestre() {
      var anno = window.annoSel;
      var trim = window.trimestreSel;
      var div = document.createElement('div');
      div.id = 'compartirPanel';
      div.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.85);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;';
      var botonesOpciones = '';
      if (trim !== 'TODOS') {
        botonesOpciones += '<button id="btnTrim" style="background:#1e1e28;border:1px solid #e8c87a;color:#e8c87a;border-radius:10px;padding:12px;font-size:14px;cursor:pointer;text-align:left;">📅 Solo ' + trim + ' ' + anno + '</button>';
      }
      botonesOpciones += '<button id="btnTodos" style="background:#1e1e28;border:1px solid ' + (trim === 'TODOS' ? '#e8c87a' : '#2a2a3a') + ';color:' + (trim === 'TODOS' ? '#e8c87a' : '#9a90b4') + ';border-radius:10px;padding:12px;font-size:14px;cursor:pointer;text-align:left;">📆 Todo el año ' + anno + '</button>';
      div.innerHTML =
        '<div style="background:#16161e;border:1px solid #2a2a3a;border-radius:16px;padding:28px;width:100%;max-width:380px;">' +
        '<div style="font-size:17px;font-weight:700;color:#f0ede8;margin-bottom:6px;">🔗 Compartir con gestoría</div>' +
        '<div style="font-size:13px;color:#6a6070;margin-bottom:20px;">Elige qué periodo quieres compartir</div>' +
        '<div style="display:flex;flex-direction:column;gap:8px;margin-bottom:16px;">' + botonesOpciones + '</div>' +
        '<input id="compartirPass" placeholder="Contraseña (opcional)" style="width:100%;background:#1e1e28;border:1px solid #2a2a3a;color:#f0ede8;border-radius:8px;padding:10px;font-size:13px;margin-bottom:12px;">' +
        '<button id="btnCancelarCompartir" style="width:100%;background:none;border:none;color:#6a6070;font-size:13px;cursor:pointer;">Cancelar</button>' +
        '</div>';
      document.body.appendChild(div);
      if (trim !== 'TODOS') document.getElementById('btnTrim').onclick = function() { ejecutarCompartir(trim, anno); };
      document.getElementById('btnTodos').onclick = function() { ejecutarCompartir('TODOS', anno); };
      document.getElementById('btnCancelarCompartir').onclick = function() { document.getElementById('compartirPanel').remove(); };
    }

    async function ejecutarCompartir(trimestre, anno) {
      var pass = document.getElementById('compartirPass') ? document.getElementById('compartirPass').value || null : null;
      var panel = document.getElementById('compartirPanel');
      if (panel) panel.remove();
      var r = await fetch(API + '/api/compartir/generar', { method: 'POST', headers: getHeaders(), body: JSON.stringify({ trimestre: trimestre, anno: anno, password: pass }) });
      var d = await r.json();
      if (d.url) {
        var url = d.url;
        var div2 = document.createElement('div');
        div2.id = 'enlacePanel';
        div2.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.85);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;';
        div2.innerHTML =
          '<div style="background:#16161e;border:1px solid #2a2a3a;border-radius:16px;padding:28px;width:100%;max-width:380px;">' +
          '<div style="font-size:17px;font-weight:700;color:#f0ede8;margin-bottom:6px;">✅ Enlace generado</div>' +
          '<div style="font-size:13px;color:#6a6070;margin-bottom:16px;">Cópialo y envíalo a tu gestoría</div>' +
          '<div style="background:#1e1e28;border:1px solid #2a2a3a;border-radius:8px;padding:12px;font-size:12px;color:#e8c87a;word-break:break-all;margin-bottom:16px;">' + url + '</div>' +
          '<button id="btnCopiarEnlace" style="width:100%;background:#e8c87a;color:#1a1500;border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:600;cursor:pointer;margin-bottom:8px;">📋 Copiar enlace</button>' +
          '<button id="btnCerrarEnlace" style="width:100%;background:none;border:none;color:#6a6070;font-size:13px;cursor:pointer;">Cerrar</button>' +
          '</div>';
        document.body.appendChild(div2);
        document.getElementById('btnCopiarEnlace').onclick = function() { navigator.clipboard.writeText(url).then(function(){ alert('Copiado!'); }); };
        document.getElementById('btnCerrarEnlace').onclick = function() { document.getElementById('enlacePanel').remove(); };
      }
    }

    function generarPDFs() {
      var t = window.trimestreSel; var a = window.annoSel;
      var div = document.createElement('div');
      div.id = 'pdfPanel';
      div.style.cssText = 'position:fixed;top:0;left:0;right:0;bottom:0;background:#0f0f13;z-index:100;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:40px 20px;gap:16px;';
      div.innerHTML =
        '<div style="font-size:11px;letter-spacing:3px;color:#6a6070;text-transform:uppercase;">TrimGest</div>' +
        '<div style="font-size:20px;color:#f0ede8;margin-bottom:16px;">PDFs para gestoria</div>' +
        '<div style="font-size:13px;color:#6a6070;margin-bottom:8px;">' + t + ' ' + a + '</div>' +
        '<div id="pdfStatus" style="font-size:13px;color:#9a90b4;min-height:20px;text-align:center;"></div>' +
        '<button onclick="descargarPDF(\'proveedor\')" style="background:#c06060;color:#fff;border:none;border-radius:12px;padding:16px;font-size:16px;font-weight:600;cursor:pointer;width:100%;max-width:300px;">PDF Proveedores</button>' +
        '<button onclick="descargarPDF(\'cliente\')" style="background:#7ec47e;color:#1a2a1a;border:none;border-radius:12px;padding:16px;font-size:16px;font-weight:600;cursor:pointer;width:100%;max-width:300px;">PDF Clientes</button>' +
        '<button onclick="document.getElementById(\'pdfPanel\').remove()" style="margin-top:16px;background:none;border:none;color:#6a6070;font-size:13px;cursor:pointer;text-decoration:underline;">Volver</button>';
      document.body.appendChild(div);
    }

    async function descargarPDF(tipo) {
      var status = document.getElementById('pdfStatus');
      status.textContent = 'Generando PDF...';
      try {
        var res = await fetch(API + '/generar/pdf/' + tipo + '/' + window.trimestreSel + '/' + window.annoSel + '?empresa=' + encodeURIComponent(window.nombreEmpresa || 'Mi Empresa'), { headers: getHeaders() });
        if (!res.ok) throw new Error('Error');
        var blob = await res.blob();
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url; link.download = 'TrimGest-' + tipo + '-' + window.trimestreSel + '-' + window.annoSel + '.pdf';
        document.body.appendChild(link); link.click(); document.body.removeChild(link);
        setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
        status.style.color = '#7ec47e'; status.textContent = 'PDF descargado';
      } catch(e) { status.style.color = '#c06060'; status.textContent = 'Error al generar el PDF'; }
    }

    function mostrarPopupLimite(plan, planActivo) {
      var existing = document.getElementById('popup-limite');
      if (existing) existing.remove();

      var contenido = '';
      if (plan === 'free') {
        contenido = '<h3 style="margin:0 0 12px;color:#e8c87a;">Limite alcanzado</h3>' +
          '<p style="color:#aaa;font-size:14px;margin:0 0 20px;">Has llegado al limite de 10 facturas del plan gratuito. Pasa al Plan Basico para subir hasta 100 facturas por trimestre.</p>' +
          '<button onclick="contratarPlan(\'basico\')" style="width:100%;padding:12px;background:#e8c87a;color:#0f0f13;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;">Plan Basico — 10€/mes</button>';
      } else if (plan === 'basico') {
        contenido = '<h3 style="margin:0 0 12px;color:#e8c87a;">Limite alcanzado</h3>' +
          '<p style="color:#aaa;font-size:14px;margin:0 0 16px;">Has llegado al limite de 100 facturas del Plan Basico.</p>' +
          '<button onclick="contratarPlan(\'estandar\')" style="width:100%;padding:12px;background:#e8c87a;color:#0f0f13;border:none;border-radius:8px;font-size:15px;font-weight:700;cursor:pointer;margin-bottom:10px;">Plan Estandar — 20€/mes (200 facturas)</button>' +
          '<button onclick="comprarSubidas(\'p10\')" style="width:100%;padding:10px;background:#2a2a35;color:#e8e8e8;border:1px solid #3a3a45;border-radius:8px;font-size:14px;cursor:pointer;">10 subidas extra — 2€</button>';
      } else if (plan === 'estandar') {
        contenido = '<h3 style="margin:0 0 12px;color:#e8c87a;">Limite alcanzado</h3>' +
          '<p style="color:#aaa;font-size:14px;margin:0 0 16px;">Has llegado al limite de 200 facturas. Compra subidas extra:</p>' +
          '<div style="display:flex;flex-direction:column;gap:8px;">' +
          '<button onclick="comprarSubidas(\'p10\')" style="width:100%;padding:10px;background:#2a2a35;color:#e8e8e8;border:1px solid #3a3a45;border-radius:8px;font-size:14px;cursor:pointer;text-align:left;display:flex;justify-content:space-between;"><span>10 subidas</span><span style="color:#e8c87a;">2€ (0,20€/u)</span></button>' +
          '<button onclick="comprarSubidas(\'p50\')" style="width:100%;padding:10px;background:#2a2a35;color:#e8e8e8;border:1px solid #3a3a45;border-radius:8px;font-size:14px;cursor:pointer;text-align:left;display:flex;justify-content:space-between;"><span>50 subidas</span><span style="color:#e8c87a;">7,50€ (0,15€/u)</span></button>' +
          '<button onclick="comprarSubidas(\'p100\')" style="width:100%;padding:10px;background:#2a2a35;color:#e8e8e8;border:1px solid #3a3a45;border-radius:8px;font-size:14px;cursor:pointer;text-align:left;display:flex;justify-content:space-between;"><span>100 subidas</span><span style="color:#e8c87a;">10€ (0,10€/u)</span></button>' +
          '<button onclick="comprarSubidas(\'p200\')" style="width:100%;padding:10px;background:#2a2a35;color:#e8e8e8;border:1px solid #3a3a45;border-radius:8px;font-size:14px;cursor:pointer;text-align:left;display:flex;justify-content:space-between;"><span>200 subidas</span><span style="color:#e8c87a;">16€ (0,08€/u)</span></button>' +
          '</div>';
      }

      var popup = document.createElement('div');
      popup.id = 'popup-limite';
      popup.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;';
      popup.innerHTML = '<div style="background:#1a1a20;border:1px solid #2a2a35;border-radius:16px;padding:28px;max-width:400px;width:90%;position:relative;">' +
        '<button onclick="document.getElementById(\'popup-limite\').remove()" style="position:absolute;top:12px;right:16px;background:none;border:none;color:#888;font-size:20px;cursor:pointer;">×</button>' +
        contenido +
        '</div>';
      document.body.appendChild(popup);
    }

    async function contratarPlan(plan) {
      try {
        var r = await fetch(API + '/stripe/checkout', { method: 'POST', headers: getHeaders(), body: JSON.stringify({ plan: plan }) });
        var d = await r.json();
        if (d.url) window.location.href = d.url;
      } catch(e) { alert('Error al conectar con el sistema de pago'); }
    }

    async function comprarSubidas(paquete) {
      try {
        var r = await fetch(API + '/stripe/comprar-subidas', { method: 'POST', headers: getHeaders(), body: JSON.stringify({ paquete: paquete }) });
        var d = await r.json();
        if (d.url) window.location.href = d.url;
      } catch(e) { alert('Error al conectar con el sistema de pago'); }
    }

function mostrarModalEmail() {
  var empresaId = window.empresaId || '';
  if (!empresaId) {
    try {
      var token = localStorage.getItem('trimgest_token');
      if (token) { var payload = JSON.parse(atob(token.split('.')[1])); empresaId = payload.empresaId || ''; }
    } catch(e) {}
  }
  var emailFact = 'facturas+' + empresaId + '@trimgest.es';
  var emailCli = 'clientes+' + empresaId + '@trimgest.es';
  var emailNom = 'nominas+' + empresaId + '@trimgest.es';

  var modal = document.createElement('div');
  modal.id = 'modalEmailImport';
  modal.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.7);z-index:9999;display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;';

  var inner = document.createElement('div');
  inner.style.cssText = 'background:#16161e;border-radius:16px;padding:24px;max-width:480px;width:100%;border:1px solid #2a2a3a;';

  var titulo = document.createElement('div');
  titulo.style.cssText = 'font-size:20px;color:#e8c87a;font-weight:600;margin-bottom:8px;';
  titulo.textContent = 'Importar por email';

  var desc = document.createElement('p');
  desc.style.cssText = 'color:#9a90b4;font-size:14px;margin-bottom:20px;';
  desc.textContent = 'Reenvía cualquier factura o nómina en PDF a estas direcciones y la IA la clasificará automáticamente en tu panel.';

  function crearFila(label, email, idEl) {
    var bloque = document.createElement('div');
    bloque.style.marginBottom = '16px';
    var lbl = document.createElement('div');
    lbl.style.cssText = 'font-size:12px;color:#6a6070;margin-bottom:6px;';
    lbl.textContent = label;
    var fila = document.createElement('div');
    fila.style.cssText = 'display:flex;align-items:center;gap:8px;background:#0f0f13;border-radius:10px;padding:12px;';
    var txt = document.createElement('div');
    txt.id = idEl;
    txt.style.cssText = 'font-size:13px;color:#e8c87a;font-family:monospace;flex:1;word-break:break-all;';
    txt.textContent = email;
    var btn = document.createElement('button');
    btn.style.cssText = 'background:#e8c87a;color:#1a1500;border:none;border-radius:8px;padding:8px 12px;font-size:12px;font-weight:600;cursor:pointer;white-space:nowrap;';
    btn.textContent = 'Copiar';
    btn.onclick = function() { copiarEmailModal(idEl); };
    fila.appendChild(txt);
    fila.appendChild(btn);
    bloque.appendChild(lbl);
    bloque.appendChild(fila);
    return bloque;
  }

  var btnCerrar = document.createElement('button');
  btnCerrar.style.cssText = 'width:100%;background:#2a2a3a;color:#9a90b4;border:none;border-radius:10px;padding:14px;font-size:14px;font-weight:600;cursor:pointer;margin-top:8px;';
  btnCerrar.textContent = 'Cerrar';
  btnCerrar.onclick = function() { modal.remove(); };

  inner.appendChild(titulo);
  inner.appendChild(desc);
  inner.appendChild(crearFila('FACTURAS DE PROVEEDOR', emailFact, 'modalEmailFact'));
  inner.appendChild(crearFila('FACTURAS DE CLIENTE', emailCli, 'modalEmailCli'));
  inner.appendChild(crearFila('NOMINAS', emailNom, 'modalEmailNom'));
  inner.appendChild(btnCerrar);

  modal.appendChild(inner);
  modal.onclick = function(e) { if(e.target === modal) modal.remove(); };
  document.body.appendChild(modal);
}

function copiarEmailModal(id) {
  var el = document.getElementById(id);
  if (!el) return;
  navigator.clipboard.writeText(el.textContent).then(function() {
    var btn = el.nextElementSibling;
    var orig = btn.textContent;
    btn.textContent = '¡Copiado!';
    btn.style.background = '#7ec47e';
    setTimeout(function() { btn.textContent = orig; btn.style.background = '#e8c87a'; }, 2000);
  });
}

function mostrarOnboarding() {
  if (window.perfilOnboarding && window.perfilOnboarding.onboarding_completado) return;

  var paso = 1;

  var overlay = document.createElement('div');
  overlay.id = 'onboardingOverlay';
  overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:99999;display:flex;align-items:center;justify-content:center;padding:20px;box-sizing:border-box;';

  function renderPaso() {
    overlay.innerHTML = '';
    var box = document.createElement('div');
    box.style.cssText = 'background:#16161e;border-radius:20px;padding:32px 24px;max-width:420px;width:100%;border:1px solid #2a2a3a;';

    var pasos = [
      {
        emoji: '👋',
        titulo: 'Bienvenido a TrimGest',
        texto: 'Gestiona tus facturas y nóminas con IA. En menos de 2 minutos tendrás todo listo para tu primer trimestre.',
        btn: 'Empezar →'
      },
      {
        emoji: '📄',
        titulo: 'Sube tu primera factura',
        texto: 'Toca "+ Subir" y selecciona el tipo de documento. La IA extraerá todos los datos automáticamente. También puedes reenviar facturas por email.',
        btn: 'Entendido →'
      },
      {
        emoji: '🤝',
        titulo: 'Conecta con tu gestoría',
        texto: 'Invita a tu gestoría para que acceda a tus datos directamente desde su panel. Es gratis para ellos y te ahorra tiempo a ti.',
        btn: '¡Listo, empezar!'
      }
    ];

    var p = pasos[paso - 1];

    var indicadores = document.createElement('div');
    indicadores.style.cssText = 'display:flex;justify-content:center;gap:6px;margin-bottom:24px;';
    for (var i = 1; i <= 3; i++) {
      var dot = document.createElement('div');
      dot.style.cssText = 'width:8px;height:8px;border-radius:50%;background:' + (i === paso ? '#e8c87a' : '#2a2a3a') + ';';
      indicadores.appendChild(dot);
    }

    var emoji = document.createElement('div');
    emoji.style.cssText = 'font-size:48px;text-align:center;margin-bottom:16px;';
    emoji.textContent = p.emoji;

    var titulo = document.createElement('div');
    titulo.style.cssText = 'font-size:20px;color:#f0ede8;font-weight:700;text-align:center;margin-bottom:12px;';
    titulo.textContent = p.titulo;

    var texto = document.createElement('p');
    texto.style.cssText = 'color:#9a90b4;font-size:14px;text-align:center;line-height:1.6;margin-bottom:28px;';
    texto.textContent = p.texto;

    var checkRow = null;


    var btnSiguiente = document.createElement('button');
    btnSiguiente.style.cssText = 'width:100%;background:#e8c87a;color:#1a1500;border:none;border-radius:12px;padding:14px;font-size:16px;font-weight:700;cursor:pointer;';
    btnSiguiente.textContent = p.btn;
    btnSiguiente.onclick = function() {
      if (paso < 3) {
        paso++;
        renderPaso();
      } else {
        fetch(API + '/usuarios/perfil', { method: 'PUT', headers: getHeaders(), body: JSON.stringify({ onboarding_completado: true }) });
        if (window.perfilOnboarding) window.perfilOnboarding.onboarding_completado = true;
        overlay.remove();
        window.uploadOpen = true;
        renderApp();
      }
    };

    var btnSaltar = document.createElement('button');
    btnSaltar.style.cssText = 'width:100%;background:none;border:none;color:#6a6070;font-size:13px;cursor:pointer;margin-top:12px;padding:8px;';
    btnSaltar.textContent = 'Saltar introducción';
    btnSaltar.onclick = function() {
      overlay.remove();
    };

    box.appendChild(indicadores);
    box.appendChild(emoji);
    box.appendChild(titulo);
    box.appendChild(texto);
    if (checkRow) box.appendChild(checkRow);
    box.appendChild(btnSiguiente);
    box.appendChild(btnSaltar);
    overlay.appendChild(box);
  }

  renderPaso();
  document.body.appendChild(overlay);
}

    function verArchivo(url) {
      var modal = document.getElementById('pdf-viewer-modal');
      var iframe = document.getElementById('pdf-viewer-iframe');
      if (modal && iframe) { iframe.src = url; modal.style.display = 'flex'; } else { window.open(url, '_blank'); }
    }
    function cerrarPDFViewer() {
      var modal = document.getElementById('pdf-viewer-modal');
      var iframe = document.getElementById('pdf-viewer-iframe');
      if (modal) modal.style.display = 'none';
      if (iframe) iframe.src = '';
    }
  </script>
<div id="pdf-viewer-modal" style="display:none;position:fixed;inset:0;z-index:99999;background:#0f0f13;flex-direction:column;"><div style="display:flex;justify-content:space-between;align-items:center;padding:env(safe-area-inset-top,16px) 16px 12px;background:#16161e;border-bottom:1px solid #22223a;min-height:60px;"><span style="font-size:14px;font-weight:600;color:#e8e0f0;">Documento</span><button onclick="cerrarPDFViewer()" style="background:#e8c87a;border:none;color:#1a1500;border-radius:10px;padding:10px 20px;font-size:15px;font-weight:700;cursor:pointer;">&#x2715; Cerrar</button></div><iframe id="pdf-viewer-iframe" src="" style="flex:1;width:100%;border:none;background:#fff;"></iframe></div>
</body>
</html>
