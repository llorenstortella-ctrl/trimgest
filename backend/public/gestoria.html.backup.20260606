async function solicitarAcceso() {
  var email = document.getElementById('email-empresa').value.trim();
  if (!email) return mostrarMsg('solicitar-msg', 'Introduce el email de la empresa', true);
  try {
    var r = await fetch(API + '/gestoria/solicitar-acceso', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ emailEmpresa: email })
    });
    var d = await r.json();
    if (!d.ok) return mostrarMsg('solicitar-msg', d.error || 'Error', true);
    mostrarMsg('solicitar-msg', 'Solicitud enviada. La empresa debera aceptarla desde sus ajustes.', false);
    document.getElementById('email-empresa').value = '';
  } catch(e) { mostrarMsg('solicitar-msg', 'Error de conexion', true); }
}

async function cargarInvitaciones() {
  try {
    var r = await fetch(API + '/gestoria/invitaciones', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    var lista = document.getElementById('invitaciones-lista');
    var pendientes = (d.invitaciones || []).filter(function(i) { return i.estado === 'invitacion_pendiente' || i.estado === 'pendiente'; });
    if (!pendientes.length) { lista.innerHTML = '<div class="empty">No tienes invitaciones pendientes.</div>'; return; }
    lista.innerHTML = pendientes.map(function(inv) {
      return '<div class="inv-card">' +
        '<div><div style="font-size:14px;font-weight:600;">' + inv.empresaNombre + '</div><div style="font-size:12px;color:#888;">' + inv.empresaEmail + '</div></div>' +
        '<div style="display:flex;gap:8px;">' +
        '<button class="btn btn-primary btn-sm" data-eid="' + inv.empresaId + '" data-accion="aceptar" onclick="responderInvitacion(this.dataset.eid, this.dataset.accion)">Aceptar</button>' +
        '<button class="btn btn-secondary btn-sm" data-eid="' + inv.empresaId + '" data-accion="rechazar" onclick="responderInvitacion(this.dataset.eid, this.dataset.accion)">Rechazar</button>' +
        '</div></div>';
    }).join('');
  } catch(e) { console.error(e); }
}

async function responderInvitacion(empresaId, accion) {
  try {
    var r = await fetch(API + '/gestoria/responder-invitacion', {
      method: 'POST', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ empresaId: empresaId, accion: accion })
    });
    var d = await r.json();
    if (!d.ok) return alert(d.error || 'Error');
    cargarInvitaciones();
    if (accion === 'aceptar') cargarClientes();
  } catch(e) { alert('Error de conexion'); }
}


async function cargarAjustesGestoria() {
  try {
    var r = await fetch(API + '/gestoria/perfil', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    if (d.ok) {
      document.getElementById('ajuste-nombre').value = d.nombre || '';
      document.getElementById('ajuste-telefono').value = d.telefono || '';
    }
  } catch(e) { console.error(e); }
}


async function cargarReferidosGestoria() {
  try {
    var r = await fetch(API + '/referidos/info', { headers: { 'Authorization': 'Bearer ' + token } });
    var data = await r.json();
    var elEnlace = document.getElementById('gest-ref-enlace');
    var elSaldo = document.getElementById('gest-ref-saldo');
    var elCobrar = document.getElementById('gest-ref-cobrar');
    var elCopiar = document.getElementById('gest-ref-copiar');
    var elEnviar = document.getElementById('gest-ref-enviar');
    if (!elEnlace) return;
    elEnlace.textContent = data.enlace || '';
    elSaldo.textContent = (data.ref_saldo || 0) + '€';
    if ((data.ref_saldo || 0) >= 15) elCobrar.style.display = 'inline-block';
    elCopiar.onclick = function() {
      navigator.clipboard.writeText(data.enlace || '');
      elCopiar.textContent = 'Copiado!';
      setTimeout(function() { elCopiar.textContent = 'Copiar'; }, 2000);
    };
    elEnviar.onclick = async function() {
      var email = document.getElementById('gest-ref-email').value.trim();
      if (!email) return;
      elEnviar.disabled = true;
      elEnviar.textContent = '...';
      try {
        var res = await fetch(API + '/referidos/invitar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ emailDestino: email })
        });
        var d = await res.json();
        if (d.ok) {
          document.getElementById('gest-ref-email').value = '';
          elEnviar.textContent = 'Enviado!';
          setTimeout(function() { elEnviar.textContent = 'Enviar'; elEnviar.disabled = false; }, 2000);
        } else {
          elEnviar.textContent = 'Error';
          setTimeout(function() { elEnviar.textContent = 'Enviar'; elEnviar.disabled = false; }, 2000);
        }
      } catch(e) { elEnviar.textContent = 'Enviar'; elEnviar.disabled = false; }
    };
    elCobrar.onclick = function() {
      var iban = prompt('Introduce tu IBAN para recibir ' + (data.ref_saldo || 0) + '€:');
      if (!iban) return;
      var dni = prompt('Introduce tu DNI o NIF:');
      if (!dni) return;
      fetch(API + '/referidos/solicitar-pago', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ iban: iban, dni: dni })
      }).then(function(r) { return r.json(); }).then(function(d) {
        if (d.ok) alert('Solicitud enviada. Te transferiremos ' + (data.ref_saldo || 0) + '€ en los proximos dias.');
        else alert(d.error || 'Error al solicitar pago');
      }).catch(function() { alert('Error de conexion'); });
    };
  } catch(e) { console.error('Error cargando referidos gestoria:', e); }
}

async function guardarAjustesGestoria() {
  var nombre = document.getElementById('ajuste-nombre').value.trim();
  var telefono = document.getElementById('ajuste-telefono').value.trim();
  var msg = document.getElementById('ajustes-msg');
  try {
    var r = await fetch(API + '/gestoria/perfil', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify({ nombre: nombre, telefono: telefono })
    });
    var d = await r.json();
    if (d.ok) { msg.style.color = '#7ec47e'; msg.textContent = 'Guardado correctamente'; }
    else { msg.style.color = '#c06060'; msg.textContent = d.error || 'Error al guardar'; }
  } catch(e) { msg.style.color = '#c06060'; msg.textContent = 'Error de conexion'; }
}

var _refCodigo = new URLSearchParams(window.location.search).get('ref');
if (_refCodigo) sessionStorage.setItem('ref_codigo', _refCodigo);
if (window.location.hash === '#registro') switchAuthTab('registro');
if (token) {
  fetch(API + '/gestoria/clientes', { headers: { 'Authorization': 'Bearer ' + token } })
    .then(function(r) { return r.json(); })
    .then(function(d) { if (d.ok !== undefined) entrarApp(); else localStorage.removeItem('gest_token'); })
    .catch(function() {});
}

var pdfModalCallback = null;
var pdfModalConAdjuntos = false;

function abrirModalPdf(callback) {
  pdfModalCallback = callback;
  pdfModalConAdjuntos = false;
  var opResumen = document.getElementById('pdf-opcion-resumen');
  var opAdjuntos = document.getElementById('pdf-opcion-adjuntos');
  opResumen.style.borderColor = '#e8c87a';
  opAdjuntos.style.borderColor = '#2a2a35';
  document.getElementById('modal-pdf').style.display = 'flex';

}

function cerrarModalPdf() {
  document.getElementById('modal-pdf').style.display = 'none';
  pdfModalCallback = null;
}

function seleccionarOpcionPdf(opcion) {
  pdfModalConAdjuntos = opcion === 'adjuntos';
  document.getElementById('pdf-opcion-resumen').style.borderColor = pdfModalConAdjuntos ? '#2a2a35' : '#e8c87a';
  document.getElementById('pdf-opcion-adjuntos').style.borderColor = pdfModalConAdjuntos ? '#e8c87a' : '#2a2a35';
  document.getElementById('pdf-opcion-resumen').querySelector('div').style.color = pdfModalConAdjuntos ? '#e0d8cc' : '#e8c87a';
  document.getElementById('pdf-opcion-adjuntos').querySelector('div').style.color = pdfModalConAdjuntos ? '#e8c87a' : '#e0d8cc';
}


function actualizarBotonesSeleccionadas() {
  var provChecked = document.querySelectorAll('.fact-check[data-tipo="proveedor"]:checked').length > 0;
  var cliChecked = document.querySelectorAll('.fact-check[data-tipo="cliente"]:checked').length > 0;
  var nomChecked = document.querySelectorAll('.nom-check:checked').length > 0;
  var btnPdfProv = document.getElementById('btn-pdf-sel-prov');
  var btnExcelProv = document.getElementById('btn-excel-sel-prov');
  var btnPdfCli = document.getElementById('btn-pdf-sel-cli');
  var btnExcelCli = document.getElementById('btn-excel-sel-cli');
  var btnPdfNom = document.getElementById('btn-pdf-sel-nom');
  if (btnPdfProv) { btnPdfProv.className = provChecked ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'; }
  if (btnExcelProv) { btnExcelProv.className = provChecked ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'; }
  if (btnPdfCli) { btnPdfCli.className = cliChecked ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'; }
  if (btnExcelCli) { btnExcelCli.className = cliChecked ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'; }
  if (btnPdfNom) { btnPdfNom.className = nomChecked ? 'btn btn-primary btn-sm' : 'btn btn-secondary btn-sm'; }
}

document.addEventListener('change', function(e) {
  if (e.target && (e.target.classList.contains('fact-check') || e.target.classList.contains('nom-check'))) {
    actualizarBotonesSeleccionadas();
  }
});

function ejecutarPdfModal() {
  var cb = pdfModalCallback;
  var adj = pdfModalConAdjuntos;
  cerrarModalPdf();
  if (cb) cb(adj);
}

// MÓDULO BANCO GESTORÍA

var bancoMovsGest = [];

async function cargarBancoGest() {
  if (!clienteActivo) return;
  // Inicializar selectores con trimestre y año actual si no han sido tocados
  var hoy = new Date();
  var annoActual = hoy.getFullYear();
  var mesActual = hoy.getMonth() + 1;
  var trimActual = mesActual <= 3 ? 'T1' : mesActual <= 6 ? 'T2' : mesActual <= 9 ? 'T3' : 'T4';
  var selTrim = document.getElementById('banco-trim-gest');
  var selAnno = document.getElementById('banco-anno-gest');
  if (selAnno && !selAnno.dataset.inicializado) {
    selAnno.value = clienteActivo === 'emp_demo_construcciones' ? 2025 : annoActual;
    selAnno.dataset.inicializado = '1';
  }
  if (selTrim && !selTrim.dataset.inicializado) {
    selTrim.value = clienteActivo === 'emp_demo_construcciones' ? 'T1' : trimActual;
    selTrim.dataset.inicializado = '1';
  }
  var trim = selTrim ? selTrim.value : trimActual;
  var anno = selAnno ? parseInt(selAnno.value) : annoActual;
  var lista = document.getElementById('banco-lista-gest');
  var stats = document.getElementById('banco-stats-gest');
  if (!lista) return;
  lista.innerHTML = '<div style="color:#9a90b4;padding:20px;text-align:center;">Cargando...</div>';
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    if (!d.ok) { lista.innerHTML = '<div style="color:#e05555;padding:20px;">Error cargando banco</div>'; return; }
    var movs = d.movimientos || [];
    var mesesTrim = { T1:[1,2,3], T2:[4,5,6], T3:[7,8,9], T4:[10,11,12] };
    movs = movs.filter(function(m) {
      var fecha = new Date(m.fecha);
      var mes = fecha.getMonth() + 1;
      var anyoMov = fecha.getFullYear();
      if (anyoMov !== anno) return false;
      if (trim === 'todos') return true;
      return mesesTrim[trim] && mesesTrim[trim].includes(mes);
    });
    bancoMovsGest = movs;
    var pendientes = movs.filter(function(m) { return m.estado === 'pendiente'; });
    var conciliados = movs.filter(function(m) { return m.estado === 'conciliado'; });
    var sinFactura = movs.filter(function(m) { return m.estado === 'sin_factura'; });
    if (stats) stats.innerHTML =
      '<div style="background:#1a1a28;border-radius:8px;padding:10px 16px;font-size:12px;color:#9a90b4;">Pendientes: <strong style="color:#e8c87a;">' + pendientes.length + '</strong></div>' +
      '<div style="background:#1a1a28;border-radius:8px;padding:10px 16px;font-size:12px;color:#9a90b4;">Conciliados: <strong style="color:#4caf7d;">' + conciliados.length + '</strong></div>' +
      '<div style="background:#1a1a28;border-radius:8px;padding:10px 16px;font-size:12px;color:#9a90b4;">Sin factura: <strong style="color:#888;">' + sinFactura.length + '</strong></div>';
    renderBancoGest(movs);
  } catch(e) { lista.innerHTML = '<div style="color:#e05555;padding:20px;">Error: ' + e.message + '</div>'; }
}

function renderBancoGest(movs) {
  var lista = document.getElementById('banco-lista-gest');
  if (!lista) return;
  if (!movs.length) { lista.innerHTML = '<div style="color:#9a90b4;padding:20px;text-align:center;">Sin movimientos en este periodo</div>'; return; }
  var html = '';
  movs.forEach(function(m) {
    var color = m.importe >= 0 ? '#4caf7d' : '#e05555';
    var estadoBadge = m.estado === 'conciliado' ? '<span style="background:#1a3a2a;color:#4caf7d;padding:2px 8px;border-radius:6px;font-size:11px;">Conciliado</span>' :
      m.estado === 'sin_factura' ? '<span style="background:#2a2a2a;color:#888;padding:2px 8px;border-radius:6px;font-size:11px;">Sin factura</span>' :
      '<span style="background:#3a2a1a;color:#e8c87a;padding:2px 8px;border-radius:6px;font-size:11px;">Pendiente</span>';
    var asignado = m.factura_nombre ? '<div style="font-size:11px;color:#9a90b4;margin-top:4px;">' + m.factura_nombre + '</div>' :
      m.motivo ? '<div style="font-size:11px;color:#9a90b4;margin-top:4px;">' + m.motivo + '</div>' : '';
    var btnAsignar = m.estado === 'pendiente'
      ? '<button class="btn btn-secondary btn-sm btn-asignar-gest" data-id="' + m.id + '" style="font-size:11px;padding:4px 10px;">Asignar</button>'
      : '<button class="btn btn-secondary btn-sm btn-deshacer-gest" data-id="' + m.id + '" style="font-size:11px;padding:4px 10px;color:#888;">Deshacer</button>';
    html += '<div class="banco-mov-gest" data-id="' + m.id + '" style="background:#1a1a28;border-radius:10px;padding:12px 16px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap;">' +
      '<div style="flex:1;min-width:0;">' +
        '<div style="font-size:13px;font-weight:600;color:#e8e0f0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">' + m.concepto + '</div>' +
        '<div style="font-size:11px;color:#6a6070;margin-top:2px;">' + m.fecha_display + '</div>' +
        asignado +
      '</div>' +
      '<div style="display:flex;align-items:center;gap:8px;flex-shrink:0;">' +
        estadoBadge +
        '<span style="font-size:14px;font-weight:700;color:' + color + ';">' + (m.importe >= 0 ? '+' : '') + m.importe.toFixed(2) + '€</span>' +
        btnAsignar +
      '</div>' +
    '</div>';
  });
  lista.innerHTML = html;
  lista.querySelectorAll('.btn-asignar-gest').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = parseInt(this.dataset.id);
      var opciones = [
        { titulo: 'Factura de proveedor' },
        { titulo: 'Factura de cliente' },
        { titulo: 'Nomina trabajador' },
        { titulo: 'Sin factura (TGSS, banco, personal...)' }
      ];
      mostrarModalBanco('¿Que es este movimiento?', opciones, function(idx) {
        if (idx === 0) mostrarSelectorFacturaBancoGest([id], 'proveedor');
        else if (idx === 1) mostrarSelectorFacturaBancoGest([id], 'cliente');
        else if (idx === 2) asignarNominaBancoGest(id);
        else if (idx === 3) marcarSinFacturaBancoGest(id);
      });
    });
  });
  lista.querySelectorAll('.btn-deshacer-gest').forEach(function(btn) {
    btn.addEventListener('click', async function() {
      var id = parseInt(this.dataset.id);
      await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/actualizar-movimiento', {
        method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ movimiento_id: id, estado: 'pendiente', factura_id: null, factura_nombre: null, factura_total: null, nomina_id: null, motivo: null })
      });
      cargarBancoGest();
    });
  });
}

function filtrarBancoGest(texto) {
  var t = texto.toLowerCase().trim();
  document.querySelectorAll('.banco-mov-gest').forEach(function(el) {
    el.style.display = (!t || el.textContent.toLowerCase().includes(t)) ? '' : 'none';
  });
}

async function mostrarSelectorFacturaBancoGest(ids, tipo) {
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/facturas', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    var facturas = (d.facturas || []).filter(function(f) { return tipo === 'cliente' ? f.tipo === 'cliente' : f.tipo !== 'cliente'; });
    var asignadas = bancoMovsGest.filter(function(m) { return m.factura_id && !ids.includes(m.id); }).map(function(m) { return m.factura_id; });
    facturas = facturas.filter(function(f) { return !asignadas.includes(f.id); });
    if (!facturas.length) { alert('No hay facturas disponibles'); return; }
    var opciones = facturas.map(function(f) { return { titulo: f.nombre + ' — ' + (f.total || 0).toFixed(2) + '€ (' + (f.fecha || '') + ')', id: f.id, nombre: f.nombre, total: f.total }; });
    mostrarModalBanco('Selecciona la factura', opciones, async function(idx) {
      var factura = opciones[idx];
      for (var i = 0; i < ids.length; i++) {
        await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/actualizar-movimiento', {
          method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
          body: JSON.stringify({ movimiento_id: ids[i], estado: 'conciliado', factura_id: factura.id, factura_nombre: factura.titulo, factura_total: factura.total })
        });
      }
      cargarBancoGest();
    });
  } catch(e) { alert('Error: ' + e.message); }
}

async function asignarNominaBancoGest(id) {
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/nominas', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    var nominas = d.nominas || [];
    if (!nominas.length) { alert('No hay nominas disponibles'); return; }
    var opciones = nominas.map(function(n) { return { titulo: (n.trabajador || '') + ' — ' + (n.mes || '') + '/' + (n.anno || '') + ' — ' + (n.neto || 0).toFixed(2) + '€', id: n.id, nombre: (n.trabajador || '') + ' ' + (n.mes || '') + '/' + (n.anno || ''), total: n.neto }; });
    mostrarModalBanco('Selecciona la nomina', opciones, async function(idx) {
      var nomina = opciones[idx];
      await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/actualizar-movimiento', {
        method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
        body: JSON.stringify({ movimiento_id: id, estado: 'conciliado', nomina_id: nomina.id, factura_nombre: nomina.nombre, factura_total: nomina.total })
      });
      cargarBancoGest();
    });
  } catch(e) { alert('Error: ' + e.message); }
}

async function marcarSinFacturaBancoGest(id) {
  var motivos = [
    { titulo: 'TGSS / Seguridad Social' },
    { titulo: 'Comision bancaria' },
    { titulo: 'Gasto personal' },
    { titulo: 'Transferencia interna' },
    { titulo: 'Otro (especificar)' }
  ];
  mostrarModalBanco('Motivo del movimiento', motivos, async function(idx) {
    var motivo = motivos[idx].titulo;
    if (idx === 4) {
      var texto = prompt('Describe el motivo:');
      if (!texto) return;
      motivo = texto;
    }
    await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/actualizar-movimiento', {
      method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
      body: JSON.stringify({ movimiento_id: id, estado: 'sin_factura', motivo: motivo })
    });
    cargarBancoGest();
  });
}

async function reconciliarBancoGest() {
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/reconciliar', {
      method: 'POST', headers: { 'Authorization': 'Bearer ' + token }
    });
    var d = await r.json();
    alert('Re-conciliados: ' + (d.actualizados || 0) + ' movimientos');
    cargarBancoGest();
  } catch(e) { alert('Error: ' + e.message); }
}

async function resetearBancoGest() {
  if (!confirm('¿Seguro que quieres borrar todo el historial bancario de este cliente?')) return;
  try {
    await fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/resetear', {
      method: 'POST', headers: { 'Authorization': 'Bearer ' + token }
    });
    cargarBancoGest();
  } catch(e) { alert('Error: ' + e.message); }
}

document.addEventListener('change', function(e) {
  if (e.target && e.target.id === 'banco-csv-gest') {
    var file = e.target.files[0];
    if (!file) return;
    var formData = new FormData();
    formData.append('extracto', file);
    fetch(API + '/gestoria/cliente/' + clienteActivo + '/banco/subir', {
      method: 'POST', headers: { 'Authorization': 'Bearer ' + token },
      body: formData
    }).then(function(r) { return r.json(); }).then(function(d) {
      if (d.ok) { alert('Importados: ' + d.nuevos + ' movimientos (' + d.conciliados + ' conciliados)'); cargarBancoGest(); }
      else { alert('Error: ' + (d.error || 'Error desconocido')); }
    }).catch(function(e) { alert('Error: ' + e.message); });
  }
});

</script>
<div id="modal-pdf" class="modal-overlay" style="display:none">
  <div class="modal" style="max-width:420px;">
    <div class="modal-title">📄 Generar PDF</div>
    <p style="font-size:13px;color:#9a90b4;margin-bottom:20px;">Elige qué quieres incluir en el PDF</p>
    <div id="pdf-opcion-resumen" style="background:#13131a;border:2px solid #e8c87a;border-radius:12px;padding:16px;margin-bottom:12px;cursor:pointer;" onclick="seleccionarOpcionPdf('resumen')">
      <div style="font-size:14px;font-weight:600;color:#e8c87a;margin-bottom:4px;">📊 Solo informe resumen</div>
      <div style="font-size:12px;color:#6a6070;">Tabla con todas las facturas: número, fecha, proveedor, importes y forma de pago.</div>
    </div>
    <div id="pdf-opcion-adjuntos" style="background:#13131a;border:2px solid #2a2a35;border-radius:12px;padding:16px;margin-bottom:20px;cursor:pointer;" onclick="seleccionarOpcionPdf('adjuntos')">
      <div style="font-size:14px;font-weight:600;color:#e0d8cc;margin-bottom:4px;">📎 Informe + PDFs adjuntos</div>
      <div style="font-size:12px;color:#6a6070;">El informe resumen seguido de los PDFs originales de cada factura adjuntados al final.</div>
    </div>
    <div class="modal-btns">
      <button id="btn-pdf-generar" class="btn btn-primary" style="flex:1;" onclick="ejecutarPdfModal()">Generar PDF</button>
      <button onclick="cerrarModalPdf()" class="btn btn-secondary" style="flex:1;">Cancelar</button>
    </div>
  </div>
</div>

<div id="pdf-viewer-modal" style="display:none;position:fixed;inset:0;z-index:99999;background:#0f0f13;"><div style="display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:#16161e;border-bottom:1px solid #22223a;"><span style="font-size:14px;font-weight:600;color:#e8e0f0;">Documento</span><button onclick="cerrarPDFViewer()" style="background:#2a2a3a;border:none;color:#e8e0f0;border-radius:8px;padding:8px 16px;font-size:13px;cursor:pointer;">✕ Cerrar</button></div><iframe id="pdf-viewer-iframe" src="" style="flex:1;width:100%;border:none;background:#fff;"></iframe></div>
</body>
</html>