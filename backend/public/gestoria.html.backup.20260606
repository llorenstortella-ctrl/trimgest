<!DOCTYPE html>
<html lang="es">
<head>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="manifest" href="/manifest-gestoria.json">
  <meta name="theme-color" content="#0f0f13">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="TrimGest">
  <link rel="apple-touch-icon" href="/icon-192.png">
  <script>if("serviceWorker" in navigator){navigator.serviceWorker.register("/sw.js");}</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TrimGest — Panel Gestoria</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #0f0f13; color: #e8e8e8; min-height: 100vh; }
.topbar { background: #1a1a20; border-bottom: 1px solid #2a2a35; padding: 0 32px; height: 60px; display: flex; align-items: center; justify-content: space-between; }
.logo { font-size: 20px; font-weight: 700; color: #e8c87a; letter-spacing: -0.5px; }
.topbar-right { display: flex; align-items: center; gap: 16px; }
.nombre-gestoria { font-size: 14px; color: #888; }
.btn-logout { background: none; border: 1px solid #333; color: #888; padding: 6px 14px; border-radius: 6px; cursor: pointer; font-size: 13px; }
.btn-logout:hover { border-color: #e8c87a; color: #e8c87a; }
.layout { display: flex; min-height: calc(100vh - 60px); }
.sidebar { width: 220px; background: #1a1a20; border-right: 1px solid #2a2a35; padding: 24px 0; flex-shrink: 0; }
.nav-item { display: flex; align-items: center; gap: 10px; padding: 10px 24px; cursor: pointer; color: #888; font-size: 14px; transition: all 0.2s; }
.nav-item:hover { color: #e8e8e8; background: #22222a; }
.nav-item.active { color: #e8c87a; background: #22222a; border-left: 2px solid #e8c87a; }
.main { flex: 1; padding: 32px; overflow-y: auto; }
.page { display: none; }
.page.active { display: block; }
.page-title { font-size: 22px; font-weight: 600; margin-bottom: 24px; }
.card { background: #1a1a20; border: 1px solid #2a2a35; border-radius: 12px; padding: 24px; margin-bottom: 16px; }
.card-title { font-size: 15px; font-weight: 600; margin-bottom: 16px; color: #e8c87a; }
.input-row { margin-bottom: 14px; }
.input-row label { display: block; font-size: 12px; color: #888; margin-bottom: 6px; }
.input-row input, .input-row select { width: 100%; background: #0f0f13; border: 1px solid #2a2a35; border-radius: 8px; padding: 10px 14px; color: #e8e8e8; font-size: 14px; outline: none; }
.input-row input:focus, .input-row select:focus { border-color: #e8c87a; }
.btn { padding: 10px 20px; border-radius: 8px; font-size: 14px; font-weight: 500; cursor: pointer; border: none; transition: all 0.2s; }
.btn-primary { background: #e8c87a; color: #0f0f13; }
.btn-primary:hover { background: #f0d48a; }
.btn-secondary { background: #2a2a35; color: #e8e8e8; }
.btn-danger { background: #3a1a1a; color: #e05555; border: 1px solid #4a2a2a; }
.btn-sm { padding: 5px 10px; font-size: 12px; }
.clientes-lista { display: flex; flex-direction: column; gap: 12px; }
.cliente-card { background: #0f0f13; border: 1px solid #2a2a35; border-radius: 10px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; cursor: pointer; transition: border-color 0.2s; }
.cliente-card:hover { border-color: #e8c87a; }
.cliente-info h3 { font-size: 15px; font-weight: 600; margin-bottom: 4px; }
.cliente-info p { font-size: 12px; color: #888; }
.tabs { display: flex; gap: 8px; margin-bottom: 20px; flex-wrap: wrap; }
.tab { padding: 8px 18px; border-radius: 8px; font-size: 13px; cursor: pointer; background: #2a2a35; color: #888; border: none; }
.tab.active { background: #e8c87a; color: #0f0f13; font-weight: 600; }
.tabla-wrap { overflow-x: auto; }
.tabla { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 600px; }
.tabla th { text-align: left; padding: 10px 12px; color: #888; border-bottom: 1px solid #2a2a35; font-weight: 500; }
.tabla td { padding: 10px 12px; border-bottom: 1px solid #1a1a20; vertical-align: middle; }
.empty { text-align: center; padding: 40px; color: #555; font-size: 14px; }
.inv-card { background: #0f0f13; border: 1px solid #2a2a35; border-radius: 10px; padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }
.msg { padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 14px; }
.msg-ok { background: #0d2b1a; color: #4caf7d; border: 1px solid #1a4a2a; }
.msg-err { background: #2b0d0d; color: #e05555; border: 1px solid #4a1a1a; }
.back-btn { display: flex; align-items: center; gap: 8px; color: #888; font-size: 13px; cursor: pointer; margin-bottom: 20px; background: none; border: none; }
.back-btn:hover { color: #e8c87a; }
#auth-screen { display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #0f0f13; }
.auth-box { background: #1a1a20; border: 1px solid #2a2a35; border-radius: 16px; padding: 40px; width: 100%; max-width: 400px; }
.auth-logo { font-size: 24px; font-weight: 700; color: #e8c87a; text-align: center; margin-bottom: 8px; }
.auth-sub { text-align: center; color: #888; font-size: 13px; margin-bottom: 28px; }
.auth-tabs { display: flex; background: #0f0f13; border-radius: 8px; padding: 4px; margin-bottom: 24px; }
.auth-tab { flex: 1; text-align: center; padding: 8px; border-radius: 6px; cursor: pointer; font-size: 13px; color: #888; border: none; background: none; }
.auth-tab.active { background: #2a2a35; color: #e8e8e8; }
.export-bar { display: flex; gap: 10px; margin-bottom: 20px; flex-wrap: wrap; }
.filtros-bar { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; align-items: center; }
.filtros-bar select { background: #1a1a20; border: 1px solid #2a2a35; border-radius: 8px; padding: 7px 12px; color: #e8e8e8; font-size: 13px; outline: none; }
  .filtros-bar input[type="text"] { background: #1a1a20; border: 1px solid #2a2a35; border-radius: 8px; padding: 7px 12px; color: #e8e8e8; font-size: 13px; outline: none; min-width: 180px; }
.badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
.badge-green { background: #0d2b1a; color: #4caf7d; }
.badge-red { background: #2b0d0d; color: #e05555; }
.badge-gray { background: #2a2a35; color: #888; }
.modal-overlay { position: fixed; top:0; left:0; right:0; bottom:0; background: rgba(0,0,0,0.7); z-index: 200; display: flex; align-items: center; justify-content: center; padding: 20px; }
.modal { background: #1a1a20; border: 1px solid #2a2a35; border-radius: 16px; padding: 28px; width: 100%; max-width: 480px; max-height: 90vh; overflow-y: auto; }
.modal-title { font-size: 16px; font-weight: 600; margin-bottom: 20px; color: #e8c87a; }
.modal-row { margin-bottom: 12px; }
.modal-row label { display: block; font-size: 12px; color: #888; margin-bottom: 5px; }
.modal-row input, .modal-row select { width: 100%; background: #0f0f13; border: 1px solid #2a2a35; border-radius: 8px; padding: 9px 12px; color: #e8e8e8; font-size: 13px; outline: none; }
.modal-row input:focus { border-color: #e8c87a; }
.modal-btns { display: flex; gap: 10px; margin-top: 20px; }
@media (max-width: 768px) {
  .layout { flex-direction: column; }
  .sidebar { width: 100%; border-right: none; border-bottom: 1px solid #2a2a35; padding: 8px 0; display: flex; overflow-x: auto; }
  .nav-item { white-space: nowrap; padding: 10px 16px; border-left: none !important; border-bottom: 2px solid transparent; }
  .nav-item.active { border-bottom: 2px solid #e8c87a; border-left: none !important; }
  .main { padding: 16px; }
  .page-title { font-size: 18px; margin-bottom: 16px; }
  .auth-box { padding: 24px 20px; margin: 16px; }
  .cliente-card { flex-direction: column; align-items: flex-start; gap: 12px; }
  .cliente-card > div:last-child { width: 100%; }
  .cliente-card .btn { width: 100%; text-align: center; }
  .inv-card { flex-direction: column; align-items: flex-start; gap: 12px; }
  .inv-card > div:last-child { width: 100%; display: flex; gap: 8px; }
  .inv-card .btn { flex: 1; text-align: center; }
  .topbar { padding: 0 16px; }
  .card { padding: 16px; }
  .tabs { overflow-x: auto; }
  .export-bar { flex-direction: column; }
  .export-bar .btn { width: 100%; text-align: center; }
  .filtros-bar { flex-direction: column; align-items: stretch; }
  .filtros-bar select { width: 100%; }
  .modal { padding: 20px 16px; }
  .modal-btns { flex-direction: column; }
  .tabla-wrap table { display: none; }
  .mobile-facturas { display: block; }
  .mobile-factura-card { background: #1a1a20; border: 1px solid #2a2a35; border-radius: 10px; padding: 14px; margin-bottom: 10px; }
  .mobile-factura-nombre { font-size: 14px; font-weight: 600; color: #e0d8cc; margin-bottom: 2px; }
  .desktop-only { display: block; }
  .mobile-only { display: none; }
  @media (max-width: 768px) {
    .desktop-only { display: none !important; }
    .mobile-only { display: block !important; }
  }
  .mobile-factura-numero { font-size: 11px; color: #6a6070; margin-bottom: 8px; }
  .mobile-factura-row { display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; }
  .mobile-factura-row span:first-child { color: #6a6070; }
  .mobile-factura-row span:last-child { color: #e0d8cc; }
  .mobile-factura-total { font-size: 16px; font-weight: 700; color: #e8c87a; margin: 8px 0; }
  .mobile-factura-btns { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 10px; }
  .mobile-factura-btns button, .mobile-factura-btns a { flex: 1; min-width: 70px; text-align: center; }
}
.mobile-facturas { display: none; }
</style>
</head>
<body>
<div id="pwa-bar" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:9999;background:#16161e;border-top:1px solid #22223a;padding:8px 16px;display:none;justify-content:space-between;align-items:center;"><button onclick="window.history.back()" style="background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 16px;font-size:13px;cursor:pointer;">← Atrás</button><button onclick="window.location.reload()" style="background:#1e1e28;border:1px solid #2a2a3a;color:#9a90b4;border-radius:8px;padding:8px 16px;font-size:13px;cursor:pointer;">⟳ Recargar</button></div><script>if(window.navigator.standalone || window.matchMedia("(display-mode: standalone)").matches){  var b=document.getElementById("pwa-bar");  if(b){b.style.display="flex";document.body.style.paddingBottom="52px";}}</script>

<div id="auth-screen">
  <div class="auth-box">
    <div class="auth-logo"><svg width="120" height="32" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="1" width="14" height="14" rx="2.5" fill="#e8c87a"/><rect x="16" y="1" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="0" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="16" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><line x1="14.5" y1="1" x2="14.5" y2="31" stroke="#0f0f13" stroke-width="2"/><line x1="0" y1="16" x2="30" y2="16" stroke="#0f0f13" stroke-width="2"/><text x="38" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="300" fill="#f0ede8" letter-spacing="-0.5">Trim</text><text x="72" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="600" fill="#e8c87a" letter-spacing="-0.5">Gest</text></svg></div>
    <div class="auth-sub">Panel de Gestoria</div>
    <div class="auth-tabs">
      <button class="auth-tab active" id="tab-btn-login" onclick="switchAuthTab('login')">Entrar</button>
      <button class="auth-tab" id="tab-btn-registro" onclick="switchAuthTab('registro')">Registrarse</button>
    </div>
    <div id="auth-msg"></div>
    <div id="tab-login">
      <div class="input-row"><label>Email</label><input type="email" id="login-email" placeholder="gestoria@email.com"></div>
      <div class="input-row"><label>Contrasena</label><input type="password" id="login-pass" placeholder="••••••••"></div>
      <button class="btn btn-primary" style="width:100%;margin-top:8px" onclick="doLogin()">Entrar</button>
    </div>
    <div id="tab-registro" style="display:none">
      <div class="input-row"><label>Nombre de la gestoria</label><input type="text" id="reg-nombre" placeholder="Gestoria Ejemplo SL"></div>
      <div class="input-row"><label>Email</label><input type="email" id="reg-email" placeholder="gestoria@email.com"></div>
      <div class="input-row"><label>Contrasena</label><input type="password" id="reg-pass" placeholder="Minimo 6 caracteres"></div>
      <button class="btn btn-primary" style="width:100%;margin-top:8px" onclick="doRegistro()">Crear cuenta</button>
    </div>
  </div>
</div>

<div id="app-screen" style="display:none">
  <div class="topbar">
    <div class="logo"><svg width="120" height="32" viewBox="0 0 120 32" xmlns="http://www.w3.org/2000/svg"><rect x="0" y="1" width="14" height="14" rx="2.5" fill="#e8c87a"/><rect x="16" y="1" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="0" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><rect x="16" y="17" width="14" height="14" rx="2.5" fill="none" stroke="#e8c87a" stroke-width="1.5"/><line x1="14.5" y1="1" x2="14.5" y2="31" stroke="#0f0f13" stroke-width="2"/><line x1="0" y1="16" x2="30" y2="16" stroke="#0f0f13" stroke-width="2"/><text x="38" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="300" fill="#f0ede8" letter-spacing="-0.5">Trim</text><text x="72" y="21" font-family="-apple-system,BlinkMacSystemFont,sans-serif" font-size="20" font-weight="600" fill="#e8c87a" letter-spacing="-0.5">Gest</text></svg><span style="font-size:12px;color:#888;font-weight:400;margin-left:8px">Gestoria</span></div>
    <div class="topbar-right">
      <span class="nombre-gestoria" id="nombre-gestoria-top"></span>
      <button class="btn-logout" onclick="logout()">Cerrar sesion</button>
    </div>
  </div>
  <div class="layout">
    <div class="sidebar">
      <div class="nav-item active" id="nav-clientes" onclick="showPage('clientes', this)">&#127962; Mis clientes</div>
      <div class="nav-item" id="nav-solicitar" onclick="showPage('solicitar', this)">&#43; Solicitar acceso</div>
      <div class="nav-item" id="nav-invitaciones" onclick="showPage('invitaciones', this)">&#128232; Invitaciones</div>
      <div class="nav-item" id="nav-ajustes" onclick="showPage('ajustes', this)">&#9881; Ajustes</div>
      <div onclick="showPage('ajustes', document.getElementById('nav-ajustes'))" style="margin:16px 12px 0;background:#1e1a0a;border:1px solid #3a3010;border-radius:10px;padding:12px;cursor:pointer;">
        <div style="font-size:13px;margin-bottom:4px;">&#127873; <span style="color:#e8c87a;font-weight:600;">Invita y gana 5&euro;</span></div>
        <div style="font-size:11px;color:#9a7a30;">Por cada cliente que se suscriba &rarr;</div>
      </div>
    </div>
    <div class="main">

      <div class="page active" id="page-clientes">
        <div id="detalle-wrap" style="display:none">
          <button class="back-btn" onclick="cerrarDetalle()">&#8592; Volver a clientes</button>
          <div class="page-title" id="detalle-nombre"></div>

          <div class="tabs">
            <button class="tab active" id="tab-btn-proveedores" onclick="switchTab('proveedores')">Proveedores</button>
            <button class="tab" id="tab-btn-clientes" onclick="switchTab('clientes')">Clientes</button>
            <button class="tab" id="tab-btn-nominas" onclick="switchTab('nominas')">Nominas</button>
            <button class="tab" id="tab-btn-banco" onclick="switchTab('banco')">&#127981; Banco</button>
          </div>

          <div id="tab-proveedores-content">
            <div class="filtros-bar">
              <input type="text" id="buscar-prov" placeholder="🔍 Buscar proveedor, nº factura..." oninput="filtrarFacturas()">
              <select id="sel-trimestre" onchange="filtrarFacturas()">
                <option value="">Todos los trimestres</option>
                <option value="T1">T1</option>
                <option value="T2">T2</option>
                <option value="T3">T3</option>
                <option value="T4">T4</option>
              </select>
              <select id="sel-anno" onchange="filtrarFacturas()">
                <option value="">Todos los anos</option>
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
              </select>
              <select id="sel-estado-prov" onchange="filtrarFacturas()">
                <option value="">Todos los estados</option>
                <option value="sinclasificar">Sin clasificar</option>
                <option value="sinpagar">Sin pagar</option>
                <option value="transferencia">Transferencia</option>
                <option value="tarjeta">Tarjeta</option>
                <option value="domiciliacion">Domiciliacion</option>
                <option value="bizum">Bizum</option>
                <option value="efectivo">Efectivo</option>
                <option value="mixto">Mixto</option>
                <option value="parcial">Parcial</option>
              </select>
              <select id="sel-cont-prov" onchange="filtrarFacturas()">
                <option value="">Contabilizado: todos</option>
                <option value="si">Contabilizado</option>
                <option value="no">No contabilizado</option>
              </select>
            </div>
            <div class="export-bar">
              <button class="btn btn-secondary btn-sm" onclick="exportarExcelCliente('proveedor')">&#128196; Excel</button>
              <button class="btn btn-secondary btn-sm" onclick="descargarPDFCliente('proveedor')">📄 PDF todas</button>
              <button id="btn-pdf-sel-prov" class="btn btn-secondary btn-sm" onclick="descargarPDFFacturasSeleccionadas('proveedor')">📄 PDF seleccionadas</button>
              <button id="btn-excel-sel-prov" class="btn btn-secondary btn-sm" onclick="exportarExcelSeleccionadas('proveedor')">📊 Excel seleccionadas</button>
            </div>
            <div class="card">
              <div class="tabla-wrap">
                <table class="tabla">
                  <thead><tr><th><input type="checkbox" id="check-all-prov" onclick="toggleTodos('prov',this.checked)"></th><th>Numero</th><th>Fecha</th><th>Proveedor</th><th>Concepto</th><th>Base</th><th>IVA</th><th>Total</th><th>Pago</th><th>Acciones</th></tr></thead>
                  <tbody id="tabla-proveedores"></tbody>
                </table>
              </div>
              <div class="mobile-facturas" id="mobile-proveedores"></div>
            </div>
          </div>

          <div id="tab-clientes-content" style="display:none">
            <div class="filtros-bar">
              <input type="text" id="buscar-cli" placeholder="🔍 Buscar cliente, nº factura..." oninput="filtrarFacturas()">
              <select id="sel-trimestre-cli" onchange="filtrarFacturas()">
                <option value="">Todos los trimestres</option>
                <option value="T1">T1</option>
                <option value="T2">T2</option>
                <option value="T3">T3</option>
                <option value="T4">T4</option>
              </select>
              <select id="sel-anno-cli" onchange="filtrarFacturas()">
                <option value="">Todos los anos</option>
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
              </select>
              <select id="sel-estado-cli" onchange="filtrarFacturas()">
                <option value="">Todos los estados</option>
                <option value="sinclasificar">Sin clasificar</option>
                <option value="sinpagar">Sin pagar</option>
                <option value="transferencia">Transferencia</option>
                <option value="tarjeta">Tarjeta</option>
                <option value="domiciliacion">Domiciliacion</option>
                <option value="bizum">Bizum</option>
                <option value="efectivo">Efectivo</option>
                <option value="mixto">Mixto</option>
                <option value="parcial">Parcial</option>
              </select>
              <select id="sel-cont-cli" onchange="filtrarFacturas()">
                <option value="">Contabilizado: todos</option>
                <option value="si">Contabilizado</option>
                <option value="no">No contabilizado</option>
              </select>
            </div>
            <div class="export-bar">
              <button class="btn btn-secondary btn-sm" onclick="exportarExcelCliente('cliente')">&#128196; Excel</button>
              <button class="btn btn-secondary btn-sm" onclick="descargarPDFCliente('cliente')">📄 PDF todas</button>
              <button id="btn-pdf-sel-cli" class="btn btn-secondary btn-sm" onclick="descargarPDFFacturasSeleccionadas('cliente')">📄 PDF seleccionadas</button>
              <button id="btn-excel-sel-cli" class="btn btn-secondary btn-sm" onclick="exportarExcelSeleccionadas('cliente')">📊 Excel seleccionadas</button>
            </div>
            <div class="card">
              <div class="tabla-wrap">
                <table class="tabla">
                  <thead><tr><th><input type="checkbox" id="check-all-cli" onclick="toggleTodos('cli',this.checked)"></th><th>Numero</th><th>Fecha</th><th>Cliente</th><th>Concepto</th><th>Base</th><th>IVA</th><th>Total</th><th>Acciones</th></tr></thead>
                  <tbody id="tabla-clientes"></tbody>
                </table>
              </div>
              <div class="mobile-facturas" id="mobile-clientes"></div>
            </div>
          </div>

          <div id="tab-nominas-content" style="display:none">
            <div class="filtros-bar">
              <input type="text" id="buscar-nom" placeholder="🔍 Buscar trabajador..." oninput="filtrarNominas()">
              <select id="sel-empleado" onchange="filtrarNominas()">
                <option value="">Todos los trabajadores</option>
              </select>
              <select id="sel-anno-nom" onchange="filtrarNominas()">
                <option value="">Todos los anos</option>
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
              </select>
            </div>
            <div class="export-bar">
              <button class="btn btn-secondary btn-sm" onclick="descargarPDFNominasCliente()">📄 PDF todas</button>
              <button id="btn-pdf-sel-nom" class="btn btn-secondary btn-sm" onclick="descargarPDFSeleccionadas()">📄 PDF seleccionadas</button>
            </div>
            <div class="card desktop-only">
              <div class="tabla-wrap">
                <table class="tabla">
                  <thead><tr><th><input type="checkbox" id="check-all-nominas" onclick="toggleTodosNominas(this.checked)"></th><th>Trabajador</th><th>Mes</th><th>Ano</th><th>Bruto</th><th>Neto</th><th>Acciones</th></tr></thead>
                  <tbody id="tabla-nominas"></tbody>
                </table>
              </div>
            </div>
            <div id="mobile-nominas-list" class="mobile-only" style="padding: 8px 0;"></div>
          </div>

          <div id="tab-banco-content" style="display:none">
            <div class="filtros-bar" style="margin-bottom:12px;">
              <input type="text" id="banco-buscar-gest" placeholder="🔍 Buscar concepto..." oninput="filtrarBancoGest(this.value)" style="flex:1;padding:8px;border-radius:8px;border:1px solid #2a2a3a;background:#1a1a28;color:#e8e0f0;font-size:13px;">
              <select id="banco-trim-gest" onchange="cargarBancoGest()" style="padding:8px;border-radius:8px;border:1px solid #2a2a3a;background:#1a1a28;color:#e8e0f0;font-size:13px;">
                <option value="T1">T1</option>
                <option value="T2">T2</option>
                <option value="T3">T3</option>
                <option value="T4">T4</option>
                <option value="todos">Año completo</option>
              </select>
              <select id="banco-anno-gest" onchange="cargarBancoGest()" style="padding:8px;border-radius:8px;border:1px solid #2a2a3a;background:#1a1a28;color:#e8e0f0;font-size:13px;">
                <option value="2024">2024</option>
                <option value="2025">2025</option>
                <option value="2026">2026</option>
              </select>
            </div>
            <div style="display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;">
              <label style="display:flex;align-items:center;cursor:pointer;position:relative;">
                <input type="file" id="banco-csv-gest" accept=".csv" style="display:none">
                <button class="btn btn-secondary btn-sm" onclick="document.getElementById('banco-csv-gest').click()">&#128196; Subir CSV</button>
              </label>
              <button class="btn btn-secondary btn-sm" onclick="reconciliarBancoGest()">&#8635; Re-conciliar</button>
              <button class="btn btn-secondary btn-sm" onclick="resetearBancoGest()" style="color:#e05555;">&#128465; Resetear</button>
            </div>
            <div id="banco-stats-gest" style="display:flex;gap:12px;margin-bottom:12px;flex-wrap:wrap;"></div>
            <div id="banco-lista-gest"></div>
          </div>
        </div>

        <div id="clientes-lista-wrap">
          <div class="page-title">Mis clientes</div>
          <div id="clientes-lista" class="clientes-lista"></div>
        </div>
      </div>

      <div class="page" id="page-solicitar">
        <div class="page-title">Solicitar acceso a cliente</div>
        <div class="card" style="max-width:500px">
          <div class="card-title">Buscar empresa por email</div>
          <p style="font-size:13px;color:#888;margin-bottom:16px">Introduce el email con el que la empresa esta registrada en TrimGest.</p>
          <div id="solicitar-msg"></div>
          <div class="input-row"><label>Email de la empresa</label><input type="email" id="email-empresa" placeholder="empresa@email.com"></div>
          <button class="btn btn-primary" onclick="solicitarAcceso()">Enviar solicitud</button>
        </div>
      </div>

      <div class="page" id="page-ajustes">
        <div class="page-title">Ajustes</div>
        <div class="card" style="max-width:500px;margin-top:16px;">
          <div class="card-title">Datos de contacto</div>
          <div class="input-row" style="margin-bottom:12px;">
            <label>Nombre gestoría</label>
            <input type="text" id="ajuste-nombre" placeholder="Nombre de tu gestoría">
          </div>
          <div class="input-row" style="margin-bottom:16px;">
            <label>Teléfono WhatsApp</label>
            <input type="tel" id="ajuste-telefono" placeholder="Ej: 612345678 (sin +34)">
            <div style="font-size:11px;color:#6a6070;margin-top:4px;">Tus clientes podrán contactarte directamente por WhatsApp</div>
          </div>
          <button class="btn btn-primary" onclick="guardarAjustesGestoria()">Guardar</button>
          <div id="ajustes-msg" style="margin-top:10px;font-size:13px;"></div>
        </div>

        <div class="card" style="max-width:500px;margin-top:16px;">
          <div class="card-title">Invita y gana</div>
          <p style="font-size:13px;color:#9a90b4;margin-bottom:12px;">Invita a empresas a usar TrimGest. Cuando se suscriban, ganas <strong style="color:#e8c87a;">5&euro;</strong> por cada una.</p>
          <div style="font-size:11px;color:#6a6070;margin-bottom:6px;">Tu enlace de invitaci&oacute;n:</div>
          <div style="display:flex;gap:8px;margin-bottom:16px;">
            <div id="gest-ref-enlace" style="flex:1;background:#22223a;border-radius:8px;padding:10px;font-size:11px;color:#9a90b4;word-break:break-all;"></div>
            <button id="gest-ref-copiar" style="background:#22223a;border:none;color:#f0ede8;border-radius:6px;padding:8px 12px;font-size:11px;cursor:pointer;white-space:nowrap;">Copiar</button>
          </div>
          <div style="font-size:11px;color:#6a6070;margin-bottom:6px;">Enviar invitaci&oacute;n por email:</div>
          <div style="display:flex;gap:8px;margin-bottom:16px;">
            <input id="gest-ref-email" type="email" placeholder="email@empresa.com" style="flex:1;background:#22223a;border:1px solid #2a2a3a;border-radius:8px;padding:10px;font-size:13px;color:#f0ede8;">
            <button id="gest-ref-enviar" class="btn btn-primary" style="white-space:nowrap;">Enviar</button>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;">
            <div style="font-size:13px;color:#9a90b4;">Saldo acumulado: <strong id="gest-ref-saldo" style="color:#e8c87a;">0&euro;</strong></div>
            <button id="gest-ref-cobrar" style="display:none;" class="btn btn-secondary">Solicitar pago</button>
          </div>
        </div>
      </div>

      <div class="page" id="page-invitaciones">
        <div class="page-title">Invitaciones recibidas</div>
        <div id="invitaciones-lista"></div>
      </div>

    </div>
  </div>
</div>

<!-- Modal editar factura -->
<div id="modal-factura" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-title">Editar factura</div>
    <div class="modal-row"><label>Numero</label><input id="ef-numero" type="text"></div>
    <div class="modal-row"><label>Fecha</label><input id="ef-fecha" type="text"></div>
    <div class="modal-row"><label>Proveedor / Emisor</label><input id="ef-proveedor" type="text"></div>
    <div class="modal-row"><label>Concepto</label><input id="ef-concepto" type="text"></div>
    <div class="modal-row"><label>Base imponible</label><input id="ef-base" type="number" step="0.01"></div>
    <div class="modal-row"><label>IVA %</label><input id="ef-iva" type="number" step="0.01"></div>
    <div class="modal-row"><label>Total</label><input id="ef-total" type="number" step="0.01"></div>
    <div class="modal-row"><label>Tipo</label>
      <select id="ef-tipo">
        <option value="proveedor">Proveedor</option>
        <option value="cliente">Cliente</option>
      </select>
    </div>
    <div class="modal-btns">
      <button class="btn btn-primary" style="flex:1" onclick="guardarFactura()">Guardar</button>
      <button class="btn btn-secondary" style="flex:1" onclick="cerrarModal('modal-factura')">Cancelar</button>
    </div>
  </div>
</div>

<!-- Modal editar nomina -->
<div id="modal-nomina" class="modal-overlay" style="display:none">
  <div class="modal">
    <div class="modal-title">Editar nomina</div>
    <div class="modal-row"><label>Empleado</label><input id="en-empleado" type="text"></div>
    <div class="modal-row"><label>Mes</label><input id="en-mes" type="text"></div>
    <div class="modal-row"><label>Ano</label><input id="en-anno" type="text"></div>
    <div class="modal-row"><label>Salario bruto</label><input id="en-bruto" type="number" step="0.01"></div>
    <div class="modal-row"><label>Seg. Social empleado</label><input id="en-ss" type="number" step="0.01"></div>
    <div class="modal-row"><label>IRPF</label><input id="en-irpf" type="number" step="0.01"></div>
    <div class="modal-row"><label>Salario neto</label><input id="en-neto" type="number" step="0.01"></div>
    <div class="modal-btns">
      <button class="btn btn-primary" style="flex:1" onclick="guardarNomina()">Guardar</button>
      <button class="btn btn-secondary" style="flex:1" onclick="cerrarModal('modal-nomina')">Cancelar</button>
    </div>
  </div>
</div>

<script>
var API = '';
var token = localStorage.getItem('gest_token');
var gestoriaNombre = localStorage.getItem('gest_nombre');
var clienteActivo = null;
var clienteNombreActivo = '';
var todasFacturas = [];
var editandoFacturaId = null;
var editandoNominaId = null;

function switchAuthTab(tab) {
  document.getElementById('tab-login').style.display = tab === 'login' ? 'block' : 'none';
  document.getElementById('tab-registro').style.display = tab === 'registro' ? 'block' : 'none';
  document.getElementById('tab-btn-login').classList.toggle('active', tab === 'login');
  document.getElementById('tab-btn-registro').classList.toggle('active', tab === 'registro');
}

function showAuthMsg(msg, err) {
  var el = document.getElementById('auth-msg');
  el.innerHTML = '<div class="msg ' + (err ? 'msg-err' : 'msg-ok') + '">' + msg + '</div>';
  setTimeout(function() { el.innerHTML = ''; }, 5000);
}

function mostrarMsg(id, msg, err) {
  var el = document.getElementById(id);
  if (!el) return;
  el.innerHTML = '<div class="msg ' + (err ? 'msg-err' : 'msg-ok') + '">' + msg + '</div>';
  setTimeout(function() { el.innerHTML = ''; }, 5000);
}

function cerrarModal(id) { document.getElementById(id).style.display = 'none'; }

async function doLogin() {
  var email = document.getElementById('login-email').value.trim();
  var pass = document.getElementById('login-pass').value;
  if (!email || !pass) return showAuthMsg('Completa todos los campos', true);
  try {
    var r = await fetch(API + '/usuarios/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email, password: pass, origen: 'gestoria' }) });
    var d = await r.json();
    if (!d.ok) return showAuthMsg(d.error || 'Error al entrar', true);
    var test = await fetch(API + '/gestoria/clientes', { headers: { 'Authorization': 'Bearer ' + d.token } });
    if (!test.ok) return showAuthMsg('Esta cuenta no es una gestoria. Usa trimgest.es/app', true);
    localStorage.setItem('gest_token', d.token);
    localStorage.setItem('gest_nombre', d.nombre_empresa);
    token = d.token; gestoriaNombre = d.nombre_empresa;
    entrarApp();
  } catch(e) { showAuthMsg('Error de conexion', true); }
}

async function doRegistro() {
  var nombre = document.getElementById('reg-nombre').value.trim();
  var email = document.getElementById('reg-email').value.trim();
  var pass = document.getElementById('reg-pass').value;
  if (!nombre || !email || !pass) return showAuthMsg('Completa todos los campos', true);
  if (pass.length < 6) return showAuthMsg('La contrasena debe tener al menos 6 caracteres', true);
  try {
    var r = await fetch(API + '/gestoria/registro', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: email, password: pass, nombre_empresa: nombre, ref_referido_por: new URLSearchParams(window.location.search).get('ref') || null }) });
    var d = await r.json();
    if (!d.ok) return showAuthMsg(d.error || 'Error al registrarse', true);
    showAuthMsg('Cuenta creada. Revisa tu email para verificar la cuenta antes de entrar.', false);
    switchAuthTab('login');
  } catch(e) { showAuthMsg('Error de conexion', true); }
}

function entrarApp() {
  document.getElementById('auth-screen').style.display = 'none';
  document.getElementById('app-screen').style.display = 'block';
  document.getElementById('nombre-gestoria-top').textContent = gestoriaNombre;
  cargarClientes();
  cargarInvitaciones();
}

function logout() {
  localStorage.removeItem('gest_token');
  localStorage.removeItem('gest_nombre');
  location.reload();
}

function showPage(id, el) {
  document.querySelectorAll('.page').forEach(function(p) { p.classList.remove('active'); });
  document.querySelectorAll('.nav-item').forEach(function(n) { n.classList.remove('active'); });
  document.getElementById('page-' + id).classList.add('active');
  if (el) el.classList.add('active');
  if (id === 'invitaciones') cargarInvitaciones();
  if (id === 'ajustes') { cargarAjustesGestoria(); cargarReferidosGestoria(); }
}

async function cargarClientes() {
  try {
    var r = await fetch(API + '/gestoria/clientes', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    var lista = document.getElementById('clientes-lista');
    if (!d.ok || !d.clientes || !d.clientes.length) {
      lista.innerHTML = '<div class="empty">No tienes clientes aun.<br>Solicita acceso o acepta invitaciones.</div>';
      return;
    }
    lista.innerHTML = d.clientes.map(function(c) {
      var badgeDemo = c.es_demo ? '<span style="background:#2a2010;border:1px solid #e8c87a;color:#e8c87a;border-radius:6px;padding:3px 8px;font-size:10px;font-weight:700;letter-spacing:1px;">DEMO</span>' : '';
      var btnQuitarDemo = c.es_demo ? '<button class="btn-quitar-demo" onclick="event.stopPropagation();quitarDemo()" style="background:#2a1a1a;border:1px solid #5a3a3a;color:#c06060;border-radius:6px;padding:6px 10px;font-size:11px;cursor:pointer;">Quitar demo</button>' : '';
      return '<div class="cliente-card" data-id="' + c.empresaId + '" data-nombre="' + c.empresaNombre.replace(/"/g, '&quot;') + '">' +
        '<div class="cliente-info"><h3>' + c.empresaNombre + ' ' + badgeDemo + '</h3><p>' + c.empresaEmail + '</p></div>' +
        '<div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">' +
        (c.telefono ? '<a href="https://wa.me/34' + c.telefono.replace(/\D/g,'') + '" target="_blank" onclick="event.stopPropagation()" style="background:#25d366;color:#fff;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:600;text-decoration:none;">WhatsApp</a>' : '') +
        btnQuitarDemo +
        '<button class="btn btn-secondary btn-sm">Ver datos &rarr;</button>' +
        '</div>' +
        '</div>';
    }).join('');
    lista.querySelectorAll('.cliente-card').forEach(function(card) {
      card.addEventListener('click', function() { verCliente(this.dataset.id, this.dataset.nombre); });
    });
  } catch(e) { console.error(e); }
}

async function quitarDemo() {
  if (!confirm('¿Quieres quitar la empresa de demostración de tu lista de clientes?')) return;
  try {
    var r = await fetch(API + '/gestoria/quitar-demo', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    if (d.ok) cargarClientes();
    else alert(d.error || 'Error');
  } catch(e) { alert('Error de conexion'); }
}

async function verCliente(empresaId, nombre) {
  clienteActivo = empresaId;
  clienteNombreActivo = nombre;
  document.getElementById('detalle-nombre').textContent = nombre;
  document.getElementById('clientes-lista-wrap').style.display = 'none';
  document.getElementById('detalle-wrap').style.display = 'block';
  // Reset selectores banco para que se inicialicen con valores correctos para este cliente
  var selTrim = document.getElementById('banco-trim-gest');
  var selAnno = document.getElementById('banco-anno-gest');
  if (selTrim) delete selTrim.dataset.inicializado;
  if (selAnno) delete selAnno.dataset.inicializado;
  switchTab('proveedores');
  await cargarFacturasCliente(empresaId);
}

function cerrarDetalle() {
  document.getElementById('detalle-wrap').style.display = 'none';
  document.getElementById('clientes-lista-wrap').style.display = 'block';
  clienteActivo = null;
}

function switchTab(tab) {
  document.getElementById('tab-proveedores-content').style.display = tab === 'proveedores' ? 'block' : 'none';
  document.getElementById('tab-clientes-content').style.display = tab === 'clientes' ? 'block' : 'none';
  document.getElementById('tab-nominas-content').style.display = tab === 'nominas' ? 'block' : 'none';
  document.getElementById('tab-banco-content').style.display = tab === 'banco' ? 'block' : 'none';
  document.getElementById('tab-btn-proveedores').classList.toggle('active', tab === 'proveedores');
  document.getElementById('tab-btn-clientes').classList.toggle('active', tab === 'clientes');
  document.getElementById('tab-btn-nominas').classList.toggle('active', tab === 'nominas');
  document.getElementById('tab-btn-banco').classList.toggle('active', tab === 'banco');
  if (tab === 'banco') cargarBancoGest();
  if (tab === 'nominas' && clienteActivo) cargarNominasCliente(clienteActivo);
}

async function cargarFacturasCliente(empresaId) {
  try {
    var r = await fetch(API + '/gestoria/cliente/' + empresaId + '/facturas', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    todasFacturas = d.facturas || [];
    // Cargar banco para saber qué facturas están conciliadas
    try {
      var rb = await fetch(API + '/gestoria/cliente/' + empresaId + '/banco', { headers: { 'Authorization': 'Bearer ' + token } });
      var db = await rb.json();
      window.bancoConciliadosGest = (db.movimientos || []).filter(function(m) { return m.factura_id; }).map(function(m) { return m.factura_id; });
    } catch(e) { window.bancoConciliadosGest = []; }
    filtrarFacturas();
  } catch(e) { console.error(e); }
}

function filtrarFacturas() {
  var t = document.getElementById('sel-trimestre') ? document.getElementById('sel-trimestre').value : '';
  var a = document.getElementById('sel-anno') ? document.getElementById('sel-anno').value : '';
  var tCli = document.getElementById('sel-trimestre-cli') ? document.getElementById('sel-trimestre-cli').value : '';
  var aCli = document.getElementById('sel-anno-cli') ? document.getElementById('sel-anno-cli').value : '';
  var buscarProv = document.getElementById('buscar-prov') ? document.getElementById('buscar-prov').value.toLowerCase().trim() : '';
  var buscarCli = document.getElementById('buscar-cli') ? document.getElementById('buscar-cli').value.toLowerCase().trim() : '';
  var estadoProv = document.getElementById('sel-estado-prov') ? document.getElementById('sel-estado-prov').value : '';
  var estadoCli = document.getElementById('sel-estado-cli') ? document.getElementById('sel-estado-cli').value : '';
  var contProv = document.getElementById('sel-cont-prov') ? document.getElementById('sel-cont-prov').value : '';
  var contCli = document.getElementById('sel-cont-cli') ? document.getElementById('sel-cont-cli').value : '';
  var validas = todasFacturas.filter(function(f) {
    if (!f || f.borrado) return false;
    var nombre = f.nombre || f.proveedor || f.emisor || f.cliente || '';
    if (!nombre && !f.total) return false;
    return true;
  });
  var proveedores = validas.filter(function(f) { return f.tipo !== 'cliente'; });
  var clientes = validas.filter(function(f) { return f.tipo === 'cliente'; });
  if (t) proveedores = proveedores.filter(function(f) { return f.trimestre === t; });
  if (a) proveedores = proveedores.filter(function(f) { return String(f.anno) === a; });
  if (tCli) clientes = clientes.filter(function(f) { return f.trimestre === tCli; });
  if (aCli) clientes = clientes.filter(function(f) { return String(f.anno) === aCli; });
  if (buscarProv) proveedores = proveedores.filter(function(f) {
    var nombre = (f.nombre || f.proveedor || f.emisor || '').toLowerCase();
    var numero = (f.numero_factura || f.numero || '').toLowerCase();
    var concepto = (f.concepto || f.descripcion || '').toLowerCase();
    return nombre.indexOf(buscarProv) !== -1 || numero.indexOf(buscarProv) !== -1 || concepto.indexOf(buscarProv) !== -1;
  });
  if (buscarCli) clientes = clientes.filter(function(f) {
    var nombre = (f.nombre || f.cliente || '').toLowerCase();
    var numero = (f.numero_factura || f.numero || '').toLowerCase();
    var concepto = (f.concepto || f.descripcion || '').toLowerCase();
    return nombre.indexOf(buscarCli) !== -1 || numero.indexOf(buscarCli) !== -1 || concepto.indexOf(buscarCli) !== -1;
  });
  if (estadoProv) proveedores = proveedores.filter(function(f) {
    if (estadoProv === 'sinclasificar') return !f.estado_pago;
    return f.estado_pago === estadoProv;
  });
  if (estadoCli) clientes = clientes.filter(function(f) {
    if (estadoCli === 'sinclasificar') return !f.estado_pago;
    return f.estado_pago === estadoCli;
  });
  if (contProv) proveedores = proveedores.filter(function(f) { return contProv === 'si' ? f.contabilizado : !f.contabilizado; });
  if (contCli) clientes = clientes.filter(function(f) { return contCli === 'si' ? f.contabilizado : !f.contabilizado; });
  var gruposP = {};
  proveedores.forEach(function(f) {
    var key = (f.nombre || f.proveedor || f.emisor || 'Sin proveedor').trim();
    if (!gruposP[key]) gruposP[key] = [];
    gruposP[key].push(f);
  });
  Object.keys(gruposP).forEach(function(k) { gruposP[k].sort(function(a,b) { return (a.fecha||'').localeCompare(b.fecha||''); }); });
  var provOrdenados = [];
  Object.keys(gruposP).sort().forEach(function(k) { provOrdenados = provOrdenados.concat(gruposP[k]); });
  clientes.sort(function(a, b) { return (a.fecha||'').localeCompare(b.fecha||''); });
  var esMobil = window.innerWidth <= 768;
  document.querySelectorAll('.tabla-wrap table').forEach(function(t) { t.style.display = esMobil ? 'none' : 'table'; });
  document.querySelectorAll('.mobile-facturas').forEach(function(m) { m.style.display = esMobil ? 'block' : 'none'; });
  renderTablaProveedores(provOrdenados);
  renderTablaClientes(clientes);
}

function renderTablaProveedores(lista) {
  var tbody = document.getElementById('tabla-proveedores');
  var mobile = document.getElementById('mobile-proveedores');
  if (!tbody) return;
  if (!lista.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty">Sin facturas de proveedores</td></tr>';
    if (mobile) mobile.innerHTML = '<div style="text-align:center;color:#6a6070;padding:20px;">Sin facturas de proveedores</div>';
    return;
  }
  var filas = '';
  var tarjetas = '';
  var provActual = null;
  lista.forEach(function(f) {
    var prov = (f.nombre || f.proveedor || f.emisor || 'Sin proveedor').trim();
    if (prov !== provActual) {
      var cifProv = f.cif ? ' <span style="font-size:11px;font-weight:400;color:#6a6070;">· ' + f.cif + '</span>' : '';
      filas += '<tr><td colspan="8" style="padding:6px 12px;font-size:12px;font-weight:600;color:#9a90b4;background:#13131a;">' + prov + cifProv + '</td></tr>';
      tarjetas += '<div style="font-size:12px;font-weight:600;color:#9a90b4;padding:8px 0 4px;">' + prov + (f.cif ? ' · ' + f.cif : '') + '</div>';
      provActual = prov;
    }
    filas += renderFila(f);
    tarjetas += renderTarjetaMobil(f);
  });
  tbody.innerHTML = filas;
  if (mobile) mobile.innerHTML = tarjetas;
}

function renderTablaClientes(lista) {
  var tbody = document.getElementById('tabla-clientes');
  var mobile = document.getElementById('mobile-clientes');
  if (!tbody) return;
  if (!lista.length) {
    tbody.innerHTML = '<tr><td colspan="8" class="empty">Sin facturas de clientes</td></tr>';
    if (mobile) mobile.innerHTML = '<div style="text-align:center;color:#6a6070;padding:20px;">Sin facturas de clientes</div>';
    return;
  }
  tbody.innerHTML = lista.map(function(f) { return renderFila(f); }).join('');
  if (mobile) mobile.innerHTML = lista.map(function(f) { return renderTarjetaMobil(f); }).join('');
}

function ordenarFacturas(lista) {
  var proveedores = lista.filter(function(f) { return f.tipo !== 'cliente'; });
  var clientes = lista.filter(function(f) { return f.tipo === 'cliente'; });
  // proveedores: agrupar por proveedor, dentro por fecha
  var gruposP = {};
  proveedores.forEach(function(f) {
    var key = (f.nombre || f.proveedor || f.emisor || 'Sin proveedor').trim();
    if (!gruposP[key]) gruposP[key] = [];
    gruposP[key].push(f);
  });
  Object.keys(gruposP).sort().forEach(function(k) {
    gruposP[k].sort(function(a, b) { return (a.fecha || '').localeCompare(b.fecha || ''); });
  });
  var provOrdenados = [];
  Object.keys(gruposP).sort().forEach(function(k) { provOrdenados = provOrdenados.concat(gruposP[k]); });
  // clientes: solo por fecha
  clientes.sort(function(a, b) { return (a.fecha || '').localeCompare(b.fecha || ''); });
  return { proveedores: provOrdenados, clientes: clientes };
}

function renderTablaFacturas(lista) {
  var tbody = document.getElementById('tabla-facturas');
  if (!lista.length) { tbody.innerHTML = '<tr><td colspan="9" class="empty">Sin facturas</td></tr>'; return; }
  var ordenado = ordenarFacturas(lista);
  var filas = '';
  if (ordenado.proveedores.length) {
    filas += '<tr><td colspan="9" style="padding:10px 12px;font-size:11px;letter-spacing:2px;color:#6a6070;text-transform:uppercase;background:#0f0f13;">Proveedores</td></tr>';
    var provActual = null;
    ordenado.proveedores.forEach(function(f) {
      var prov = (f.proveedor || f.emisor || 'Sin proveedor').trim();
      if (prov !== provActual) {
        filas += '<tr><td colspan="9" style="padding:6px 12px;font-size:12px;font-weight:600;color:#9a90b4;background:#13131a;">' + prov + '</td></tr>';
        provActual = prov;
      }
      filas += renderFila(f);
    });
  }
  if (ordenado.clientes.length) {
    filas += '<tr><td colspan="9" style="padding:10px 12px;font-size:11px;letter-spacing:2px;color:#6a6070;text-transform:uppercase;background:#0f0f13;">Clientes</td></tr>';
    ordenado.clientes.forEach(function(f) { filas += renderFila(f); });
  }
  tbody.innerHTML = filas;
}


function renderTarjetaMobil(f) {
  var numero = f.numero_factura || f.numero || '-';
  var fecha = f.fecha || '-';
  var nombreProv = f.nombre || f.proveedor || f.emisor || f.cliente || '-';
  var concepto = f.concepto || f.descripcion || '-';
  var base = f.base_imponible ? Number(f.base_imponible).toFixed(2) + ' EUR' : '-';
  var iva = f.iva_porcentaje ? f.iva_porcentaje + '%' : (f.iva ? f.iva + '%' : '-');
  var total = f.total ? Number(f.total).toFixed(2) + ' EUR' : '-';
  var estadoPago = f.estado_pago || null;
  var badgeColors = { transferencia: { bg: '#0d1a2b', color: '#4c8faf' }, tarjeta: { bg: '#1a0d2b', color: '#9b7fd4' }, domiciliacion: { bg: '#2b1a0d', color: '#d4944c' }, bizum: { bg: '#0d2b1a', color: '#4caf7d' }, efectivo: { bg: '#2a2a35', color: '#888' }, mixto: { bg: '#2b1a2b', color: '#c47fd4' }, sinpagar: { bg: '#2b0d0d', color: '#e05555' }, parcial: { bg: '#2b2010', color: '#d4944c' } };
  var badgeHtml = estadoPago && badgeColors[estadoPago] ? '<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;background:' + badgeColors[estadoPago].bg + ';color:' + badgeColors[estadoPago].color + ';">' + estadoPago.charAt(0).toUpperCase() + estadoPago.slice(1) + '</span>' : '<span style="color:#555;font-size:11px;">—</span>';
  var conciliadoBadge = (window.bancoConciliadosGest || []).includes(f.id) ? '<span style="display:inline-block;padding:2px 7px;border-radius:10px;font-size:10px;font-weight:600;background:#0d1a2b;color:#4c8faf;margin-left:4px;">🏦 Conc.</span>' : '';
  return '<div class="mobile-factura-card">' +
    '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
    '<div>' +
    '<div class="mobile-factura-nombre">' + nombreProv + '</div>' +
    '<div class="mobile-factura-numero">Nº ' + numero + ' · ' + fecha + '</div>' +
    '</div>' +
    '<input type="checkbox" class="fact-check" data-id="' + f.id + '" data-tipo="' + (f.tipo||'') + '">' +
    '</div>' +
    '<div class="mobile-factura-row"><span>Concepto</span><span>' + concepto + '</span></div>' +
    '<div class="mobile-factura-row"><span>Base</span><span>' + base + '</span></div>' +
    '<div class="mobile-factura-row"><span>IVA</span><span>' + iva + '</span></div>' +
    '<div class="mobile-factura-total">' + total + '</div>' +
    '<div style="margin:6px 0 4px 0;">' + badgeHtml + '</div>' +
    '<div class="mobile-factura-btns">' +
    (f.archivo ? '<button class="btn btn-secondary btn-sm" data-archivo="' + (f.archivo||'') + '" onclick="verArchivo(this.dataset.archivo)">📄 PDF</button>' : '') +
    '<button class="btn btn-secondary btn-sm" data-id="' + f.id + '" onclick="abrirEditarFactura(this.dataset.id)">Editar</button>' +
    '<button class="btn btn-danger btn-sm" data-id="' + f.id + '" onclick="borrarFactura(this.dataset.id)">Borrar</button>' +
    '<button data-id="' + f.id + '" onclick="toggleContabilizadoGestoria(this.dataset.id)" style="background:' + (f.contabilizado?'#0d2b1a':'#1e1e28') + ';border:1px solid ' + (f.contabilizado?'#1a4a2a':'#2a2a3a') + ';color:' + (f.contabilizado?'#4caf7d':'#6a6070') + ';border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer;">' + (f.contabilizado?'✓ Cont.':'Contabilizar') + '</button>' +
    '</div>' +
    '</div>';
}

function renderFila(f) {
  var numero = f.numero_factura || f.numero || '-';
  var fecha = f.fecha || '-';
  var nombreProv = f.nombre || f.proveedor || f.emisor || f.cliente || '-';
  var concepto = f.concepto || f.descripcion || '-';
  var base = f.base_imponible ? Number(f.base_imponible).toFixed(2) + ' EUR' : '-';
  var iva = f.iva_porcentaje ? f.iva_porcentaje + '%' : (f.iva ? f.iva + '%' : '-');
  var total = f.total ? Number(f.total).toFixed(2) + ' EUR' : '-';
  var estadoPago = f.estado_pago || null;
  var badgeColors = { transferencia: { bg: '#0d1a2b', color: '#4c8faf' }, tarjeta: { bg: '#1a0d2b', color: '#9b7fd4' }, domiciliacion: { bg: '#2b1a0d', color: '#d4944c' }, bizum: { bg: '#0d2b1a', color: '#4caf7d' }, efectivo: { bg: '#2a2a35', color: '#888' }, mixto: { bg: '#2b1a2b', color: '#c47fd4' }, sinpagar: { bg: '#2b0d0d', color: '#e05555' }, parcial: { bg: '#2b2010', color: '#d4944c' } };
  var badgeHtml = estadoPago && badgeColors[estadoPago] ? '<span style="display:inline-block;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;background:' + badgeColors[estadoPago].bg + ';color:' + badgeColors[estadoPago].color + ';">' + estadoPago.charAt(0).toUpperCase() + estadoPago.slice(1) + '</span>' : '<span style="color:#555;font-size:11px;">—</span>';
  return '<tr>' +
    '<td><input type="checkbox" class="fact-check" data-id="' + f.id + '" data-tipo="' + (f.tipo||'') + '"></td>' +
    '<td>' + numero + '</td>' +
    '<td>' + fecha + '</td>' +
    '<td>' + nombreProv + '</td>' +
    '<td>' + concepto + '</td>' +
    '<td>' + base + '</td>' +
    '<td>' + iva + '</td>' +
    '<td style="font-weight:600;color:#e8c87a">' + total + '</td>' +
    '<td>' + badgeHtml + conciliadoBadge + '</td>' +
    '<td style="display:flex;gap:6px;flex-wrap:wrap">' +
      (f.archivo ? '<button class="btn btn-secondary btn-sm" data-archivo="' + (f.archivo || '') + '" onclick="verArchivo(this.dataset.archivo)">📄 PDF</button>' : '') +
      '<button class="btn btn-secondary btn-sm" data-id="' + f.id + '" onclick="abrirEditarFactura(this.dataset.id)">Editar</button>' +
      '<button class="btn btn-danger btn-sm" data-id="' + f.id + '" onclick="borrarFactura(this.dataset.id)">Borrar</button>' +
      '<button data-id="' + f.id + '" onclick="toggleContabilizadoGestoria(this.dataset.id)" style="background:' + (f.contabilizado?'#0d2b1a':'#1e1e28') + ';border:1px solid ' + (f.contabilizado?'#1a4a2a':'#2a2a3a') + ';color:' + (f.contabilizado?'#4caf7d':'#6a6070') + ';border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer;">' + (f.contabilizado?'✓ Cont.':'Contabilizar') + '</button>' +
    '</td>' +
  '</tr>';
}

async function cargarNominasCliente(empresaId) {
  var tbody = document.getElementById('tabla-nominas');
  if (!tbody) return;
  tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:20px;color:#888;">Cargando...</td></tr>';
  try {
    var r = await fetch(API + '/gestoria/cliente/' + empresaId + '/nominas', { headers: { 'Authorization': 'Bearer ' + token } });
    var d = await r.json();
    if (!d.ok) { tbody.innerHTML = '<tr><td colspan="6" class="empty">Error: ' + (d.error||'desconocido') + '</td></tr>'; return; }
    window.todasNominas = d.nominas || [];
    var selEmp = document.getElementById('sel-empleado');
    if (selEmp) {
      var trabajadores = [];
      window.todasNominas.forEach(function(n) {
        var t = n.trabajador || n.empleado || n.nombre || '';
        if (t && trabajadores.indexOf(t) === -1) trabajadores.push(t);
      });
      trabajadores.sort();
      selEmp.innerHTML = '<option value="">Todos los trabajadores</option>' + trabajadores.map(function(t) { return '<option value="' + t + '">' + t + '</option>'; }).join('');
    }
    renderNominas(window.todasNominas);
  } catch(e) { console.error(e); tbody.innerHTML = '<tr><td colspan="6" class="empty">Error de conexion</td></tr>'; }
}

function renderNominas(lista) {
  var tbody = document.getElementById('tabla-nominas');
  if (!tbody) return;
  if (!lista || !lista.length) { tbody.innerHTML = '<tr><td colspan="6" class="empty">Sin nominas</td></tr>'; return; }
  var filas = '';
  lista.forEach(function(n) {
    var trab = n.trabajador || n.empleado || n.nombre || 'Sin nombre';
    var bruto = n.coste_empresa || n.devengado || n.salario_bruto || 0;
    var neto = n.neto || n.salario_neto || 0;
    filas += '<tr>' +
      '<td><input type="checkbox" class="nom-check" data-id="' + n.id + '"></td>' +
      '<td>' + trab + '</td>' +
      '<td>' + (n.mes || '-') + '</td>' +
      '<td>' + (n.anno || '-') + '</td>' +
      '<td>' + (bruto ? Number(bruto).toFixed(2) + ' EUR' : '-') + '</td>' +
      '<td style="font-weight:600;color:#e8c87a">' + (neto ? Number(neto).toFixed(2) + ' EUR' : '-') + '</td>' +
      '<td style="display:flex;gap:6px;flex-wrap:wrap">' +
        (n.archivo ? '<button class="btn btn-secondary btn-sm" data-archivo="' + n.archivo + '" onclick="verArchivoNomina(this.dataset.archivo)">📄 PDF</button>' : '') +
        '<button class="btn btn-secondary btn-sm" data-id="' + n.id + '" onclick="abrirEditarNomina(this.dataset.id)">Editar</button>' +
        '<button class="btn btn-danger btn-sm" data-id="' + n.id + '" onclick="borrarNomina(this.dataset.id)">Borrar</button>' +
        '<button data-id="' + n.id + '" onclick="toggleContabilizadoNomina(this.dataset.id)" style="background:' + (n.contabilizado?'#0d2b1a':'#1e1e28') + ';border:1px solid ' + (n.contabilizado?'#1a4a2a':'#2a2a3a') + ';color:' + (n.contabilizado?'#4caf7d':'#6a6070') + ';border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer;">' + (n.contabilizado?'✓ Cont.':'Contabilizar') + '</button>' +
      '</td>' +
    '</tr>';
  });
  tbody.innerHTML = filas;
  renderNominasMobile(lista);
}

// filtrarNominas definida mas abajo

function renderNominaCard(n) {
  var trab = n.trabajador || n.empleado || n.nombre || 'Sin nombre';
  var bruto = n.coste_empresa || n.devengado || n.salario_bruto || 0;
  var neto = n.neto || n.salario_neto || 0;
  var card = document.createElement('div');
  card.className = 'mobile-factura-card';
  card.innerHTML = '<div style="display:flex;justify-content:space-between;align-items:flex-start;">' +
    '<div>' +
    '<div class="mobile-factura-nombre">' + trab + '</div>' +
    '<div class="mobile-factura-numero">' + (n.mes || '-') + ' ' + (n.anno || '') + '</div>' +
    '</div>' +
    '<input type="checkbox" class="nom-check" data-id="' + n.id + '">' +
    '</div>' +
    '<div class="mobile-factura-row"><span>Bruto</span><span>' + (bruto ? Number(bruto).toFixed(2) + ' EUR' : '-') + '</span></div>' +
    '<div class="mobile-factura-total">' + (neto ? Number(neto).toFixed(2) + ' EUR' : '-') + '</div>' +
    '<div class="mobile-factura-btns">' +
    (n.archivo ? '<button class="btn btn-secondary btn-sm" data-archivo="' + n.archivo + '" onclick="verArchivoNomina(this.dataset.archivo)">PDF</button>' : '') +
    '<button class="btn btn-secondary btn-sm" data-id="' + n.id + '" onclick="abrirEditarNomina(this.dataset.id)">Editar</button>' +
    '<button class="btn btn-danger btn-sm" data-id="' + n.id + '" onclick="borrarNomina(this.dataset.id)">Borrar</button>' +
    '</div>';
  var contBtn = document.createElement('button');
  contBtn.dataset.id = String(n.id);
  contBtn.style.cssText = 'background:' + (n.contabilizado ? '#0d2b1a' : '#1e1e28') + ';border:1px solid ' + (n.contabilizado ? '#1a4a2a' : '#2a2a3a') + ';color:' + (n.contabilizado ? '#4caf7d' : '#6a6070') + ';border-radius:6px;padding:4px 8px;font-size:11px;cursor:pointer;margin-top:4px;';
  contBtn.textContent = n.contabilizado ? 'Cont.' : 'Contabilizar';
  contBtn.onclick = function() { toggleContabilizadoNomina(this.dataset.id); };
  card.querySelector('.mobile-factura-btns').appendChild(contBtn);
  return card;
}

function renderNominasMobile(lista) {
  var container = document.getElementById('mobile-nominas-list');
  if (!container) return;
  if (!lista || !lista.length) { container.innerHTML = '<p style="color:#6a6070;text-align:center;padding:20px;">Sin nominas</p>'; return; }
  container.innerHTML = '';
  lista.forEach(function(n) { container.appendChild(renderNominaCard(n)); });
}

function abrirEditarFactura(id) {
  var f = todasFacturas.find(function(x) { return String(x.id) === String(id); });
  if (!f) return;
  editandoFacturaId = id;
  document.getElementById('ef-numero').value = f.numero_factura || f.numero || '';
  document.getElementById('ef-fecha').value = f.fecha || '';
  document.getElementById('ef-proveedor').value = f.nombre || f.proveedor || f.emisor || f.cliente || '';
  document.getElementById('ef-concepto').value = f.concepto || f.descripcion || '';
  document.getElementById('ef-base').value = f.base_imponible || '';
  document.getElementById('ef-iva').value = f.iva_porcentaje || f.iva || '';
  document.getElementById('ef-total').value = f.total || '';
  document.getElementById('ef-tipo').value = f.tipo || 'proveedor';
  document.getElementById('modal-factura').style.display = 'flex';
}

async function guardarFactura() {
  if (!editandoFacturaId || !clienteActivo) return;
  var body = {
    numero_factura: document.getElementById('ef-numero').value,
    fecha: document.getElementById('ef-fecha').value,
    nombre: document.getElementById('ef-proveedor').value,
    proveedor: document.getElementById('ef-proveedor').value,
    emisor: document.getElementById('ef-proveedor').value,
    concepto: document.getElementById('ef-concepto').value,
    base_imponible: parseFloat(document.getElementById('ef-base').value) || 0,
    iva_porcentaje: parseFloat(document.getElementById('ef-iva').value) || 0,
    iva: parseFloat(document.getElementById('ef-iva').value) || 0,
    total: parseFloat(document.getElementById('ef-total').value) || 0,
    tipo: document.getElementById('ef-tipo').value
  };
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/facturas/' + editandoFacturaId, {
      method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify(body)
    });
    var d = await r.json();
    if (!d.ok) return alert(d.error || 'Error');
    cerrarModal('modal-factura');
    await cargarFacturasCliente(clienteActivo);
  } catch(e) { alert('Error de conexion'); }
}

async function borrarFactura(id) {
  if (!confirm('Borrar esta factura?')) return;
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/facturas/' + id, {
      method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token }
    });
    var d = await r.json();
    if (!d.ok) return alert(d.error || 'Error');
    await cargarFacturasCliente(clienteActivo);
  } catch(e) { alert('Error de conexion'); }
}

function abrirEditarNomina(id) {
  editandoNominaId = id;
  document.getElementById('modal-nomina').style.display = 'flex';
  fetch(API + '/gestoria/cliente/' + clienteActivo + '/nominas', { headers: { 'Authorization': 'Bearer ' + token } })
    .then(function(r) { return r.json(); })
    .then(function(d) {
      var n = (d.nominas || []).find(function(x) { return String(x.id) === String(id); });
      if (!n) return;
      document.getElementById('en-empleado').value = n.trabajador || n.empleado || n.nombre || '';
      document.getElementById('en-mes').value = n.mes || '';
      document.getElementById('en-anno').value = n.anno || '';
      document.getElementById('en-bruto').value = n.salario_bruto || '';
      document.getElementById('en-ss').value = n.seg_social || '';
      document.getElementById('en-irpf').value = n.irpf || '';
      document.getElementById('en-neto').value = n.salario_neto || '';
    });
}

async function guardarNomina() {
  if (!editandoNominaId || !clienteActivo) return;
  var body = {
    empleado: document.getElementById('en-empleado').value,
    mes: document.getElementById('en-mes').value,
    anno: document.getElementById('en-anno').value,
    salario_bruto: parseFloat(document.getElementById('en-bruto').value) || 0,
    seg_social: parseFloat(document.getElementById('en-ss').value) || 0,
    irpf: parseFloat(document.getElementById('en-irpf').value) || 0,
    salario_neto: parseFloat(document.getElementById('en-neto').value) || 0
  };
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/nominas/' + editandoNominaId, {
      method: 'PUT', headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
      body: JSON.stringify(body)
    });
    var d = await r.json();
    if (!d.ok) return alert(d.error || 'Error');
    cerrarModal('modal-nomina');
    await cargarNominasCliente(clienteActivo);
  } catch(e) { alert('Error de conexion'); }
}

async function borrarNomina(id) {
  if (!confirm('Borrar esta nomina?')) return;
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/nominas/' + id, {
      method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token }
    });
    var d = await r.json();
    if (!d.ok) return alert(d.error || 'Error');
    await cargarNominasCliente(clienteActivo);
  } catch(e) { alert('Error de conexion'); }
}

async function exportarExcelCliente(tipo) {
  if (!clienteActivo) return;
  var selT = tipo === 'cliente' ? document.getElementById('sel-trimestre-cli') : document.getElementById('sel-trimestre');
  var selA = tipo === 'cliente' ? document.getElementById('sel-anno-cli') : document.getElementById('sel-anno');
  var t = (selT && selT.value) ? selT.value : 'T1';
  var a = (selA && selA.value) ? selA.value : new Date().getFullYear();
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/exportar/' + tipo + '/' + t + '/' + a, { headers: { 'Authorization': 'Bearer ' + token } });
    if (!r.ok) throw new Error('Error');
    var blob = await r.blob();
    var url = URL.createObjectURL(blob);
    var link = document.createElement('a');
    link.href = url; link.download = clienteNombreActivo + '-' + tipo + '-' + t + '-' + a + '.xlsx';
    document.body.appendChild(link); link.click(); document.body.removeChild(link);
    setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
  } catch(e) { alert('Error al exportar. Selecciona trimestre y ano primero.'); }
}

async function exportarExcelNominasCliente() {
  if (!clienteActivo) return;
  var a = document.getElementById('sel-anno') ? document.getElementById('sel-anno').value || new Date().getFullYear() : new Date().getFullYear();
  try {
    var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/exportar/nominas/' + a, { headers: { 'Authorization': 'Bearer ' + token } });
    if (!r.ok) throw new Error('Error');
    var blob = await r.blob();
    var url = URL.createObjectURL(blob);
    var link = document.createElement('a');
    link.href = url; link.download = clienteNombreActivo + '-nominas-' + a + '.xlsx';
    document.body.appendChild(link); link.click(); document.body.removeChild(link);
    setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
  } catch(e) { alert('Error al exportar'); }
}

async function descargarPDFCliente(tipo) {
  if (!clienteActivo) return;
  var selT = tipo === 'cliente' ? document.getElementById('sel-trimestre-cli') : document.getElementById('sel-trimestre');
  var selA = tipo === 'cliente' ? document.getElementById('sel-anno-cli') : document.getElementById('sel-anno');
  var t = (selT && selT.value) ? selT.value : '';
  var a = (selA && selA.value) ? selA.value : '';
  if (!a) { alert('Selecciona un ano primero'); return; }
  abrirModalPdf(async function(conAdjuntos) {
    try {
      var r = await fetch(API + '/gestoria/cliente/' + clienteActivo + '/pdf/facturas-seleccionadas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ tipo: tipo, trimestre: t, anno: a, todas: true, conAdjuntos: conAdjuntos })
      });
      if (!r.ok) { var err = await r.json().catch(function(){return{};}); alert('Error: ' + (err.error||r.status)); return; }
      var blob = await r.blob();
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url; link.download = clienteNombreActivo + '-' + tipo + '-' + t + '-' + a + '.pdf';
      document.body.appendChild(link); link.click(); document.body.removeChild(link);
      setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
    } catch(e) { alert('Error al generar PDF: ' + e.message); }
  });
}

