function verArchivo(filename) {
  if (!filename || !clienteActivo) return;
  var url = API + '/gestoria/cliente/' + clienteActivo + '/archivo/' + encodeURIComponent(filename) + '?token=' + token;
  var modal = document.getElementById('pdf-viewer-modal');
  var iframe = document.getElementById('pdf-viewer-iframe');
  if (modal && iframe) { iframe.src = url; modal.style.display = 'flex'; modal.style.flexDirection = 'column'; } else { window.open(url, '_blank'); }
}
function cerrarPDFViewer() {
  var modal = document.getElementById('pdf-viewer-modal');
  var iframe = document.getElementById('pdf-viewer-iframe');
  if (modal) modal.style.display = 'none';
  if (iframe) iframe.src = '';
}

function filtrarNominas() {
  if (!window.todasNominas) return;
  var emp = document.getElementById('sel-empleado') ? document.getElementById('sel-empleado').value : '';
  var anno = document.getElementById('sel-anno-nom') ? document.getElementById('sel-anno-nom').value : '';
  var buscar = document.getElementById('buscar-nom') ? document.getElementById('buscar-nom').value.toLowerCase().trim() : '';
  var lista = window.todasNominas.filter(function(n) {
    var trab = n.trabajador || n.empleado || n.nombre || '';
    if (emp && trab !== emp) return false;
    if (anno && String(n.anno) !== anno) return false;
    if (buscar && trab.toLowerCase().indexOf(buscar) === -1) return false;
    return true;
  });
  var tbody = document.getElementById('tabla-nominas');
  if (!tbody) return;
  if (!lista.length) { tbody.innerHTML = '<tr><td colspan="6" class="empty">Sin nominas</td></tr>'; return; }
  var filas = '';
  lista.forEach(function(n) {
    var trab = n.trabajador || n.empleado || n.nombre || 'Sin nombre';
    var bruto = n.coste_empresa || n.devengado || n.salario_bruto || 0;
    var neto = n.neto || n.salario_neto || 0;
    filas += '<tr>' +
      '<td>' + trab + '</td>' +
      '<td>' + (n.mes || '-') + '</td>' +
      '<td>' + (n.anno || '-') + '</td>' +
      '<td>' + (bruto ? Number(bruto).toFixed(2) + ' EUR' : '-') + '</td>' +
      '<td style="font-weight:600;color:#e8c87a">' + (neto ? Number(neto).toFixed(2) + ' EUR' : '-') + '</td>' +
      '<td style="display:flex;gap:6px;flex-wrap:wrap">' +
        (n.archivo ? '<button class="btn btn-secondary btn-sm" data-archivo="' + (n.archivo||'') + '" onclick="verArchivoNomina(this.dataset.archivo)">📄 PDF</button>' : '') +
        '<button class="btn btn-secondary btn-sm" data-id="' + n.id + '" onclick="abrirEditarNomina(this.dataset.id)">Editar</button>' +
        '<button class="btn btn-danger btn-sm" data-id="' + n.id + '" onclick="borrarNomina(this.dataset.id)">Borrar</button>' +
      '</td>' +
    '</tr>';
  });
  tbody.innerHTML = filas;
}

